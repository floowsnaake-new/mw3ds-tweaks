static const float kReach = 192.0f;          // iMaxActivateDist
bool g_isMultiplayerClient = false;

bool Session::start(const char* dataDir, const std::string& startCell, const char* savePathIn)
{
	savePath = savePathIn;
	MARK("load settings");
	loadSettings();
	w.memoryLowHook = [this](bool force) { relieveMemory(force); };
	MARK("sound volumes");
	audioSetScales(effectsVolume / 100.0f, musicVolume / 100.0f);
	MARK("shimmer frames");
	rendererLoadCaustics(dataDir);
	MARK("game data");
	// A save asked for that is there but won't read (damaged, or a newer version): nothing starts, the caller goes back
	// to the title. A new game in its place autosaved over the player's save at the first door
	bool asked = savePath && startCell.empty();
	std::string savedCell = asked ? World::savedCell(savePath) : "";
	struct stat st;
	if (asked && savedCell.empty() && stat(savePath, &st) == 0)
	{
		logf("save: %s won't read: not started", savePath);
		saveUnreadable = true;
		return false;
	}
	if (!savedCell.empty())
	{
		if (!w.load(dataDir, savedCell))
			return false;
		if (w.cellIndex(savedCell) == w.current && w.applySave(savePath))
		{
			startGameScripts();          // saves from before Main ran get it now
			resolveCompanion();          // restore companionRef from ally/follow state in the save
			// Saves made while harvesting added the plant itself to the pack: drop those (containers are no items)
			for (size_t i = w.inventory.size(); i-- > 0;)
				if (const Object* o = w.game.object(w.inventory[i].id))
					if (o->type == "CONT")
					{
						logf("save: removed %s from the inventory (a harvested plant, not an item)", w.inventory[i].id.c_str());
						w.inventory.erase(w.inventory.begin() + i);
					}
			playMusic(false);
			notify("Game loaded.");
			return true;
		}
		logf("save: could not continue in %s: not started", savedCell.c_str());
		w.freeAll();
		saveUnreadable = true;
		return false;
	}
	if (!w.load(dataDir, startCell))
		return false;
	giveItems(w.game.startItems);
	startGameScripts();
    /* patch: hands+body: load viewmodel */
    if (!vm.load(w))
        logf("viewmodel: load failed (data/fp/skeletons.skl missing?)");
    body.rebuild(w, false);
	if (!w.isStartCell() || !w.game.chargen)
	{
		skipChargen();
		playMusic(false);
		return true;
	}
	// State the boat part of character creation leaves behind (script "CharGen")
	w.globals["chargenstate"] = 10.0f;
	if (!autotest)
		playMovie("mw_intro");
	// CharGen's DisablePlayerControls / Jumping / ViewSwitch / VanityMode / Fighting / Magic: the player lies still in
	// the hold until the walking guard's script (CharGenWalkNPC) gives the controls back after the movement message
	w.controlsEnabled = false;
	w.jumpingEnabled = false;
	w.controlsOff |= 2u | 4u;
	w.fightingEnabled = false;
	w.magicEnabled = false;
	w.menusEnabled = 0;
	Scene scene = w.scene();
	playerSpawn(w.player, scene, w.here().spawn, w.here().yaw, 0.0f);
	// Waking in the prison ship's hold (the level's start cell, where CharGen's PositionCell puts the
	// player): Jiub's script asks the name, the guards' scripts bring the race menu and the way out.
	// A level built before the ship was in (start cell: the census office) still opens both menus
	if (lower(w.cellName()).find("prison ship") == std::string::npos)
	{
		pendingMenus.push_back(SMENU_NAME);
		pendingMenus.push_back(SMENU_RACE);
	}
	// First thing on a new game: settings / controls help (before name and race menus)
	helpPage = 0;
	focus = 0;
	openScreen(SCR_HELP);
	// the intro movie's sound plays on the music channel; the music starts when it ends (stopMovie)
	if (!moviePlaying())
		playMusic(false);
	return true;
}

bool Session::playMovie(const std::string& name)
{
	std::string stem = lower(name);
	size_t dot = stem.rfind(".bik");
	if (dot != std::string::npos)
		stem.resize(dot);
	for (auto& ch : stem)
		if (!isalnum((unsigned char)ch) && ch != '_')
			ch = '_';
	stopMovie();
	char path[256];
	snprintf(path, sizeof(path), "%s/movies/%s.mwv", w.dataDir, stem.c_str());
	FILE* f = testNoMovies ? nullptr : fopen(path, "rb");
	if (!f)
	{
		logf("movie: no %s", path);
		return false;
	}
	char magic[4];
	u32 hdr[4];
	if (fread(magic, 4, 1, f) != 1 || memcmp(magic, "MWV1", 4) != 0 || fread(hdr, 4, 4, f) != 4)
	{
		fclose(f);
		return false;
	}
	movieFile = f;
	movieFrames = hdr[0];
	movieFps100 = hdr[1] ? hdr[1] : 1000;
	movieW = hdr[2];
	movieH = hdr[3];
	movieFrame = -1;
	movieTime = 0.0f;
	std::string snd = "movie_" + stem + ".snd";
	char spath[256];
	snprintf(spath, sizeof(spath), "%s/music/%s", w.dataDir, snd.c_str());
	struct stat st;
	if (stat(spath, &st) == 0)
		audioMusicPlay({ snd }, 0.8f);
	logf("movie: %s, %u frames", stem.c_str(), movieFrames);
	return true;
}

void Session::movieUpdate(float dt)
{
	if (!movieFile)
		return;
	movieTime += dt;
	int want = (int)(movieTime * movieFps100 / 100.0f);
	if (want >= (int)movieFrames)
	{
		stopMovie();
		return;
	}
	// catch up to the frame due (skipping any a slow frame left behind)
	while (movieFrame < want)
	{
		u32 size = 0;
		if (fread(&size, 4, 1, movieFile) != 1 || size > (1 << 20))
		{
			stopMovie();
			return;
		}
		movieFrame++;
		if (movieFrame < want)
		{
			fseek(movieFile, size, SEEK_CUR);
			continue;
		}
		std::vector<u8> buf(size);
		if (fread(buf.data(), 1, size, movieFile) != size)
		{
			stopMovie();
			return;
		}
		LinearGuard guard;
		if (movieTexOk)
			deferredTexDelete(&movieTex);
		Tex3DS_Texture t = Tex3DS_TextureImport(buf.data(), size, &movieTex, nullptr, false);
		movieTexOk = t != nullptr;
		if (t)
		{
			Tex3DS_TextureFree(t);
			C3D_TexSetFilter(&movieTex, GPU_LINEAR, GPU_LINEAR);
		}
	}
}

void Session::movieDraw()
{
	if (!movieTexOk || !movieW || !movieH)
		return;
	Tex3DS_SubTexture sub = { (u16)movieW, (u16)movieH, 0.0f, 1.0f, (float)movieW / movieTex.width,
		1.0f - (float)movieH / movieTex.height };
	C2D_Image img = { &movieTex, &sub };
	float k = 240.0f / movieH;
	C2D_DrawImageAt(img, (400.0f - movieW * k) / 2.0f, 0.0f, 0.5f, nullptr, k, k);
}

void Session::stopMovie()
{
	if (movieFile)
	{
		fclose(movieFile);
		movieFile = nullptr;
		playMusic(false);
	}
	if (movieTexOk)
	{
		LinearGuard guard;
		deferredTexDelete(&movieTex);
		movieTexOk = false;
	}
}

// The game's own global scripts, as Morrowind starts them for a new game: Main always runs (it
// re-rolls Random100 every frame); at New Game it starts Startup (disables some hundred quest people
// and things until their quests bring them in) and VampireCheck (the blood diseases' third night).
// Main's CharGen start is left out: character creation here is the menus'. A save without Main
// (made before it ran) gets all three once.
void Session::startGameScripts()
{
	for (auto& s : w.scripts)
		if (s.ref < 0 && s.item.empty() && s.script && lower(s.script->name) == "main")
			return;
	logf("script: starting Main, Startup, VampireCheck");
	w.startGlobalScript("Main");
	w.startGlobalScript("Startup");
	auto pv = w.globals.find("pcvampire");
	if (pv == w.globals.end() || pv->second == 0.0f)
		w.startGlobalScript("VampireCheck");
}

// Starting somewhere other than the Census office: character creation counts as done, with
// the first playable class and birthsign, and the player stands outside a door into this cell
// (the office's exit door when there is one).
// Adds items to the inventory and wears / wields them (one weapon, clothes and armor)
// Morrowind's difficulty (OpenMW's reading): x = 1% of the slider; hits and harmful spells on the player
// scale by 1 + fDifficultyMult x (or / when easier), the player's own by the mirror of it
float Session::difficultyScale(bool toPlayer) const
{
	float term = 0.01f * difficulty, m = w.game.gmstf("fdifficultymult", 5.0f);
	float x = toPlayer ? (term > 0.0f ? m * term : term / m) : (term > 0.0f ? -term / m : m * -term);
	return fmaxf(0.0f, 1.0f + x);
}

// Third person: the camera orbits a point just above the head, 220 units back along the view, pulled in front of
// walls: looking up swings it down behind the player, looking down swings it up over them, and the player stays in the
// middle of the view (OpenMW's third-person camera: the focal point minus the view direction times the distance).
// The face preview looks at the player's face from in front
void Session::viewCamera(RenderCamera& cam)
{
	if (!thirdPerson && !previewFace)
		return;
	const Player& p = w.player;
	float fx = sinf(p.yaw), fy = cosf(p.yaw);
	float head[3] = { p.feet[0], p.feet[1], p.feet[2] + (previewFace ? 118.0f : 120.0f) };
	float want = previewFace ? 70.0f : 220.0f;
	float dir = previewFace ? 1.0f : -1.0f;       // the preview stands in front, facing back
	// (dead: from behind and above, looking down at the body where it fell)
	const float pitch = playerDead && deathView ? -0.6f : p.pitch;
	float cp = cosf(pitch), sp = sinf(pitch);
	float to[3] = { head[0] + dir * fx * cp * want, head[1] + dir * fy * cp * want, head[2] - sp * want };
	// walls between the head and the camera pull it in
	float best = 1.0f;
	for (LoadedCell* l : w.loaded)
	{
		float t;
		if (collisionRaycast(l->cell.collision, head, to, &t) && t < best)
			best = t;
	}
	float d = fmaxf(20.0f, want * best - 12.0f);
	thirdDistance = thirdDistance <= 0.0f ? d : (d < thirdDistance ? d : thirdDistance + (d - thirdDistance) * 0.1f);
	for (int k = 0; k < 3; k++)
		cam.pos[k] = head[k] + (to[k] - head[k]) * (thirdDistance / want);
	if (previewFace)
	{
		cam.yaw = p.yaw + 3.14159265f;
		cam.pitch = 0.0f;
	}
	else if (playerDead && deathView)
		cam.pitch = pitch;
}

void Session::giveItems(const std::vector<std::pair<int, std::string>>& items)
{
	for (auto& it : items)
	{
		const Object* o = w.game.object(it.second);
		if (!o)
			continue;
		w.addItem(it.second, it.first);
		bool wear = o->type == "CLOT" || o->type == "ARMO";
		if (o->type == "WEAP")
		{
			wear = true;
			for (auto& inv : w.inventory)
				if (inv.equipped && w.game.object(inv.id) && w.game.object(inv.id)->type == "WEAP")
					wear = false;
		}
		if (wear)
			for (auto& inv : w.inventory)
				if (inv.id == it.second)
					inv.equipped = true;
	}
}

// A new character's own spells: the PC Start spells their class and race make castable (autocalc)
void Session::givePlayerStartSpells()
{
	w.recomputeStats();
	int attrs[8], skills[27];
	for (int k = 0; k < 8; k++)
		attrs[k] = w.stats.attributes[k];
	for (int k = 0; k < 27; k++)
		skills[k] = w.stats.skills[k];
	int n = 0;
	for (auto& id : w.game.autoCalcSpells(attrs, skills, true))
	{
		std::string l = lower(id);
		if (std::find(w.stats.spells.begin(), w.stats.spells.end(), l) == w.stats.spells.end())
		{
			w.stats.spells.push_back(l);
			n++;
		}
	}
	logf("chargen: %d starting spells", n);
}

void Session::skipChargen()
{
	giveItems(w.game.skipChargenItems);
	w.globals["chargenstate"] = -1.0f;
	w.controlsEnabled = w.jumpingEnabled = w.fightingEnabled = w.magicEnabled = true;
	w.controlsOff = 0;
	w.menusEnabled = MENU_STATS | MENU_INVENTORY | MENU_MAGIC | MENU_MAP | MENU_REST;
	for (auto& c : w.game.classes)
		if (c.playable)
		{
			w.stats.cls = c.id;
			break;
		}
	if (!w.game.birthsigns.empty())
		w.stats.birthsign = w.game.birthsigns[0].id;
	w.recomputeStats();
	givePlayerStartSpells();

	// A level without character creation has its own starting spot; otherwise stand outside a door
	int door = -1;
	for (size_t i = 0; i < w.refs.size() && w.game.chargen; i++)
	{
		const Ref& r = w.refs[i];
		if (!r.hasDest || lower(r.destCell) != lower(w.cellName()) || r.cell == w.current)
			continue;
		if (door < 0 || r.idLower == "chargen exit door")
			door = i;
	}
	auto town = w.game.townSpawns.find(lower(w.cellName()));
	if (door < 0 && town != w.game.townSpawns.end())
	{
		// A town's street, in front of one of its doors (the converter picked it)
		const std::vector<float>& t = town->second;
		float eye[3] = { t[0], t[1], t[2] + PLAYER_EYE_HEIGHT };
		w.player.feet[0] = eye[0];
		w.player.feet[1] = eye[1];
		w.streamExterior(true);
		Scene scene = w.scene();
		playerSpawn(w.player, scene, eye, t[3], 0.0f);
	}
	else if (door >= 0)
	{
		const Ref& r = w.refs[door];
		float eye[3] = { r.destPos[0], r.destPos[1], r.destPos[2] + PLAYER_EYE_HEIGHT };
		w.player.feet[0] = eye[0];
		w.player.feet[1] = eye[1];
		w.streamExterior(true);
		Scene scene = w.scene();
		playerSpawn(w.player, scene, eye, r.destRot[2], 0.0f);
	}
	else
	{
		Scene scene = w.scene();
		playerSpawn(w.player, scene, w.here().spawn, w.here().yaw, 0.0f);
	}
	// What character creation's scripts leave behind, set on each object as its cell is read in (reading the Census Office's
	// references in here made its exit door the start, in the walled yard behind it): see World::postChargenRef
	w.postChargen = true;
	for (Ref& r : w.refs)
		w.postChargenRef(r);
	logf("start: %s, chargen skipped, feet %.0f %.0f %.0f", w.cellName().c_str(),
		w.player.feet[0], w.player.feet[1], w.player.feet[2]);
}

void Session::shutdown()
{
	if (waterChannel >= 0)
		audioStop(waterChannel);
	waterChannel = -1;
	for (auto& r : w.refs)
		if (r.voiceChannel >= 0)
			audioStop(r.voiceChannel);
	// Stop the music channel too: ndspExit() in main runs after us, and a
	// music stream still feeding wave buffers while the DSP shuts down is one
	// of the freeze points on real hardware.
	audioMusicPlay({}, 0.0f);
	audioUpdate();
	vm.free(w);
	body.free(w);
	w.freeAll();
	skeletonsFree();
	audioCacheClear();
	w.keepGame();

	// Textures this session owns in linear memory (map, map tiles, fog of war, sky billboards):
	// previously only mapTex was released, and only when loaded; on a real 3DS every quit leaked
	// them, and on an Old 3DS that is enough linear memory to matter. Each free is queued for the
	// next linearRetire() (main drains the queue right after shutdown() returns and after delete
	// session). deferredTexDelete needs a LinearGuard for the linear heap's lock.
	// (MW3DS_QUIT_CRASH_FIX_v1)
	{
		LinearGuard guard;
		if (mapLoaded)
		{
			deferredTexDelete(&mapTex);
			mapLoaded = false;
		}
		if (fogTexReady)
		{
			deferredTexDelete(&fogTex);
			fogTexReady = false;
		}
	}
	freeMapTiles();

	// Sky textures live in the world's TextureCache under their names; the cache refcounts by name,
	// so release each one once here (they were acquired through Session::skyTex and never released).
	for (auto& kv : skyTextures)
		w.textures.release(kv.first);
	skyTextures.clear();
}

bool Session::save()
{
	if (!savePath)
		return false;
	bool ok = w.saveGame(savePath);
	notify(ok ? "Game saved." : "Saving failed.");
	return ok;
}

// After a load (or any time the live ref may have moved): find the companion by saved id,
// or any ally that is following the player. Restores companionRef so orders and death work again.
// Also recovers older saves where ally was not persisted but AIFollow on the player still is.
void Session::resolveCompanion()
{
	companionRef = -1;
	companionEngaged = false;
	auto adopt = [&](int i) {
		Ref& r = w.refs[i];
		r.ally = true;   // ensure combat/dialogue treat them as companion (old saves lacked this)
		companionRef = i;
		if (companionId.empty())
			companionId = r.idLower;
		companionWaiting = (r.aiPackage != AIPKG_FOLLOW || !r.aiActive);
		companionSyncGear();
	};
	if (!companionId.empty())
	{
		for (int i : w.loadedActors)
		{
			Ref& r = w.refs[i];
			if (!r.dead && r.actor >= 0 && r.idLower == companionId &&
			    (r.ally || w.followsPlayer(i)))
			{
				adopt(i);
				return;
			}
		}
		for (size_t i = 0; i < w.refs.size(); i++)
		{
			Ref& r = w.refs[i];
			if (r.cell < 0 || r.dead || r.actor < 0)
				continue;
			if (r.idLower == companionId && (r.ally || w.followsPlayer((int)i)))
			{
				adopt((int)i);
				return;
			}
		}
	}
	// Fallback: any permanent ally follower, or an NPC still on AIFollow player
	// (saves made before companionId / ally were persisted)
	for (int i : w.loadedActors)
	{
		Ref& r = w.refs[i];
		if (r.dead || r.type != "NPC_")
			continue;
		if ((r.ally && w.followsPlayer(i)) ||
		    (r.aiPackage == AIPKG_FOLLOW && r.aiTarget == "player" && r.aiDuration <= 0.0f))
		{
			adopt(i);
			return;
		}
	}
}

void Session::companionDied()
{
	if (companionRef < 0)
		return;
	logf("companion: died (ref %d)", companionRef);
	notify(companionName + " has fallen.");
	companionRef = -1;
	companionId.clear();
	companionWaiting = false;
	companionEngaged = false;
	companionShare = false;
	companionArmed = true;
	companionBodyActive = false;
	companionPrevPosOk = false;
	companionAttackGroup.clear();
}

void Session::companionHideNpcMesh()
{
	if (companionRef < 0 || companionRef >= (int)w.refs.size())
		return;
	// Detach baked mesh so only the dressable PlayerBody is drawn
	if (Actor* a = w.actorOf(companionRef))
		a->ref = -1;
}

// Rebuild worn clothing/armor/weapons from the pack and refresh the PlayerBody.
// Taking ARMO/CLOT/WEAP from Share items removes them from the body visually.
void Session::companionSyncGear()
{
	if (companionRef < 0 || companionRef >= (int)w.refs.size())
		return;
	Ref& r = w.refs[companionRef];
	if (r.cell < 0 || r.dead || r.actor < 0)
		return;

	companionDesc.worn.clear();
	bool armed = false;
	bool hasShield = false;
	for (auto& c : r.contents)
	{
		if (c.first == 0)
			continue;
		const Object* o = w.game.object(c.second);
		if (!o)
			continue;
		if (o->type == "ARMO" || o->type == "CLOT")
		{
			companionDesc.worn.push_back(lower(c.second));
			if (o->type == "ARMO" && o->subtype == 8)
				hasShield = true;
		}
		else if (o->type == "WEAP" && o->subtype != WEAP_ARROW && o->subtype != WEAP_BOLT)
		{
			companionDesc.worn.push_back(lower(c.second));
			armed = true;
		}
	}
	companionArmed = armed;
	// weaponOut on rebuild attaches the weapon mesh and the shield (ARMO subtype 8)
	bool showDrawn = armed || hasShield;

	// Ensure identity fields
	if (companionDesc.race.empty())
		companionDesc.race = "imperial";
	playerBodyRebuildRemote(companionBody, w, companionDesc, showDrawn);
	companionBodyActive = companionBody.ready;
	companionHideNpcMesh();
	logf("companion: gear sync worn=%d armed=%d body=%d", (int)companionDesc.worn.size(),
		companionArmed ? 1 : 0, companionBodyActive ? 1 : 0);
	mpSendCompanionGear();
}

void Session::updateCompanionBody(float dt)
{
	if (!companionBodyActive || companionRef < 0 || companionRef >= (int)w.refs.size())
		return;
	Ref& r = w.refs[companionRef];
	if (r.cell < 0)
		return;
	if (r.dead)
	{
		// Hold death pose
		Player localSaved = w.player;
		memcpy(w.player.feet, r.pos, sizeof(w.player.feet));
		w.player.yaw = r.rot[2];
		companionAct = BodyAct();
		companionAct.action = BODY_DEATH;
		companionAct.group = r.deathGroup[0] ? r.deathGroup : "Death1";
		companionMoveX = companionMoveY = companionMoveSpeed = 0.0f;
		companionWeaponOut = false;
		playerBodyUpdateRemote(companionBody, w, dt, companionDesc, companionAct, 0, 0, 0, false);
		w.player = localSaved;
		return;
	}
	companionHideNpcMesh();

	// Movement speed from actual position change
	float speed = 0.0f;
	if (companionPrevPosOk && dt > 1e-4f)
	{
		float dx = r.pos[0] - companionPrevPos[0];
		float dy = r.pos[1] - companionPrevPos[1];
		speed = sqrtf(dx * dx + dy * dy) / dt;
	}
	companionPrevPos[0] = r.pos[0];
	companionPrevPos[1] = r.pos[1];
	companionPrevPos[2] = r.pos[2];
	companionPrevPosOk = true;

	// Resolve weapon for attack anim name
	const Object* wpn = nullptr;
	if (companionArmed && r.actor >= 0)
	{
		const ActorDef& def = w.game.actors[r.actor];
		wpn = w.game.object(def.weapon);
		if (wpn && (wpn->type != "WEAP" || wpn->subtype == WEAP_ARROW || wpn->subtype == WEAP_BOLT))
			wpn = nullptr;
		// Prefer a WEAP still in the pack
		for (auto& c : r.contents)
		{
			if (c.first == 0)
				continue;
			const Object* o = w.game.object(c.second);
			if (o && o->type == "WEAP" && o->subtype != WEAP_ARROW && o->subtype != WEAP_BOLT)
			{
				wpn = o;
				break;
			}
		}
	}

	BodyAct act;
	float mx = 0.0f, my = 0.0f, ms = 0.0f;
	bool inCombat = (r.duelFoe >= 0 || r.ai == AI_COMBAT);
	// Keep weapon + shield visible whenever he still carries them (not only in combat)
	bool weaponOut = companionArmed;
	if (!weaponOut)
	{
		for (auto& c : r.contents)
		{
			if (c.first == 0) continue;
			const Object* o = w.game.object(c.second);
			if (o && o->type == "ARMO" && o->subtype == 8)
			{
				weaponOut = true; // shield only
				break;
			}
		}
	}

	// Attack animation while a blow is under way (hitAt set by npcDuel)
	if (r.hitAt >= 0.0f)
	{
		// Pick attack group once per blow
		if (companionAttackGroup.empty())
		{
			if (!wpn)
				companionAttackGroup = "AttackHH";
			else
			{
				switch (wpn->subtype)
				{
				case 2: case 4: case 8: companionAttackGroup = "Attack2c"; break;
				case 5: case 6: companionAttackGroup = "Attack2w"; break;
				case WEAP_BOW: companionAttackGroup = "AttackBow"; break;
				case WEAP_CROSSBOW: companionAttackGroup = "AttackXbow"; break;
				case WEAP_THROWN: companionAttackGroup = "AttackThrow"; break;
				default: companionAttackGroup = "Attack1h"; break;
				}
				if (r.attackKind == 1) companionAttackGroup += "Sl";
				else if (r.attackKind == 2) companionAttackGroup += "Th";
			}
		}
		float untilHit = r.hitAt - w.time;
		if (untilHit > 0.05f)
		{
			act.action = BODY_WINDUP;
			act.charge = fminf(1.0f, 1.0f - untilHit / 0.5f);
		}
		else
		{
			act.action = BODY_STRIKE;
			act.strength = 0.55f;
		}
		act.group = companionAttackGroup;
		act.speed = 1.0f;
	}
	else
	{
		companionAttackGroup.clear();
		if (speed > 30.0f)
		{
			my = 1.0f;
			ms = speed;
			act.moveY = 1.0f;
		}
	}
	// Stance tag for Idle1h / WalkForward1h etc.
	if (weaponOut && companionArmed)
	{
		if (!wpn)
			act.stance = "HH";
		else if (wpn->subtype == 2 || wpn->subtype == 4 || wpn->subtype == 8 || wpn->subtype == WEAP_CROSSBOW)
			act.stance = "2c";
		else if (wpn->subtype == 5 || wpn->subtype == 6)
			act.stance = "2w";
		else
			act.stance = "1h";
	}
	(void)inCombat;

	companionAct = act;
	companionMoveX = mx;
	companionMoveY = my;
	companionMoveSpeed = ms;
	companionWeaponOut = weaponOut;

	Player localSaved = w.player;
	memcpy(w.player.feet, r.pos, sizeof(w.player.feet));
	w.player.yaw = r.rot[2];
	playerBodyUpdateRemote(companionBody, w, dt, companionDesc, companionAct,
		companionMoveX, companionMoveY, companionMoveSpeed, companionWeaponOut);
	w.player = localSaved;
}

void Session::drawCompanionBody(bool secondEye)
{
	if (!companionBodyActive || !companionBody.ready || companionRef < 0)
		return;
	if (companionRef >= (int)w.refs.size() || w.refs[companionRef].cell < 0)
		return;
	Ref& r = w.refs[companionRef];
	// Re-apply pose for this eye without resetting animation inputs (dt=0)
	Player localSaved = w.player;
	memcpy(w.player.feet, r.pos, sizeof(w.player.feet));
	w.player.yaw = r.rot[2];
	playerBodyUpdateRemote(companionBody, w, 0.0f, companionDesc, companionAct,
		companionMoveX, companionMoveY, companionMoveSpeed, companionWeaponOut);
	companionBody.draw(w, !secondEye);
	w.player = localSaved;
}

// ---- Dynamic wilderness travelers (single-player life) ----
// Spawn a few neutral NPCs outdoors who walk between path-grid points so the wilds feel inhabited.
// They despawn when far from the player or after a few minutes. No save data; pure runtime spice.

static float travelerFrand() { return (rand() % 1000) / 1000.0f; }

static const char* kTravelerIds[] = {
	"imperial guard",          // often converted
	"guard",
	"commoner",
	"hunter",
	"ashlander",
	"pilgrim",
	"traveller",
	"traveler",
	"miner",
	"farmer",
	"scout",
	"npc_hrlb_traveller",
};
static const int kTravelerIdCount = (int)(sizeof(kTravelerIds) / sizeof(kTravelerIds[0]));

void Session::clearDynamicTraveler(int slot)
{
	if (slot < 0 || slot >= kMaxTravelers) return;
	DynamicTraveler& t = travelers[slot];
	if (t.ref >= 0 && t.ref < (int)w.refs.size() && w.refs[t.ref].spawnedRef)
		w.despawn(t.ref);
	t.ref = -1;
	t.life = 0.0f;
	t.repathIn = 0.0f;
}

bool Session::spawnDynamicTraveler()
{
	if (w.current < 0 || w.cells[w.current].interior)
		return false;
	int freeSlot = -1, alive = 0;
	for (int i = 0; i < kMaxTravelers; i++) {
		if (travelers[i].ref >= 0) alive++;
		else if (freeSlot < 0) freeSlot = i;
	}
	if (freeSlot < 0 || alive >= kMaxTravelers)
		return false;

	// Spawn 1200–2200 units away so they walk into view rather than pop in
	float ang = travelerFrand() * 6.2831853f;
	float dist = 1200.0f + travelerFrand() * 1000.0f;
	float pos[3] = {
		w.player.feet[0] + sinf(ang) * dist,
		w.player.feet[1] + cosf(ang) * dist,
		w.player.feet[2]
	};
	// Prefer a nearby path point so they start on walkable ground
	float bestD = 400.0f * 400.0f;
	bool gotSpot = false;
	for (size_t i = 0; i < w.pathPoints.size(); i++) {
		const PathPoint& pp = w.pathPoints[i];
		if (pp.cell < 0 || pp.cell >= (int)w.cells.size() || !w.cells[pp.cell].live)
			continue;
		if (w.cells[pp.cell].interior)
			continue;
		float dx = pp.pos[0] - pos[0], dy = pp.pos[1] - pos[1];
		float d2 = dx * dx + dy * dy;
		if (d2 < bestD) {
			bestD = d2;
			pos[0] = pp.pos[0];
			pos[1] = pp.pos[1];
			pos[2] = pp.pos[2];
			gotSpot = true;
		}
	}
	if (!gotSpot) {
		// No path grid nearby — still try player height
		pos[2] = w.player.feet[2];
	}

	// Try several candidate NPC ids until one is converted for placing
	int ri = -1;
	const char* used = nullptr;
	int start = rand() % kTravelerIdCount;
	for (int n = 0; n < kTravelerIdCount && ri < 0; n++) {
		const char* id = kTravelerIds[(start + n) % kTravelerIdCount];
		ri = w.spawnActor(id, pos, ang + 3.14159f);
		if (ri >= 0) used = id;
	}
	if (ri < 0)
		return false;

	Ref& r = w.refs[ri];
	r.ally = false;
	r.fight = 0;                 // don't pick fights
	r.disposition = 50;
	r.aiPackage = AIPKG_WANDER;
	r.aiRange = 4000;            // wide roam (vanilla is often a few hundred)
	r.aiActive = true;
	r.aiDone = false;
	r.aiDuration = 0.0f;
	r.aiTarget.clear();
	memcpy(r.home, r.pos, sizeof(r.home));
	r.wanderTimer = 0.5f;        // start walking soon
	r.wandering = false;

	travelers[freeSlot].ref = ri;
	travelers[freeSlot].life = 0.0f;
	travelers[freeSlot].repathIn = 25.0f + travelerFrand() * 40.0f;
	logf("traveler: spawned %s ref %d at %.0f %.0f %.0f", used ? used : "?", ri, pos[0], pos[1], pos[2]);
	return true;
}

void Session::updateDynamicTravelers(float dt)
{
	// Multiplayer client: host owns world NPCs
	if (mpMode == 2)
		return;
	if (w.current < 0)
		return;

	const bool outdoors = !w.cells[w.current].interior;
	if (!outdoors) {
		// Indoor: cull travelers so they don't pile up outside unloaded cells
		for (int i = 0; i < kMaxTravelers; i++)
			if (travelers[i].ref >= 0)
				clearDynamicTraveler(i);
		travelerSpawnIn = 15.0f + travelerFrand() * 20.0f;
		return;
	}

	// Maintain existing travelers
	for (int i = 0; i < kMaxTravelers; i++) {
		DynamicTraveler& t = travelers[i];
		if (t.ref < 0) continue;
		if (t.ref >= (int)w.refs.size() || !w.refs[t.ref].spawnedRef ||
		    w.refs[t.ref].cell < 0 || w.refs[t.ref].dead) {
			t.ref = -1;
			continue;
		}
		Ref& r = w.refs[t.ref];
		t.life += dt;
		float dx = r.pos[0] - w.player.feet[0];
		float dy = r.pos[1] - w.player.feet[1];
		float dist = sqrtf(dx * dx + dy * dy);

		// Too far or lived long enough → leave the world
		if (dist > 5500.0f || t.life > 480.0f) {
			logf("traveler: despawn ref %d (dist=%.0f life=%.0f)", t.ref, dist, t.life);
			clearDynamicTraveler(i);
			continue;
		}

		// Periodically shift "home" toward a new path point so wander explores instead of circling one camp
		t.repathIn -= dt;
		if (t.repathIn <= 0.0f) {
			t.repathIn = 30.0f + travelerFrand() * 50.0f;
			float bestScore = -1.0f;
			const PathPoint* best = nullptr;
			for (size_t k = 0; k < w.pathPoints.size(); k++) {
				const PathPoint& pp = w.pathPoints[k];
				if (pp.cell < 0 || pp.cell >= (int)w.cells.size() || !w.cells[pp.cell].live)
					continue;
				if (w.cells[pp.cell].interior)
					continue;
				float px = pp.pos[0] - r.pos[0], py = pp.pos[1] - r.pos[1];
				float d2 = px * px + py * py;
				if (d2 < 400.0f * 400.0f || d2 > 3500.0f * 3500.0f)
					continue;
				if (fabsf(pp.pos[2] - r.pos[2]) > 300.0f)
					continue;
				// Prefer points somewhat toward/away from the player for organic crossing paths
				float toPlayer = (pp.pos[0] - w.player.feet[0]) * (pp.pos[0] - w.player.feet[0])
					+ (pp.pos[1] - w.player.feet[1]) * (pp.pos[1] - w.player.feet[1]);
				float score = d2 + travelerFrand() * 500000.0f - toPlayer * 0.15f;
				if (score > bestScore) {
					bestScore = score;
					best = &pp;
				}
			}
			if (best) {
				r.home[0] = best->pos[0];
				r.home[1] = best->pos[1];
				r.home[2] = best->pos[2];
				r.aiPackage = AIPKG_WANDER;
				r.aiRange = 4000;
				r.wandering = false;
				r.wanderTimer = 0.2f;
				r.aiActive = true;
			}
		}
	}

	// Spawn attempts on a timer while outdoors
	travelerSpawnIn -= dt;
	if (travelerSpawnIn <= 0.0f) {
		travelerSpawnIn = 35.0f + travelerFrand() * 55.0f;
		int alive = 0;
		for (int i = 0; i < kMaxTravelers; i++)
			if (travelers[i].ref >= 0) alive++;
		// Keep the wilds sparse: usually 1, sometimes 2, rarely 3
		int want = 1 + (travelerFrand() < 0.35f ? 1 : 0) + (travelerFrand() < 0.1f ? 1 : 0);
		if (alive < want)
			spawnDynamicTraveler();
	}
}

// ---- World life: companion remarks, nearby idle chatter, outdoor flavor ----

void Session::tryCompanionBark(const char* reason)
{
	if (companionRef < 0 || companionRef >= (int)w.refs.size())
		return;
	const Ref& r = w.refs[companionRef];
	if (r.dead || r.cell < 0 || companionWaiting)
		return;
	// Prefer a real Idle voice line when close enough
	if (w.distanceToPlayer(companionRef) < 1500.0f && idleVoiceOk(companionRef))
		npcSayTopic(companionRef, "Idle");

	static const char* enterLines[] = {
		"Looks quiet enough.",
		"Stay close.",
		"I don't like the feel of this place.",
		"On me.",
		"Eyes open.",
	};
	static const char* combatLines[] = {
		"To arms!",
		"I've got your back!",
		"Hold the line!",
		"Enemy!",
	};
	static const char* roadLines[] = {
		"Long road yet.",
		"We should keep moving.",
		"Nothing but dust and ash out here.",
		"Hear that? Just the wind.",
		"A good day to travel.",
	};
	static const char* waitLines[] = {
		"I'll hold here.",
		"Call when you need me.",
	};
	const char** pool = roadLines;
	int n = 5;
	if (reason && strcmp(reason, "enter") == 0) { pool = enterLines; n = 5; }
	else if (reason && strcmp(reason, "combat") == 0) { pool = combatLines; n = 4; }
	else if (reason && strcmp(reason, "wait") == 0) { pool = waitLines; n = 2; }
	if (travelerFrand() < 0.55f)
		notify(std::string(companionName) + ": \"" + pool[rand() % n] + "\"");
}

void Session::updateWorldLife(float dt)
{
	if (mpMode == 2)
		return;
	if (w.current < 0 || !w.controlsEnabled || screen != SCR_NONE)
		return;

	const bool outdoors = !w.cells[w.current].interior;
	const std::string& cellName = w.cells[w.current].name;

	// Companion: new cell remark
	if (cellName != lifeLastCell) {
		lifeLastCell = cellName;
		if (companionRef >= 0 && travelerFrand() < 0.65f)
			tryCompanionBark("enter");
		lifeCompanionBarkIn = 18.0f + travelerFrand() * 25.0f;
	}

	// Companion: combat start
	bool anyCombat = false;
	w.forLoadedActors([&](int i) {
		if (w.refs[i].ai == AI_COMBAT && !w.refs[i].dead && !w.refs[i].ally)
			anyCombat = true;
	});
	if (anyCombat && !lifeWasInCombat && companionRef >= 0)
		tryCompanionBark("combat");
	lifeWasInCombat = anyCombat;

	// Companion: occasional road talk while following outdoors
	lifeCompanionBarkIn -= dt;
	if (lifeCompanionBarkIn <= 0.0f) {
		lifeCompanionBarkIn = 45.0f + travelerFrand() * 70.0f;
		if (companionRef >= 0 && !companionWaiting && outdoors && !anyCombat)
			tryCompanionBark("road");
	}

	// Nearby peaceful NPCs: extra Idle voice so towns/roads feel chatty
	lifeIdlePulseIn -= dt;
	if (lifeIdlePulseIn <= 0.0f) {
		lifeIdlePulseIn = 6.0f + travelerFrand() * 10.0f;
		std::vector<int> candidates;
		for (int i : w.loadedActors) {
			const Ref& r = w.refs[i];
			if (r.dead || r.type != "NPC_" || r.actor < 0 || r.ai == AI_COMBAT)
				continue;
			if (!idleVoiceOk(i) || !sayDone(i))
				continue;
			float d = w.distanceToPlayer(i);
			if (d < 200.0f || d > 900.0f)
				continue;
			candidates.push_back(i);
		}
		if (!candidates.empty() && travelerFrand() < 0.55f) {
			int pick = candidates[rand() % candidates.size()];
			npcSayTopic(pick, "Idle");
		}
	}

	// Wilderness flavor (text only — implies life beyond the loaded ring)
	lifeFlavorIn -= dt;
	if (lifeFlavorIn <= 0.0f) {
		lifeFlavorIn = 50.0f + travelerFrand() * 90.0f;
		if (outdoors && !anyCombat && travelerFrand() < 0.4f) {
			static const char* wild[] = {
				"You hear distant wings beat against the wind.",
				"Something small skitters through the brush nearby.",
				"A faint trail of smoke hangs on the horizon.",
				"Far off, a creature calls once and falls silent.",
				"The ash shifts as if something passed this way earlier.",
				"You catch the smell of a campfire, already cold.",
				"Footprints cross the path — not yours.",
			};
			static const char* night[] = {
				"A night insect drones somewhere in the dark.",
				"You feel watched, then the feeling passes.",
				"Ember-light flickers far away and dies.",
				"The wind carries a fragment of song, then nothing.",
			};
			float hour = w.gameHour;
			bool isNight = (hour >= 20.0f || hour < 5.0f);
			const char** pool = isNight ? night : wild;
			int n = isNight ? 4 : 7;
			if (travelerFrand() < 0.7f)
				notify(pool[rand() % n]);
		}
	}
}

// Shore ambience: loops while the cell has water, louder the closer the player is to its level
void Session::updateAmbience()
{
	// Only open water counts: the whole world shares one water level, so Balmora's river is "sea"
	// too. The converter measured each cell's share of ground well under the water (a coast is a
	// third or more, a river a few percent); nearby cells over the threshold make the sound, fading
	// with distance.
	float sea = 0.0f;
	for (LoadedCell* l : w.loaded)
	{
		const LevelCell& c = w.cells[l->index];
		if (c.interior)
			continue;
		float dx = (c.gx + 0.5f) * 8192.0f - w.player.feet[0], dy = (c.gy + 0.5f) * 8192.0f - w.player.feet[1];
		float near = fmaxf(0.0f, 1.0f - sqrtf(dx * dx + dy * dy) / 12000.0f);
		sea = fmaxf(sea, fminf(1.0f, fmaxf(0.0f, (c.sea - 0.2f) / 0.3f)) * near);
	}
	bool want = sea > 0.02f && !w.game.waterSound.empty();
	if (!want)
	{
		if (waterChannel >= 0)
		{
			audioStop(waterChannel);
			waterChannel = -1;
		}
		return;
	}
	auto it = w.game.sounds.find(lower(w.game.waterSound));
	if (it == w.game.sounds.end())
		return;
	float height = w.player.feet[2] - w.here().waterZ;
	float volume = it->second.volume * sea * fmaxf(0.0f, fminf(1.0f, 1.0f - height / 900.0f)) * 0.7f;
	if (waterChannel < 0 || !audioPlaying(waterChannel))
		waterChannel = audioPlay(it->second.file, volume, 0.0f, true);
	else
		audioSetMix(waterChannel, volume, 0.0f);
}

// ---- Stereo 3D

// One eye's render time, smoothed over about a second (a stereo frame counts half per eye)
void Session::noteRenderCost(float cpuMs, float gpuMs, bool stereo, float eyeCmd)
{
	float cost = fmaxf(cpuMs, gpuMs) * (stereo ? 0.5f : 1.0f);
	renderCost += (cost - renderCost) * 0.05f;
	// GPU command buffer share of one eye: rises at once, falls slowly
	eyeCmdUse = eyeCmd > eyeCmdUse ? eyeCmd : eyeCmdUse + (eyeCmd - eyeCmdUse) * 0.02f;
}

// Distance to what the crosshair points at: the target when there is one, else the first wall / ground
// along the view (up to 3000)
float Session::aimDepth()
{
	const float kFar = 3000.0f;
	float cp = cosf(w.player.pitch);
	float dir[3] = { sinf(w.player.yaw) * cp, cosf(w.player.yaw) * cp, sinf(w.player.pitch) };
	float from[3] = { w.player.feet[0], w.player.feet[1], playerEyeZ(w.player) };
	float to[3] = { from[0] + dir[0] * kFar, from[1] + dir[1] * kFar, from[2] + dir[2] * kFar };
	float best = kFar;
	for (LoadedCell* l : w.loaded)
	{
		float t;
		if (collisionRaycast(l->cell.collision, from, to, &t))
			best = fminf(best, t * kFar);
	}
	if (target >= 0 && w.active(target))
	{
		const Ref& r = w.refs[target];
		float dx = r.pos[0] - from[0], dy = r.pos[1] - from[1];
		best = fminf(best, sqrtf(dx * dx + dy * dy));
	}
	return fmaxf(best, 20.0f);
}

// 0 or 1: whether this frame should be stereo: the player's choice (menu toggle, slider), whatever
// the frame rate; only a second eye that wouldn't fit the GPU command buffer waits
float Session::stereoTarget(float slider, float dt)
{
	(void)dt;
	if (slider <= 0.0f || stereoMode == STEREO_OFF || w.current < 0)
		return 0.0f;
	// A second eye has to fit in the frame's GPU command buffer next to the first (and the HUDs)
	if (!stereoCmdRoom && eyeCmdUse < 0.3f)
		stereoCmdRoom = true;
	else if (stereoCmdRoom && eyeCmdUse > 0.4f)
		stereoCmdRoom = false;
	return stereoCmdRoom ? 1.0f : 0.0f;
}

// Outdoors, the fog (and with it what is drawn) closes in while a frame's work runs past 30 fps
// and eases back out once there is room again; indoors the view stays whole
//
// An Old 3DS (a CPU a third as fast) caps the frame rate instead of letting it wander: 30 while a frame's work stays
// under 30 fps' 33 ms, 20 once it keeps running past, 30 again once it keeps well under. Both are even shares of
// the screen's 60 Hz: a cap of 24 would show frames for 2 and 3 refreshes in turn, a judder worse than a steady 20.
// Only past 20 fps' 50 ms does the fog close in (interiors, most of the game, hold 30)
void Session::adaptView(float workMs)
{
	// One long frame (a cell arriving) shouldn't shrink the view: each counts at most as a slow one
	workCost += (fminf(workMs, g_profile.workCap) - workCost) * 0.1f;
	float budget = 34.0f;
	if (g_profile.capSteps)
	{
		// two seconds past the 30 fps budget: 20; four seconds well under it: 30 again
		bool slow = frameCap == 30 ? workCost > 31.0f : workCost < 24.0f;
		capFrames = slow ? capFrames + 1 : 0;
		if (capFrames >= (frameCap == 30 ? 60 : 80))
		{
			frameCap = frameCap == 30 ? 20 : 30;
			capFrames = 0;
			logf("view: frame rate capped at %d (frame work %.1f ms)", frameCap, workCost);
		}
		budget = frameCap == 30 ? 1000.0f : 47.0f;      // (at 30 the cap gives way first)
	}
	float minScale = g_profile.viewScaleMin, maxScale = g_profile.viewScaleMax;
	if (w.current < 0 || w.cells[w.current].interior)
	{
		// (indoors the view is whole whatever this says: the Old 3DS keeps its outdoor view for the way out)
		if (!g_profile.keepViewIndoors)
			viewScale = 1.0f;
		return;
	}
	if (workCost > budget)
		viewScale = fmaxf(minScale, viewScale - 0.004f);
	else if (workCost < budget - 4.0f)
		viewScale = fminf(maxScale, viewScale + 0.002f);
}

static const char* kSettingsPath = "sdmc:/3ds/mw3ds/settings.txt";
int g_controlLayout = CONTROLS_XBOX;
int g_gyroAim = 0;                // gyro aim starts off (until it is tried on the device): Options turns it on
static int s_gyroSens = 100;      // gyro aim's sensitivity, kept while it is off
int g_cstickSens = 100;            // More options: look sensitivity percent (25..200)
bool g_subtitles = true;           // More options: spoken-line subtitles on the top screen
bool g_xpDefault = false;          // More options: new characters start with XP leveling
int g_brightness = 100;            // More options: daylight brightness percent (70..130)
int g_drawDistance = 100;          // Graphics: percent of the normal view distance (25..100)
bool g_fogVisible = true;          // Graphics: fog drawn
bool g_weatherOff = false;         // Graphics: weather forced clear
unsigned g_renderOff = 0;          // Graphics > Performance: PERF_* bits switched off
int g_actorDist = 100;             // Performance: character view distance percent
int g_clutterDist = 100;           // Performance: clutter view distance percent
int g_frameCapUser = 0;            // Performance: 0 automatic, 30 or 60
bool g_showFps = true;             // Performance: frame rate on the bottom screen
bool g_footsteps = true;
bool g_invertY = false, g_swapSticks = false, g_autoRun = false;
bool g_hideHud = false, g_hideCrosshair = false, g_hideMinimap = false, g_shotHideHud = false;
bool g_hudTemp = false;
int g_autosaveMin = 0;
bool g_mapBlue = true;       // Readable UI: custom outlined map triangle by default
int g_mapColorIdx = 0;       // 0 = bright blue (palette in screens_map.cpp)
int g_textSize = 100;        // Readable UI: system-font size percent (90/100/115/130)
bool g_godMode = false, g_infMagic = false, g_noWeight = false;
int g_cheatSpeed = 100, g_cheatJump = 100;
bool g_pcAskAddress = false;
int g_mpAsk = 0;
std::string g_mpHostIp;

void Session::loadSettings()
{
	// An Old 3DS starts with 3D off (the second eye is the whole scene again on a CPU a third as fast); the Options
	// toggle still turns it on
	if (!g_profile.stereoAtStart)
		stereoMode = STEREO_OFF;
	// ... and the GoldenEye layout: one with no C-stick or ZL / ZR (those need a Circle Pad Pro there)
	if (g_profile.goldenEyeAtStart)
		g_controlLayout = CONTROLS_GOLDENEYE;
	FILE* f = fopen(kSettingsPath, "r");
	if (!f)
		return;
	bool gyroOff = false;
	char line[64];
	while (fgets(line, sizeof(line), f))
	{
		if (strncmp(line, "stereo=on", 9) == 0) stereoMode = STEREO_ON;
		else if (strncmp(line, "stereo=off", 10) == 0) stereoMode = STEREO_OFF;
		else if (strncmp(line, "stereo=auto", 11) == 0) stereoMode = STEREO_ON;
		else if (strncmp(line, "difficulty=", 11) == 0) difficulty = atoi(line + 11);
		else if (strncmp(line, "effects=", 8) == 0) effectsVolume = atoi(line + 8);
		else if (strncmp(line, "music=", 6) == 0) musicVolume = atoi(line + 6);
		else if (strncmp(line, "controls=classic", 16) == 0) g_controlLayout = CONTROLS_CLASSIC;
		else if (strncmp(line, "combat=gbac", 11) == 0) combatMode = COMBAT_GBAC;
		else if (strncmp(line, "numbers=on", 10) == 0) hitIndicators = true;
		else if (strncmp(line, "numbers=off", 11) == 0) hitIndicators = false;
		else if (strncmp(line, "csticksens=", 11) == 0)
		{
			int s = atoi(line + 11);
			g_cstickSens = s < 25 ? 25 : s > 200 ? 200 : s;
		}
		else if (strncmp(line, "subtitles=off", 13) == 0) g_subtitles = false;
		else if (strncmp(line, "subtitles=on", 12) == 0) g_subtitles = true;
		else if (strncmp(line, "xpdefault=on", 12) == 0) g_xpDefault = true;
		else if (strncmp(line, "xpdefault=off", 13) == 0) g_xpDefault = false;
		else if (strncmp(line, "brightness=", 11) == 0)
		{
			int b = atoi(line + 11);
			g_brightness = b < 70 ? 70 : b > 130 ? 130 : b;
		}
		else if (strncmp(line, "fog=off", 7) == 0) g_fogVisible = false;
		else if (strncmp(line, "fog=on", 6) == 0) g_fogVisible = true;
		else if (strncmp(line, "weather=off", 11) == 0) g_weatherOff = true;
		else if (strncmp(line, "weather=on", 10) == 0) g_weatherOff = false;
		else if (strncmp(line, "drawdist=", 9) == 0)
		{
			int d = atoi(line + 9);
			g_drawDistance = d < 25 ? 25 : d > 100 ? 100 : d;
		}
		else if (strncmp(line, "perfoff=", 8) == 0) g_renderOff = (unsigned)atoi(line + 8) & 63u;
		else if (strncmp(line, "actordist=", 10) == 0) { int v = atoi(line + 10); g_actorDist = v < 25 ? 25 : v > 200 ? 200 : v; }
		else if (strncmp(line, "clutterdist=", 12) == 0) { int v = atoi(line + 12); g_clutterDist = v < 25 ? 25 : v > 200 ? 200 : v; }
		else if (strncmp(line, "framecap=", 9) == 0) { int v = atoi(line + 9); g_frameCapUser = v == 30 || v == 60 ? v : 0; }
		else if (strncmp(line, "showfps=off", 11) == 0) g_showFps = false;
		else if (strncmp(line, "showfps=on", 10) == 0) g_showFps = true;
		else if (strncmp(line, "inverty=on", 10) == 0) g_invertY = true;
		else if (strncmp(line, "inverty=off", 11) == 0) g_invertY = false;
		else if (strncmp(line, "swapsticks=on", 13) == 0) g_swapSticks = true;
		else if (strncmp(line, "swapsticks=off", 14) == 0) g_swapSticks = false;
		else if (strncmp(line, "footsteps=on", 12) == 0) g_autoRun = true;
		else if (strncmp(line, "footsteps=off", 12) == 0) g_autoRun = false;
		else if (strncmp(line, "autorun=on", 10) == 0) g_autoRun = true;
		else if (strncmp(line, "autorun=off", 11) == 0) g_autoRun = false;
		else if (strncmp(line, "hidehud=on", 10) == 0) g_hideHud = true;
		else if (strncmp(line, "hidehud=off", 11) == 0) g_hideHud = false;
		else if (strncmp(line, "hidecross=on", 12) == 0) g_hideCrosshair = true;
		else if (strncmp(line, "hidecross=off", 13) == 0) g_hideCrosshair = false;
		else if (strncmp(line, "hidemap=on", 10) == 0) g_hideMinimap = true;
		else if (strncmp(line, "hidemap=off", 11) == 0) g_hideMinimap = false;
		else if (strncmp(line, "shothud=on", 10) == 0) g_shotHideHud = true;
		else if (strncmp(line, "shothud=off", 11) == 0) g_shotHideHud = false;
		else if (strncmp(line, "sysfont=", 8) == 0) uiSetFontMode(atoi(line + 8));      // READABLE_UI_MOD
		else if (strncmp(line, "mapblue=on", 10) == 0) g_mapBlue = true;
		else if (strncmp(line, "mapblue=off", 11) == 0) g_mapBlue = false;
		else if (strncmp(line, "mapcolor=", 9) == 0) { int v = atoi(line + 9); g_mapColorIdx = (v < 0 || v > 7) ? 0 : v; }
		else if (strncmp(line, "textsize=", 9) == 0) {
			int v = atoi(line + 9);
			g_textSize = (v == 90 || v == 100 || v == 115 || v == 130) ? v : 100;
		}
		else if (strncmp(line, "autosave=", 9) == 0) { int v = atoi(line + 9); g_autosaveMin = v == 5 || v == 10 || v == 15 || v == 30 ? v : 0; }
		else if (strncmp(line, "combat=vanilla", 14) == 0) combatMode = COMBAT_VANILLA;
		else if (strncmp(line, "controls=xbox", 13) == 0) g_controlLayout = CONTROLS_XBOX;
		else if (strncmp(line, "controls=goldeneye", 18) == 0) g_controlLayout = CONTROLS_GOLDENEYE;
		else if (strncmp(line, "gyroaim=off", 11) == 0) gyroOff = true;
		else if (strncmp(line, "gyrosens=", 9) == 0 && atoi(line + 9) > 0) s_gyroSens = atoi(line + 9);
	}
	fclose(f);
	// (off at every start for now, whatever was saved: gyro aim is still to be tried on the device; the sensitivity is kept)
	(void)gyroOff;
	g_gyroAim = 0;
}

void Session::saveSettings()
{
	FILE* f = fopen(kSettingsPath, "w");
	if (!f)
		return;
	fprintf(f, "stereo=%s\n", stereoMode == STEREO_OFF ? "off" : "on");
	fprintf(f, "difficulty=%d\neffects=%d\nmusic=%d\n", difficulty, effectsVolume, musicVolume);
	fprintf(f, "controls=%s\n", g_controlLayout == CONTROLS_CLASSIC ? "classic" : g_controlLayout == CONTROLS_GOLDENEYE ? "goldeneye" : "xbox");
	if (g_gyroAim > 0)
		s_gyroSens = g_gyroAim;
	fprintf(f, "gyroaim=%s\ngyrosens=%d\n", g_gyroAim > 0 ? "on" : "off", s_gyroSens);
	fprintf(f, "combat=%s\n", combatMode == COMBAT_GBAC ? "gbac" : "vanilla");
	fprintf(f, "numbers=%s\n", hitIndicators ? "on" : "off");
	fprintf(f, "csticksens=%d\n", g_cstickSens);
	fprintf(f, "subtitles=%s\n", g_subtitles ? "on" : "off");
	fprintf(f, "xpdefault=%s\n", g_xpDefault ? "on" : "off");
	fprintf(f, "brightness=%d\n", g_brightness);
	fprintf(f, "fog=%s\n", g_fogVisible ? "on" : "off");
	fprintf(f, "weather=%s\n", g_weatherOff ? "off" : "on");
	fprintf(f, "drawdist=%d\n", g_drawDistance);
	fprintf(f, "perfoff=%u\n", g_renderOff);
	fprintf(f, "inverty=%s\nswapsticks=%s\nautorun=%s\nfootsteps=%s\n",g_invertY ? "on" : "off", g_swapSticks ? "on" : "off", g_autoRun ? "on" : "off", g_footsteps ? "on" : "off");
	fprintf(f, "actordist=%d\nclutterdist=%d\nframecap=%d\n", g_actorDist, g_clutterDist, g_frameCapUser);
	fprintf(f, "showfps=%s\n", g_showFps ? "on" : "off");
	fprintf(f, "inverty=%s\nswapsticks=%s\nautorun=%s\n", g_invertY ? "on" : "off", g_swapSticks ? "on" : "off", g_autoRun ? "on" : "off");
	fprintf(f, "hidehud=%s\nhidecross=%s\nhidemap=%s\nshothud=%s\n", g_hideHud ? "on" : "off", g_hideCrosshair ? "on" : "off",
		g_hideMinimap ? "on" : "off", g_shotHideHud ? "on" : "off");
	fprintf(f, "autosave=%d\n", g_autosaveMin);
	fprintf(f, "sysfont=%d\n", g_fontMode);      // READABLE_UI_MOD
	fprintf(f, "mapblue=%s\n", g_mapBlue ? "on" : "off");
	fprintf(f, "mapcolor=%d\n", g_mapColorIdx);
	fprintf(f, "textsize=%d\n", g_textSize);
	fclose(f);
}

// Called by the main loop after it has shown the loading screen
void Session::finishTravel()
{
	int dest = travelCell;
	travelCell = -1;
	if (g_profile.cleanAtDoors)
		cleanForLoad();
	w.player.inertia[0] = w.player.inertia[1] = 0.0f;     // (a jump's take-off doesn't come along: doors, travel)
	// Voices of the cell we leave stop with it
	for (auto& r : w.refs)
		if (r.voiceChannel >= 0)
		{
			audioStop(r.voiceChannel);
			r.voiceChannel = -1;
		}
	sayUntil.clear();
	subtitle.clear();
	stopLoopSounds();
	target = -1;
	u64 start = osGetTime();
	// Followers (a follow package, summons; not escorts) within 800 units come along (OpenMW's getFollowers): not
	// one whose script says stayoutside when it is outdoors and the way leads in; one fighting the player stops
	// instead and stays
	std::vector<int> followers;
	bool toExterior = !w.cells[dest].interior;
	for (int i : w.loadedActors)
		if (w.followsPlayer(i) && w.refs[i].aiPackage != AIPKG_ESCORT)
		{
			Ref& f = w.refs[i];
			float* stay = f.script >= 0 ? w.scripts[f.script].local("stayoutside") : nullptr;
			float dx = f.pos[0] - w.player.feet[0], dy = f.pos[1] - w.player.feet[1], dz = f.pos[2] - w.player.feet[2];
			bool taken = followerTaken(dx * dx + dy * dy + dz * dz, stay && *stay == 1.0f, !w.cells[w.placeOf(i)].interior, toExterior);
			logf("travel: follower %s %.0f units away%s", f.id.c_str(), sqrtf(dx * dx + dy * dy + dz * dz), taken ? "" : ", stays");
			if (!taken)
				continue;
			if (f.ai == AI_COMBAT)
			{
				f.ai = AI_IDLE;
				continue;
			}
			followers.push_back(i);
		}
	// Outdoors the cells to load follow the player's position
	w.player.feet[0] = travelPos[0];
	w.player.feet[1] = travelPos[1];
	if (!w.enterCell(dest))
	{
		logf("travel: failed to load %s (linear free %lu KB)", w.cells[dest].name.c_str(), linearSpaceFree() / 1024);
		notify("Could not load " + w.cells[dest].name + " (out of memory?). See log.txt.");
		return;
	}
	if (g_profile.cleanAtDoors && !w.streamJob)
		trimSkeletons();                 // (the place left: its people's skeletons)
	if (travelToSpawn)
	{
		travelToSpawn = false;
		const float* sp = w.here().spawn;
		if (sp[0] != 0.0f || sp[1] != 0.0f)
		{
			memcpy(travelPos, sp, sizeof(travelPos));
			travelYaw = w.here().yaw;
			w.player.feet[0] = sp[0];
			w.player.feet[1] = sp[1];
		}
		else
			travelPos[2] = 2000.0f;   // no spawn spot: dropped onto the ground from the middle
	}
	float eye[3] = { travelPos[0], travelPos[1], travelPos[2] + PLAYER_EYE_HEIGHT };
	Scene scene = w.scene();
	playerSpawn(w.player, scene, eye, travelYaw, 0.0f);
	for (size_t k = 0; k < followers.size(); k++)
	{
		// Just ahead of the player, side by side (behind is the door, often a wall)
		float back = -72.0f, side = ((int)k - (int)followers.size() / 2) * 64.0f + (k % 2 ? 40.0f : -40.0f);
		float fx = sinf(w.player.yaw), fy = cosf(w.player.yaw);
		float pos[3] = { w.player.feet[0] - fx * back + fy * side, w.player.feet[1] - fy * back - fx * side,
			w.player.feet[2] };
		int c = w.current;
		if (!w.cells[c].interior)
		{
			int g = w.gridCell((int)floorf(pos[0] / 8192.0f), (int)floorf(pos[1] / 8192.0f));
			if (g >= 0 && w.cells[g].live)
				c = g;
		}
		w.relocate(followers[k], c, pos, w.player.yaw);
	}
	fade = 1.0f;
	if (!autotest)
		save();
	logf("travel: %s in %llu ms, feet %.0f %.0f %.0f", w.cellName().c_str(), osGetTime() - start,
		w.player.feet[0], w.player.feet[1], w.player.feet[2]);
}

void Session::setName(const std::string& name)
{
	w.stats.name = name.empty() ? "Stranger" : name;
	wantName = false;
	logf("chargen: name %s", w.stats.name.c_str());
}

// What was typed on the system keyboard: the name of the spell / enchanted item being made (a cancel keeps the
// name), or the journal's search (empty: everything again)
void Session::setText(bool confirmed, const std::string& text)
{
	int kind = wantText;
	wantText = TEXT_NONE;
	if (!confirmed)
		return;
	bool blank = text.find_first_not_of(' ') == std::string::npos;
	if (kind == TEXT_MAKENAME && !blank)
	{
		makeName = text;
		logf("making: name %s", makeName.c_str());
	}
	else if (kind == TEXT_SEARCH)
	{
		journalSearch = blank ? "" : text;
		list2 = UiList();
		logf("journal: search \"%s\"", journalSearch.c_str());
	}

	else if (kind == TEXT_CONSOLE)
	{
		consoleInput = text;
	}}

std::string Session::textNow()
{
	if (wantText == TEXT_SEARCH) return journalSearch;
	if (wantText == TEXT_CONSOLE) return consoleInput;
	return makeName;
}

void Session::openScreen(Screen s)
{
	screen = s;
	list = UiList();
	list2 = UiList();
	grid = UiGrid();
	scroll = UiScroll();
	focus = 0;
	containerPutting = false;
	playSound(-1, "Menu Click");
}

void Session::closeScreen()
{
	if (screen == SCR_DIALOGUE || screen == SCR_BARTER || screen == SCR_TRAVEL || screen == SCR_SPELLS
		|| screen == SCR_TRAINING || screen == SCR_PERSUADE || screen == SCR_SPELLMAKE
		|| (screen == SCR_REPAIR && repairRef >= 0)
		|| (screen == SCR_ENCHANT && enchanterRef >= 0))
		dialogueClose(dlg, w);
	barterRef = -1;
	// Walking away from someone's pockets: one last chance they notice
	if (screen == SCR_CONTAINER && pickpocketing && containerRef >= 0 && pickpocketCaught(0.0f))
	{
		logf("pickpocket: caught leaving %s", w.refs[containerRef].id.c_str());
		say(containerRef, "", w.game.gmst("scaughtstealingmessage", "Hey he's stealing my stuff!"));
		crimeSeen(CRIME_PICKPOCKET, 0, containerRef), reportCrime(containerRef, (int)w.game.gmstf("icrimepickpocket", 25));
	}
	pickpocketing = false;
	screen = SCR_NONE;
	bookRef = containerRef = -1;
	bookItem.clear();
	bookPagesOf.clear();
	bookSpread = 0;
}

// Per-frame time of each part of the update, summed until main logs them once a second
float g_profParts[PROF_COUNT];

static u64 profTick()
{
	return svcGetSystemTick();
}

static void profAdd(int part, u64& since)
{
	u64 now = svcGetSystemTick();
	g_profParts[part] += (now - since) * 1000.0f / SYSCLOCK_ARM11;
	since = now;
}

bool Session::refInUse(int ri) const
{
	if (ri == target || ri == enemyRef || ri == repairRef || ri == barterRef || ri == bookRef || ri == containerRef
		|| ri == arrestingGuard || ri == dlg.ref || w.followsPlayer(ri))
		return true;
	// speaking now (an entry stayed for everyone who ever said a line: a cell where someone once greeted the player was
	// never let go of, so memory filled with them and saves carried them whole)
	auto say = sayUntil.find(ri);
	if (say != sayUntil.end() && w.time < say->second)
		return true;
	for (auto& p : projectiles)
		if (p.owner == ri)
			return true;
	return false;
}

extern "C" u32 __ctru_heap_size;

int Session::refBudget() const
{
	int budget = g_profile.refBudget;
	// The heap filling up (past four fifths): fewer still, whatever the console
	if ((size_t)mallinfo().uordblks > __ctru_heap_size / 5 * 4)
		budget = std::min(budget, w.refsInMemory() * 3 / 4);
	return budget;
}

// The skeletons no loaded actor uses go (read again when met). Returns the KB freed
int Session::trimSkeletons()
{
	std::vector<int> keep;
	for (LoadedCell* l : w.loaded)
		for (const Actor& a : l->actors.actors)
			keep.push_back(a.skeleton);
	for (const Actor& a : body.set.actors)
		keep.push_back(a.skeleton);
	if (body.skel >= 0)
		keep.push_back(body.skel);
	int kb = skeletonsTrim(keep);
	if (kb > 0)
		logf("memory: %d KB of animation skeletons let go, heap used %d KB", kb, mallinfo().uordblks / 1024);
	return kb;
}

void Session::cleanForLoad()
{
	int before = mallinfo().uordblks / 1024;
	w.waitForStream();                 // (no cell streaming: its actors may be reading a skeleton)
	evictFarCells(0);
	freeMapTiles();
	audioCacheClear();
	trimSkeletons();
	Atom::prefill();
	logf("memory: cleaned for the load: heap used %d KB (was %d KB), biggest free block %u KB", mallinfo().uordblks / 1024, before,
		(unsigned)(heapLargestBlock() / 1024));
}

void Session::relieveMemory(bool force)
{
	// (at most a few times a second: while nothing more can go, every frame would scan the cells again)
	static u64 last = 0;
	u64 now = osGetTime();
	if (!force && now - last < 250)
		return;
	last = now;
	int before = mallinfo().uordblks / 1024;
	evictFarCells(0);
	freeMapTiles();
	memoryReserveTake();
	// Still spent: the first round freed nothing contiguous (far cells were already gone). Escalate, or
	// the streaming thread retries its allocation forever against the same holes — the step-631 freeze:
	// unused skeletons first, then a loaded neighbour's geometry (its collision arrays are the large
	// single blocks the loader wants; the cell streams back in once there is room)
	if (!memoryReserveHeld())
	{
		trimSkeletons();
		memoryReserveTake();
		if (!memoryReserveHeld() && w.dropFarthestLiveNeighbour())
			memoryReserveTake();
	}
	int after = mallinfo().uordblks / 1024;
	static int lastLogged = -1;
	if (after != lastLogged || memoryReserveHeld())
		logf("memory: the heap ran out: far cells and map tiles freed, %d KB used (was %d KB), reserve %s", after,
			before, memoryReserveHeld() ? "taken again" : "still spent");
	lastLogged = after;
}

void Session::evictFarCells(int budget, bool now)
{
	if (budget < 0)
		budget = refBudget();
	// lines said and done are forgotten (their references' slots go to other cells' objects)
	for (auto it = sayUntil.begin(); it != sayUntil.end();)
		it = w.time >= it->second ? sayUntil.erase(it) : std::next(it);
	int n = w.evictCells(budget, [this](int ri) { return refInUse(ri); }, now);
	if (n)
		logf("world: %d cells' objects out of memory, %d objects in memory, %d cells' changes kept",
			n, w.refsInMemory(), (int)w.cellStates.size());
}

// The menus that stop the world (OpenMW: a GUI mode stops the simulation). Talk, barter and the other
// services with an NPC don't (he keeps moving, as in Morrowind), nor do rest, travel, death or creation.
bool Session::worldPaused() const
{
	if (dlg.open)
		return false;
	switch (screen)
	{
	case SCR_INVENTORY: case SCR_MAGIC: case SCR_SPELLS: case SCR_STATS: case SCR_MAP: case SCR_JOURNAL:
	case SCR_SAVES: case SCR_OPTIONS: case SCR_CONTROLS: case SCR_GAMEMENU: case SCR_BOOK: case SCR_CONTAINER:
	case SCR_MOREOPTIONS: case SCR_CHEATS: case SCR_GRAPHICS: case SCR_PERFORMANCE: case SCR_CTRLSET:
	case SCR_INTERFACE: case SCR_TELEPORT: case SCR_PCLINK: case SCR_CONSOLE: case SCR_MULTIPLAYER:
		return true;
	default:
		return false;
	}
}

void Session::update(const PlayerInput& inRaw, float dt)
{
	netUpdate(dt);
	u64 t = profTick();
	MARK("world update");
	w.pcWeaponDrawn = weaponDrawn;
	w.update(dt);
	profAdd(PROF_WORLD, t);
	updateDynamicTravelers(dt);
	updateWorldLife(dt);
	revealLocalMap();
	// A named place outdoors, once visited, is on the map
	if (w.current >= 0 && w.current != mapCell)
	{
		mapCell = w.current;
		if (!w.cells[mapCell].interior)
		{
			if (w.mapKnown.insert(lower(w.cells[mapCell].name)).second && !w.cells[mapCell].name.empty())
				awardXp(4.0f, "discovery");
			w.mapCells.insert(World::mapCellKey(w.cells[mapCell].gx, w.cells[mapCell].gy));
		}
	}
	// The journal opens on its newest page
	if (screen != SCR_JOURNAL)
	{
		journalPage = 0;
		journalPicking = false;
	}
	// The map screen starts centred on the player and gives its detail tiles back when it closes
	if (screen != SCR_MAP)
	{
		mapViewSet = false;
		freeMapTiles();
		mapDoorTip = -1;
		mapLocal = (w.current >= 0 && w.cells[w.current].interior) || mapLocalOutdoors;
	}
	// Every few seconds: cells the player left far behind give their objects' memory back
	if ((evictTimer -= dt) <= 0.0f)
	{
		evictTimer = 5.0f;
		evictFarCells();
		// An Old 3DS lets go of the animation skeletons no loaded actor uses (they are read again when met)
		if (g_profile.cleanAtDoors && !w.streamJob)
			trimSkeletons();
		// ... and the string pool takes its next block now, while the heap is tidy, not mid-parse
		if (g_profile.cleanAtDoors)
			Atom::prefill();
		// Corprus: note when it was caught; a day later it is worse (the numbers follow)
		bool corprus = w.pcHasCorprus();
		if (corprus && w.corprusSince < 0.0f)
			w.corprusSince = w.gameHour;
		else if (!corprus && w.corprusSince > -1.5f)
			w.corprusSince = -1.0f;                // (-2: cured, kept)
		if (corprus && w.corprusLevel() != corprusShown)
		{
			if (corprusShown > 0)
				notify("Your Corprus disease grows worse.");
			corprusShown = w.corprusLevel();
			PlayerStats& s = w.stats;
			float hp = s.health, mp = s.magicka, fp = s.fatigue;
			w.recomputeStats();
			s.health = fminf(s.healthMax, hp);
			s.magicka = fminf(s.magickaMax, mp);
			s.fatigue = fminf(s.fatigueMax, fp);
		}
	}

	if (!menuOpen() && !wantName && !pendingMenus.empty())
	{
		ScriptMenu m = pendingMenus.front();
		pendingMenus.erase(pendingMenus.begin());
		switch (m)
		{
		case SMENU_NAME: wantName = true; break;
		case SMENU_RACE: openScreen(SCR_RACE); break;
		case SMENU_CLASS: openScreen(SCR_CLASS_METHOD); break;
		case SMENU_BIRTH: openScreen(SCR_BIRTH); break;
		case SMENU_REVIEW:
			setXpLeveling(g_xpDefault);      // the last step of making a character: the question starts on the saved default
			openScreen(SCR_REVIEW);
			break;
		case SMENU_REST: openRest(false); break;
		case SMENU_REST_BED: openRest(true); break;
		}
	}

	bool menu = menuOpen() || wantName;
	PlayerInput in = inRaw;
	// Paralyzed: no moving, no fighting
	if (w.effectTotal(45) > 0.0f)
	{
		in.moveX = in.moveY = 0.0f;
		in.jump = in.attack = in.cast = false;
	}
	if (w.forceSneak || testSneak)
		in.sneak = true;
	w.player.waterWalk = w.effectTotal(2) > 0.0f;
	w.player.slowFall = w.effectTotal(11) > 0.0f;
	w.player.levitate = w.effectTotal(10);
	w.player.swimBoost = w.effectTotal(1);
	// Encumbrance: the load (plus Burden, less Feather) against fEncumbranceStrMult x Strength; over it
	// the player can't move, under it the load slows them (fEncumberedMoveEffect)
	{
		float weight = w.effectTotal(7) - w.effectTotal(8);
		for (auto& it : w.inventory)
			if (const Object* o = w.game.object(it.id))
				weight += o->weight * it.count;
		float capacity = w.game.gmstf("fencumbrancestrmult", 5.0f) * w.stats.attributes[ATTR_STRENGTH];
		float load = capacity > 0.0f ? fmaxf(0.0f, weight) / capacity : 0.0f;
		if (g_noWeight)
			load = 0.0f;                 // Cheats > Weightless
		bool over = load > 1.0f;
		if (over && !overEncumbered)
			notify(w.game.gmst("snotifymessage59", "You are carrying too much to move."));
		overEncumbered = over;
		// (OpenMW: over the limit nothing moves, levitating or not)
		w.player.loadSpeed = over ? 0.0f : 1.0f - w.game.gmstf("fencumberedmoveeffect", 0.3f) * fminf(1.0f, load);
		w.player.loadSpeed *= g_cheatSpeed / 100.0f;      // Cheats > Walk speed
		playerLoad = fminf(1.0f, load);
		// Storms (ash, blight, blizzard) blow out from Red Mountain: walking into them is slower,
		// by fStromWalkMult x the angle between the wind and the way the player goes (OpenMW)
		int wx = w.weatherNow;
		if ((wx == 6 || wx == 7 || wx == 9) && w.current >= 0 && !w.cells[w.current].interior
			&& (fabsf(in.moveX) + fabsf(in.moveY)) > 0.1f)
		{
			float sx = w.player.feet[0] - 20480.0f, sy = w.player.feet[1] - 69632.0f;     // from Red Mountain
			float sl = sqrtf(sx * sx + sy * sy);
			float yaw = w.player.yaw, mx = sinf(yaw) * in.moveY + cosf(yaw) * in.moveX,
				my = cosf(yaw) * in.moveY - sinf(yaw) * in.moveX;
			float ml = sqrtf(mx * mx + my * my);
			if (sl > 1.0f && ml > 0.01f)
			{
				float c = fmaxf(-1.0f, fminf(1.0f, (sx * mx + sy * my) / (sl * ml)));
				w.player.loadSpeed *= 1.0f - w.game.gmstf("fstromwalkmult", 0.25f) * (acosf(c) / 3.14159265f);
			}
		}

		// Speed from the stats (OpenMW's reading of Morrowind): walking by the Speed attribute between
		// fMinWalkSpeed and fMaxWalkSpeed, running that times fBaseRunMultiplier plus Athletics; swimming
		// and sneaking fractions of it; the jump by Acrobatics, Jump, the load, running and fatigue
		const PlayerStats& st = w.stats;
		float speedAttr = (float)st.attributes[ATTR_SPEED], athletics = (float)st.skills[8];
		float walk = walkSpeedFor((int)speedAttr);
		float run = runSpeedFor((int)speedAttr, (int)athletics);          // (formulas.cpp)
		w.player.runSpeed = run;
		// Levitating: fMinFlySpeed + 0.01 x (Speed + Levitate) x (fMaxFlySpeed - fMinFlySpeed) (OpenMW's getMaxSpeed)
		w.player.flySpeed = w.game.gmstf("fminflyspeed", 5.0f) + 0.01f * (speedAttr + w.player.levitate)
			* (w.game.gmstf("fmaxflyspeed", 60.0f) - w.game.gmstf("fminflyspeed", 5.0f));
		w.player.swimFactor = (0.01f * athletics * w.game.gmstf("fswimrunathleticsmult", 0.1f)
			+ w.game.gmstf("fswimrunbase", 0.5f));
		w.player.sneakFactor = walk * w.game.gmstf("fsneakspeedmultiplier", 0.75f) / fmaxf(1.0f, run);
		bool running = sqrtf(in.moveX * in.moveX + in.moveY * in.moveY) > 0.75f;      // (full tilt)
		// in the air the pad steers fJumpMoveBase + fJumpMoveMult x Acrobatics / 100 of the run speed, at most all of it
		w.player.airControl = fminf(1.0f, w.game.gmstf("fjumpmovebase", 0.5f) + w.game.gmstf("fjumpmovemult", 0.5f) * st.skills[20] / 100.0f);
		w.player.jumpSpeed = jumpSpeedFor(st.skills[20], w.effectTotal(9), load, running, fatigueTermOf(st.fatigue, st.fatigueMax));
		w.player.jumpSpeed *= g_cheatJump / 100.0f;       // Cheats > Jump power
	}
	if (w.current >= 0 && !w.cells[w.current].interior)
		memcpy(w.lastOutside, w.player.feet, sizeof(w.lastOutside));
	// Invisibility ends when the player attacks or casts
	if ((in.attack || in.cast) && !menu)
		for (size_t i = 0; i < w.effects.size();)
			if (w.effects[i].effect == 39)
				w.effects.erase(w.effects.begin() + i);
			else
				i++;
	if (menu || !w.controlsEnabled)
	{
		in.moveX = in.moveY = 0.0f;
		in.jump = false;
		if (menu)
			in.lookX = in.lookY = in.gyroYaw = in.gyroPitch = 0.0f;
	}
	if (!w.jumpingEnabled)
		in.jump = false;
	if (w.controlsOff & 1u)
		in.lookX = in.lookY = in.gyroYaw = in.gyroPitch = 0.0f;        // DisablePlayerLooking
	{
		bool jumped = in.jump && w.player.onGround && !w.player.flying;
		Scene scene = w.scene();
		profAdd(PROF_OTHER, t);
		playerUpdate(w.player, scene, in, dt);
		profAdd(PROF_PLAYER, t);
		if (jumped)
			useSkill(20, 0);          // Acrobatics
		// Under water: fHoldBreathTime to come up, then fSuffocationDamage a second (Water Breathing: never)
		{
			Cell& here = w.here();
			bool under = w.player.swimming && here.hasWater() && playerEyeZ(w.player) < here.waterZ;
			if (!under || w.effectTotal(0) > 0.0f)
				breath = -1.0f;
			else
			{
				if (breath < 0.0f)
					breath = w.game.gmstf("fholdbreathtime", 20.0f);
				breath -= dt;
				if (breath <= 0.0f)
				{
					breath = 0.0f;
					w.stats.health -= w.game.gmstf("fsuffocationdamage", 3.0f) * dt;
				}
			}
		}
		// A hard landing hurts (OpenMW's reading of Morrowind): past fFallDamageDistanceMin, less with
		// Acrobatics and Jump, and teaches Acrobatics
		if (w.player.landedFall > 0.0f)
		{
			float h = w.player.landedFall;
			w.player.landedFall = 0.0f;
			if (h > 4.0f && !w.player.swimming)
				playSound(-1, "DefaultLand");      // OpenMW: every landing makes this one, a jump's too
			float x = w.player.swimming ? 0.0f : fallDamage(h, w.stats.skills[20], w.effectTotal(9));   // (formulas.cpp)
			if (x > 0.0f)
			{
				float ft = fatigueTermOf(w.stats.fatigue, w.stats.fatigueMax);
				logf("fall: %.0f units, %.1f damage", h, x * (1.0f - 0.25f * ft));
				damagePlayer(x * (1.0f - 0.25f * ft), false);
				// a fall past Acrobatics x fatigue knocks the player down; a softer one trains Acrobatics
				if (x > w.stats.skills[20] * ft)
					w.player.knockTimer = fmaxf(w.player.knockTimer, 2.0f);
				else
					useSkill(20, 1);
			}
		}
		// Athletics: per second spent running (or swimming)
		if (!w.player.flying && (fabsf(in.moveX) + fabsf(in.moveY)) > 0.5f)
			useSkill(8, w.player.swimming ? 1 : 0, dt);
		// Fatigue spent (fFatigue*Base + load x fFatigue*Mult): running at full tilt, swimming, sneaking
		// per second, and each jump
		{
			float tilt = sqrtf(in.moveX * in.moveX + in.moveY * in.moveY);
			const char* kind = nullptr;
			if (w.player.swimming && tilt > 0.2f)
				kind = tilt > 0.75f ? "swimrun" : "swimwalk";
			else if (w.player.sneaking && tilt > 0.2f)
				kind = "sneak";
			else if (tilt > 0.75f && w.player.onGround && !w.player.flying && w.player.levitate <= 0.0f)
				kind = "run";
			if (kind)
			{
				static const float defBase[4] = { 5.0f, 2.5f, 2.0f, 1.5f }, defMult[4] = { 2.0f, 4.0f, 1.5f, 2.0f };
				int k = !strcmp(kind, "run") ? 0 : !strcmp(kind, "swimrun") ? 1 : !strcmp(kind, "sneak") ? 2 : 3;
				float cost = w.game.gmstf((std::string("ffatigue") + kind + "base").c_str(), defBase[k])
					+ playerLoad * w.game.gmstf((std::string("ffatigue") + kind + "mult").c_str(), defMult[k]);
				w.stats.fatigue = fmaxf(0.0f, w.stats.fatigue - cost * dt);
			}
			if (w.player.jumpedNow)
				w.stats.fatigue = fmaxf(0.0f, w.stats.fatigue - (w.game.gmstf("ffatiguejumpbase", 5.0f)
					+ playerLoad * w.game.gmstf("ffatiguejumpmult", 0.0f)));
			w.player.jumpedNow = false;
		}
	}

	// The converted land ends at the walkable bounds
	Cell& here = w.here();
	if (here.bounded() && !w.player.flying)
	{
		const float margin = 64.0f;
		float* f = w.player.feet;
		float cx = fmaxf(here.bounds[0] + margin, fminf(f[0], here.bounds[2] - margin));
		float cy = fmaxf(here.bounds[1] + margin, fminf(f[1], here.bounds[3] - margin));
		if (cx != f[0] || cy != f[1])
		{
			f[0] = cx;
			f[1] = cy;
			if (w.time > boundsNoteUntil)
			{
				notify("The land beyond here is not converted yet.");
				boundsNoteUntil = w.time + 8.0f;
			}
		}
	}
	// Outdoors: follow the player into other grid cells, loading one missing neighbour per frame
	profAdd(PROF_OTHER, t);
	w.streamExterior(false);
	w.retryMissingTextures(dt);
	profAdd(PROF_STREAM, t);

	float eye[3] = { w.player.feet[0], w.player.feet[1], playerEyeZ(w.player) };
	float cp = cosf(w.player.pitch);
	float dir[3] = { sinf(w.player.yaw) * cp, cosf(w.player.yaw) * cp, sinf(w.player.pitch) };
	memcpy(listener, eye, sizeof(eye));
	listener[3] = w.player.yaw;

	// Telekinesis reaches farther (magnitude in feet, 22 units each)
	target = menu ? -1 : worldPick(w, eye, dir, kReach + w.effectTotal(59) * 22.0f);
	if (!menu && in.activate)
	{
		if (target >= 0 && w.controlsEnabled)
			playerActivate(target);
	}

	profAdd(PROF_OTHER, t);
	MARK("combat");
	combatUpdate(in, dt, menu);
	if ((mpMode == 1 || mpMode == 2) && net.isConnected())   // MPCELL: also with a menu open (dialogue froze the NPC feed)
		worldSyncUpdate(dt);
	profAdd(PROF_AI, t);
	viewModelUpdate(in, dt);
	MARK("gravity");
	actorGravity(dt);
	MARK("effects");
	updateEffects(dt);
	rechargeItems(dt);
	castUpdate(dt);
	// (a cast, like a blow, plays out before the next: OpenMW has one spellcast animation at a time)
	if (in.cast && !menu && w.controlsEnabled && !playerDead && w.magicEnabled && vm.action != VM_CAST && vm.action != VM_FOLLOW
		&& !castBusy())
		castSpell();
	if (in.quick >= 0 && !menu && w.controlsEnabled && !playerDead)
		useQuickKey(in.quick);
	profAdd(PROF_OTHER, t);
	MARK("scripts");
	scriptsRun(w, *this, dt);
	profAdd(PROF_SCRIPTS, t);
	if (!menuOpen())
	{
		MARK("monitors");
		monitorActors(dt);
		MARK("greetings");
		greetings(dt);
	}

	// Mouths follow the loudness of what each actor is saying (a flap if there's no audio)
	for (LoadedCell* l : w.loaded)
	for (auto& a : l->actors.actors)
	{
		if (a.ref < 0)
			continue;                        // detached (World::detachActor): not drawn, nobody's mouth
		Ref& r = w.refs[a.ref];
		float level = 0.0f;
		if (r.voiceChannel >= 0 && !audioPlaying(r.voiceChannel))
			r.voiceChannel = -1;             // (a finished line's channel goes to other sounds: stopping it later would cut them)
		if (r.voiceChannel >= 0)
			level = audioLoudness(r.voiceChannel);
		else if (!sayDone(a.ref))
			level = 0.2f + 0.15f * sinf(w.time * 14.0f);
		a.talkLevel += (level - a.talkLevel) * fminf(1.0f, dt * 20.0f);
	}

	// Footsteps while walking; OpenMW's Npc::getSoundIdFromSndGen picks the sound: none flying, "Swim" while
	// swimming, "FootWater" with the feet under the surface, else the ground's
	float moving = fabsf(in.moveX) + fabsf(in.moveY);
	bool wading = false;
	if (w.current >= 0)
	{
		Cell& stepCell = w.here();
		wading = stepCell.hasWater() && w.player.feet[2] < stepCell.waterZ;
	}
	if (g_footsteps && !menu && !w.player.flying && (w.player.swimming || w.player.onGround) && moving > 0.2f)
	{
		stepTimer -= dt;
		if (stepTimer <= 0.0f)
		{
			const char* side = stepLeft ? "Left" : "Right";
			playSound(-1, std::string(w.player.swimming ? "Swim " : wading ? "FootWater" : "FootBare") + side);
			stepLeft = !stepLeft;
			stepTimer = w.player.swimming ? 0.65f : 0.42f;
		}
	}
	else
		stepTimer = 0.1f;

	updateAmbience();
	updateLoopSounds();
	updateWeatherEffects(dt);
	// Cheats: god mode keeps health full, infinite magicka and fatigue keep those full
	if (g_godMode)
		w.stats.health = w.stats.healthMax;
	if (g_infMagic)
	{
		w.stats.magicka = w.stats.magickaMax;
		w.stats.fatigue = w.stats.fatigueMax;
	}
	// Interface > Autosave: every N minutes of play in the open (menus, loading and name entry do not count)
	{
		static float autoTimer = 0.0f;
		if (g_autosaveMin > 0 && !autotest && !wantName)
		{
			if (!menuOpen() && travelCell < 0)
				autoTimer += dt;
			if (autoTimer >= g_autosaveMin * 60.0f)
			{
				autoTimer = 0.0f;
				notify(save() ? "Autosaved." : "Autosave failed.");
			}
		}
		else
			autoTimer = 0.0f;
	}
	updateMusic(dt);
	updateSky();
	// The region's ambient sounds outdoors in fair weather (Morrowind.ini: 1 to 5 s between; each by its chance)
	if (w.current >= 0 && !w.cells[w.current].interior && w.weatherNow <= 3 && (ambientTimer -= dt) <= 0.0f)
	{
		ambientTimer = 1.0f + (rand() % 400) / 100.0f;
		auto rg = w.game.regions.find(w.cells[w.current].region);
		if (rg != w.game.regions.end() && !rg->second.ambient.empty())
		{
			int total = 0;
			for (auto& a : rg->second.ambient)
				total += a.second;
			int roll = rand() % 100;
			if (roll < total)
				for (auto& a : rg->second.ambient)
				{
					if (roll < a.second)
					{
						playSound(-1, a.first);
						break;
					}
					roll -= a.second;
				}
		}
	}
	// A held light burns down (OpenMW's updateEquippedLight): its time left (the stack's charge; -1 a fresh one) less the
	// frame's; one that burns out is gone, and the next of the stack is lit
	for (size_t i = 0; i < w.inventory.size(); i++)
	{
		InventoryItem& it = w.inventory[i];
		const Object* o = it.equipped ? w.game.object(it.id) : nullptr;
		if (!o || o->type != "LIGH" || o->lightTime <= 0.0f)
			continue;
		float left = (it.charge < 0.0f ? o->lightTime : it.charge) - dt;
		if (left > 0.0f)
		{
			it.charge = left;
			break;
		}
		logf("light: %s burned out", it.id.c_str());
		it.charge = -1.0f;
		if (--it.count <= 0)
			w.inventory.erase(w.inventory.begin() + i);
		break;
	}
	{
		// A carried light lights the way (the equipped one, held at the hand)
		float radius = 0.0f, rgb[3] = { 0, 0, 0 };
		for (auto& it : w.inventory)
			if (it.equipped)
				if (const Object* o = w.game.object(it.id))
					if (o->type == "LIGH" && o->lightRadius > 0)
					{
						radius = (float)o->lightRadius;
						for (int k = 0; k < 3; k++)
							rgb[k] = o->lightColor[k] / 255.0f * 0.8f;
						break;
					}
		float at[3] = { w.player.feet[0] + sinf(w.player.yaw) * 20.0f, w.player.feet[1] + cosf(w.player.yaw) * 20.0f,
			w.player.feet[2] + 100.0f };
		rendererSetCarriedLight(at, radius, rgb);
	}
	{
		// People holding a torch out light their surroundings as the player's does (Morrowind and OpenMW light the
		// world with a carried light's own radius and colour): the nearest kActorLights of them to the player, the
		// light at the left hand. The light is the first carryable one they have (the torch their model holds)
		struct Held { float d; float pos[3]; float radius; float rgb[3]; };
		Held best[kActorLights];
		int n = 0;
		w.forLoadedActors([&](int i) {
			const Ref& r = w.refs[i];
			const Actor* a = r.dead || !r.visible() ? nullptr : w.actorOf(i);
			if (!a || !a->torchOut)
				return;
			bool holds = false;
			for (const ActorMesh& m : a->meshes)
				holds |= m.hand == 1;
			float d = holds ? w.distanceToPlayer(i) : 1e9f;
			if (d > 4000.0f || (n == kActorLights && d >= best[n - 1].d))
				return;
			const Object* npc = w.game.object(r.id);
			const Object* light = nullptr;
			for (size_t k = 0; npc && !light && k < npc->items.size(); k++)
				if (const Object* o = w.game.object(npc->items[k].second))
					if (o->type == "LIGH" && o->lightRadius > 0 && (o->flags & 2))     // (LHDT 0x2: can be carried)
						light = o;
			if (!light)
				return;
			Held h;
			h.d = d;
			float fx = sinf(r.rot[2]), fy = cosf(r.rot[2]);
			h.pos[0] = r.pos[0] + fx * 20.0f - fy * 20.0f;
			h.pos[1] = r.pos[1] + fy * 20.0f + fx * 20.0f;
			h.pos[2] = r.pos[2] + 100.0f;
			h.radius = (float)light->lightRadius;
			for (int k = 0; k < 3; k++)
				h.rgb[k] = light->lightColor[k] / 255.0f * 0.8f;
			int at = n < kActorLights ? n++ : n - 1;
			while (at > 0 && best[at - 1].d > d)
			{
				best[at] = best[at - 1];
				at--;
			}
			best[at] = h;
		});
		float pos[kActorLights][3], radius[kActorLights], rgb[kActorLights][3];
		for (int k = 0; k < n; k++)
		{
			memcpy(pos[k], best[k].pos, sizeof(pos[k]));
			radius[k] = best[k].radius;
			memcpy(rgb[k], best[k].rgb, sizeof(rgb[k]));
		}
		heldLights = n;
		rendererSetActorLights(n, pos, radius, rgb);
	}
	// spell visuals age and go
	// A hit visual is attached to its target's own node (OpenMW: Animation::addEffect), so it goes where the target goes
	for (size_t i = 0; i < vfx.size();)
		if ((vfx[i].age += dt) >= vfx[i].life)
			vfx.erase(vfx.begin() + i);
		else
		{
			if (vfx[i].follow == -1)
			{
				memcpy(vfx[i].pos, w.player.feet, sizeof(vfx[i].pos));
				vfx[i].yaw = w.player.yaw;
			}
			else if (vfx[i].follow >= 0 && vfx[i].follow < (int)w.refs.size())
			{
				memcpy(vfx[i].pos, w.refs[vfx[i].follow].pos, sizeof(vfx[i].pos));
				vfx[i].yaw = w.refs[vfx[i].follow].rot[2];
			}
			i++;
		}
	if (!playerDead && w.stats.health <= 0.0f)
		playerDies();
	// fades back to clear after travel; scripts can hold it (FadeOut) or bring it back slowly (FadeIn)
	if (fade > fadeTarget)
		fade = fmaxf(fadeTarget, fade - dt * fadeRate);
	else if (fade < fadeTarget)
		fade = fminf(fadeTarget, fade + dt * fadeRate);
	if (fade == fadeTarget && fadeTarget == 0.0f)
		fadeRate = 2.5f;
	for (size_t i = 0; i < notes.size();)
		if (w.time > notes[i].until)
			notes.erase(notes.begin() + i);
		else
			i++;
	audioUpdate();
}

// ---- Activation

void Session::playerActivate(int ref)
{
	Ref& r = w.refs[ref];
	// Scripts that test OnActivate take over; they call Activate for the default action. One that stopped asking
	// (a door script that finished, like the Census office's exit) lets the activation through (OpenMW)
	if (r.script >= 0 && w.scripts[r.script].script->usesOnActivate && w.scripts[r.script].suppress)
	{
		w.scripts[r.script].activated = true;
		w.scripts[r.script].buffered = true;
		return;
	}
	activate(ref);
}

// A werewolf can't use things (OpenMW's sWerewolfRefusal)
bool Session::werewolfRefused()
{
	if (!werewolf)
		return false;
	notify(w.game.gmst("swerewolfrefusal", "You cannot use items while in werewolf form."));
	return true;
}

// Reading a book from the pack in a fight is refused (a book on the ground may still be read)
bool Session::readRefused()
{
	if (!enemiesNear())
		return false;
	notify(w.game.gmst("sinventorymessage4", "You cannot read during battle."));
	return true;
}

// ShowRestMenu on a bed (OpenMW's sleepInBed): a werewolf and enemies nearby are refused; an owned bed is a trespass, and
// when someone saw it and reports it the sleep is refused too
bool Session::bedRefused(int bed)
{
	if (werewolf)
	{
		notify(w.game.gmst("swerewolfrefusal", "You cannot use items while in werewolf form."));
		return true;
	}
	if (enemiesNear())
	{
		notify(w.game.gmst("snotifymessage2", "You can't rest here enemies are nearby."));
		return true;
	}
	if (!w.ownedByOther(bed))
		return false;
	int witness = crimeWitness();
	if (witness < 0)
		return false;
	crimeSeen(CRIME_TRESPASS, 0, -1);
	reportCrime(witness, crimeBounty(CRIME_TRESPASS, 0));
	notify(w.game.gmst("snotifymessage64", "You can't sleep in someone else's bed!"));
	return true;
}

void Session::activate(int ref)
{
	Ref& r = w.refs[ref];
	if (!r.visible())
		return;
	// A werewolf is refused by everything but doors (OpenMW's getWerewolfRefusalAction)
	if (r.type != "DOOR" && werewolfRefused())
		return;
	// (a light that can't be carried is part of the scenery: nothing happens)
	if (r.type == "LIGH" && r.obj && !(r.obj->flags & 2))
		return;
	if ((r.type == "NPC_" || r.type == "CREA") && r.dead)
	{
		// Search the body
		containerRef = ref;
		openScreen(SCR_CONTAINER);
		return;
	}
	// Creatures that trade or have words of their own are talked to like people (Creeper, the mudcrab
	// merchant, Vivec, Yagrum Bagarn); other living creatures do nothing
	// (one that is only running away still is: OpenMW bug 7631, Creeper and the mudcrab merchant hit and fleeing)
	bool talkingCreature = r.type == "CREA" && r.actor >= 0 && (r.ai != AI_COMBAT || r.fleeing)
		&& ((w.game.actors[r.actor].services & 0x3FFFF) || w.game.speakers.count(r.idLower));
	if (r.type == "CREA" && !r.dead)
		logf("activate: creature %s: services %x, speaker %d, ai %d -> %s", r.idLower.c_str(),
			r.actor >= 0 ? w.game.actors[r.actor].services : 0, (int)w.game.speakers.count(r.idLower), r.ai,
			talkingCreature ? "talk" : "nothing");
	if (r.type == "NPC_" && r.ai == AI_COMBAT && !isCompanionRef(ref))
	{
		notify(w.game.gmst("sactorincombat", "This character is in combat."));
		return;
	}
	if (r.type == "CREA" && !talkingCreature)
		return;
	// Knocked down (not fighting): their pockets are open to anyone, no roll against them. Sneaking up on someone: their
	// pockets, with the pickpocket rolls (OpenMW checks both before talking)
	if (r.type == "NPC_" && r.knockTimer > 0.0f && w.actorEffect(ref, 45) <= 0.0f)
	{
		containerRef = ref;
		pickpocketing = false;
		openScreen(SCR_CONTAINER);
		return;
	}
	if (r.type == "NPC_" && w.player.sneaking && !r.ally)
	{
		containerRef = ref;
		pickpocketing = true;
		openScreen(SCR_CONTAINER);
		return;
	}
	if (r.type == "NPC_" || talkingCreature)
	{
		// Face the speaker's head while talking
		float dx = r.pos[0] - w.player.feet[0], dy = r.pos[1] - w.player.feet[1];
		float dz = r.pos[2] + 115.0f - (w.player.feet[2] + PLAYER_EYE_HEIGHT);
		w.player.yaw = atan2f(dx, dy);
		w.player.pitch = atan2f(dz, fmaxf(1.0f, sqrtf(dx * dx + dy * dy)));
		// Permanent companion: order menu (also when Stay back — he is not following then)
		// (matched by id as well: the ref number can move when cells reload, and then he would greet like any guard)
		if (isCompanionRef(ref))
		{
			if (ref != companionRef)
			{
				logf("companion: ref moved %d -> %d, restored", companionRef, ref);
				companionRef = ref;
			}
			if (r.ai == AI_COMBAT)
			{
				r.ai = AI_IDLE;               // (a companion is never in a fight with us)
				r.aggressor = false;
			}
			openScreen(SCR_COMPANION_ORDERS);
			return;
		}
		// With no greeting that fits there is no conversation (OpenMW)
		if (dialogueStart(dlg, w, *this, ref))
		{
			wordsRevision = -1;
			openScreen(SCR_DIALOGUE);
		}
		return;
	}
	if (r.type == "DOOR")
	{
		useDoor(ref);
		return;
	}
	if (r.type == "CONT")
	{
		if (lockGate(ref, "LockedChest") != 2)
			return;
		// Direct harvesting: organic containers (plants, mushrooms, ore nodes)
		// do not open the container screen. Their contents go straight into
		// the inventory and the plant is hidden (vanilla Morrowind behaviour).
		if (r.obj && r.obj->organic)
		{
			// (a plant's leveled list can roll "nothing": Draggle-Tail, Luminous Russula etc. are empty some of the time)
			if (!harvestOrganic(ref) && r.visible() && r.contents.empty())
				notify("There is nothing to harvest here.");
			return;
		}
		containerRef = ref;
		openScreen(SCR_CONTAINER);
		// plants and other organic containers open without a chest's creak
		if (!r.obj || !r.obj->organic)
			playSound(ref, "chest open");
		return;
	}
	if (r.type == "BOOK")
	{
		openScreen(SCR_BOOK);
		bookRef = ref;
		playSound(-1, r.obj && r.obj->scroll ? "scroll" : "Book Open");
		return;
	}
	if (r.type == "ACTI" || r.type == "STAT")
		return;
	pickUp(ref);
}

// Harvest a plant / mushroom / ore node in place: no container screen. The
// contents go to the inventory (with theft handling for owned plants), the
// plant is hidden, and the item-up sound plays. Returns true if anything was
// taken.
bool Session::harvestOrganic(int ref)
{
	Ref& r = w.refs[ref];
	if (!r.visible() || r.contents.empty())
		return false;

	// Theft: owned plants go through the same crime system as containers.
	bool owned = w.ownedByOther(ref);
	int witness = -1;
	if (owned)
	{
		witness = crimeWitness();
		if (witness >= 0 && !r.contents.empty())
			takeOwned(ref, r.contents[0].second, stockCount(r.contents[0].first));
	}

	// Move every stack into the inventory (takeStack keeps wear / soul / charge).
	int taken = 0;
	for (auto& c : r.contents)
	{
		if (c.first == 0)
			continue;
		w.takeStack(c, stockCount(c.first));
		taken++;
	}
	r.contents.clear();

	// The plant vanishes (vanilla behaviour): hidden and marked taken. (Not w.pickUp(): that adds the plant's own
	// id to the inventory, a weightless nameless-icon "Luminous Russula" next to the real one.)
	w.hideTaken(ref);

	// Harvest sound: organic "chest open" has no creak; use item-up.
	playSound(-1, "Item Misc Up");

	if (owned && witness >= 0)
		crimeSeen(CRIME_THEFT, 1, -1), reportCrime(-1, crimeBounty(CRIME_THEFT, 1));

	logf("harvest: %s at %.0f %.0f %.0f: %d stacks taken%s", r.id.c_str(), r.pos[0], r.pos[1], r.pos[2],
		taken, owned ? (witness >= 0 ? " (seen)" : " (unseen)") : "");
	return true;
}

void Session::pickUp(int ref)
{
	Ref& r = w.refs[ref];
	const std::string& t = r.type;
	const char* sound = "Item Misc Up";
	if (t == "BOOK") sound = "Item Book Up";
	else if (t == "ALCH") sound = "Item Potion Up";
	else if (t == "INGR") sound = "Item Ingredient Up";
	else if (t == "WEAP") sound = "Item Weapon Shortblade Up";
	else if (t == "CLOT") sound = "Item Clothes Up";
	else if (t == "ARMO") sound = "Item Armor Medium Up";
	else if (t == "LOCK") sound = "Item Lockpick Up";
	else if (t == "PROB") sound = "Item Probe Up";
	else if (t == "REPA") sound = "Item Repair Up";
	else if (t == "APPA") sound = "Item Apparatus Up";
	else if (r.idLower.rfind("gold_", 0) == 0) sound = "Item Gold Up";
	playSound(-1, sound);
	if (w.ownedByOther(ref))
		takeOwned(ref, r.id, r.count > 0 ? r.count : 1);
	w.pickUp(ref);
	/* MPITEMS_HOOK_PICKUP: tell peers */
	if ((mpMode == 1 || mpMode == 2) && net.isConnected())
		mpBroadcastItemTaken(ref);
}

// The lock and the trap of a door or container, as OpenMW's Door::activate / Container::activate: the key (carried by the
// player) unlocks it, says so, and disarms a trap; with no key a locked one only gives its sound; an unlocked trapped one
// fires its trap instead of opening
int Session::lockGate(int ref, const char* lockedSound)
{
	Ref& r = w.refs[ref];
	bool locked = r.lockLevel > 0, trapped = !r.trap.empty() && !r.disarmed;
	bool key = !r.key.empty() && w.itemCount(lower(r.key)) > 0;
	if (locked && key)
	{
		const Object* k = w.game.object(r.key);
		notify((k ? k->name.str() : r.key.str()) + " " + w.game.gmst("skeyused", "was used to open the lock."));
		r.lockLevel = -r.lockLevel;       // (the level is kept for Lock)
		logf("lock: %s opened with %s", r.id.c_str(), r.key.c_str());
		if (trapped)
		{
			r.disarmed = true;            // the key disarms it too
			trapped = false;
			playSound(ref, "Disarm Trap");
		}
	}
	else if (locked)
	{
		playSound(ref, lockedSound);
		return 0;
	}
	if (trapped)
	{
		springTrap(ref);
		return 1;
	}
	return 2;
}

void Session::useDoor(int ref)
{
	Ref& r = w.refs[ref];
	if (lockGate(ref, "LockedDoor") != 2)
		return;
	if (r.hasDest)
	{
		int dest = r.destUnconverted ? -1 : r.destHasGrid ? w.gridCell(r.destGrid[0], r.destGrid[1]) : w.cellIndex(r.destCell);
		if (dest < 0 && !r.destEnd)
		{
			notify(r.destCell + " is not converted yet.");
			return;
		}
		if (r.obj && !r.obj->openSound.empty())
			playSound(-1, r.obj->openSound);
		if (r.destEnd)
		{
			ended = true;
			openScreen(SCR_END);
			return;
		}
		if (dest == w.current)
		{
			// Followers within 800 come along to elsewhere in the same cell too (OpenMW's ActionTeleport, every
			// teleport door: Rabinna up the trapdoor of Fatleg's Drop Off), by the rule of a door to another cell
			std::vector<int> followers;
			for (int i : w.loadedActors)
				if (w.followsPlayer(i) && w.refs[i].aiPackage != AIPKG_ESCORT)
				{
					Ref& f = w.refs[i];
					float* stay = f.script >= 0 ? w.scripts[f.script].local("stayoutside") : nullptr;
					float dx = f.pos[0] - w.player.feet[0], dy = f.pos[1] - w.player.feet[1], dz = f.pos[2] - w.player.feet[2];
					if (!followerTaken(dx * dx + dy * dy + dz * dz, stay && *stay == 1.0f, !w.cells[w.placeOf(i)].interior,
						!w.cells[dest].interior))
						continue;
					if (f.ai == AI_COMBAT)
					{
						f.ai = AI_IDLE;
						continue;
					}
					followers.push_back(i);
				}
			memcpy(w.player.feet, r.destPos, sizeof(r.destPos));
			w.player.yaw = r.destRot[2];
			w.player.pitch = 0.0f;
			w.player.vz = 0.0f;
			w.player.fallTop = w.player.feet[2];   // a door isn't a fall
			w.player.landedFall = 0.0f;
			w.player.inertia[0] = w.player.inertia[1] = 0.0f;
			for (size_t k = 0; k < followers.size(); k++)
			{
				// just ahead of the player, side by side, as a door to another cell sets them down
				float back = -72.0f, side = ((int)k - (int)followers.size() / 2) * 64.0f + (k % 2 ? 40.0f : -40.0f);
				float fx = sinf(w.player.yaw), fy = cosf(w.player.yaw);
				float pos[3] = { w.player.feet[0] - fx * back + fy * side, w.player.feet[1] - fy * back - fx * side,
					w.player.feet[2] };
				w.relocate(followers[k], w.placeOf(followers[k]), pos, w.player.yaw);
			}
			fade = 1.0f;
		}
		else
		{
			travelCell = dest;
			memcpy(travelPos, r.destPos, sizeof(travelPos));
			travelYaw = r.destRot[2];
		}
		return;
	}
	bool opening = r.doorTarget == 0.0f;
	r.doorTarget = opening ? 1.5708f : 0.0f;
	if (r.obj)
		playSound(ref, opening ? r.obj->openSound : r.obj->closeSound);
}

std::string Session::targetLabel(int ref)
{
	Ref& r = w.refs[ref];
	std::string name = r.obj ? r.obj->name.str() : r.id.str();
	if (r.actor >= 0)
		name = w.game.actors[r.actor].name + (r.dead ? " (dead)" : "");
	if (r.type == "DOOR" && r.hasDest && lower(r.destCell) != lower(w.cellName()))
		name += " - " + r.destCell;
	if (r.lockLevel > 0)
		name += " - Locked";
	if (r.count > 1)
		name += " (" + std::to_string(r.count) + ")";
	return name;
}

// ---- Sound

void Session::mix3d(const float* pos, float& volume, float& pan, float minDist, float maxDist)
{
	float dx = pos[0] - listener[0], dy = pos[1] - listener[1], dz = pos[2] - listener[2];
	float dist = sqrtf(dx * dx + dy * dy + dz * dz);
	float att = dist <= minDist ? 1.0f : fmaxf(0.0f, 1.0f - (dist - minDist) / fmaxf(1.0f, maxDist - minDist));
	volume *= att;
	float rel = atan2f(dx, dy) - listener[3];
	pan = dist > 1.0f ? sinf(rel) * 0.8f : 0.0f;
}

void Session::playSound(int ref, const std::string& soundId, float volume, float pitch, bool script)
{
	auto it = w.game.sounds.find(lower(soundId));
	if (it == w.game.sounds.end())
		return;
	volume *= it->second.volume;
	float pan = 0.0f;
	if (ref >= 0)
	{
		float pos[3] = { w.refs[ref].pos[0], w.refs[ref].pos[1], w.refs[ref].pos[2] + 50.0f };
		mix3d(pos, volume, pan, it->second.minRange * 20.0f, fmaxf(it->second.maxRange * 20.0f, 600.0f));
	}
	if (volume > 0.01f)
	{
		int ch = audioPlay(it->second.file, volume, pan, false, pitch);
		// A script's sound on a reference is "playing" till it ends
		if (script && ref >= 0 && ch >= 0 && scriptSounds.size() < 16)
			scriptSounds.push_back({ ref, lower(soundId), w.time + audioDuration(it->second.file) / fmaxf(pitch, 0.1f) });
	}
}

void Session::loopSound(int ref, const std::string& soundId, bool start, float volume, float pitch)
{
	std::string id = lower(soundId);
	for (size_t k = 0; k < loopSounds.size(); k++)
		if (loopSounds[k].ref == ref && loopSounds[k].id == id)
		{
			if (start)
				return;                            // already looping
			audioStop(loopSounds[k].channel);
			loopSounds.erase(loopSounds.begin() + k);
			return;
		}
	if (!start || ref < 0)
		return;
	auto it = w.game.sounds.find(id);
	if (it == w.game.sounds.end())
		return;
	// (no channel yet: updateLoopSounds gives it one while it can be heard)
	loopSounds.push_back({ ref, id, -1, volume, pitch });
	updateLoopSounds();
}

bool Session::soundPlaying(int ref, const std::string& soundId)
{
	std::string id = lower(soundId);
	for (auto& l : loopSounds)
		if (l.ref == ref && l.id == id)
			return true;
	for (size_t k = 0; k < scriptSounds.size();)
		if (w.time >= scriptSounds[k].until)
			scriptSounds.erase(scriptSounds.begin() + k);
		else if (scriptSounds[k].ref == ref && scriptSounds[k].id == id)
			return true;
		else
			k++;
	return false;
}

// A loop holds a sound channel only while it can be heard, and only the loudest few do: a town's fires or a
// Dwemer ruin's steam and machinery are dozens of loops, which at a channel each (silent or not) used up all
// of them and left every other sound without one
void Session::updateLoopSounds()
{
	static const size_t kMaxLoops = 12;
	for (size_t k = 0; k < loopSounds.size();)
	{
		LoopSound& l = loopSounds[k];
		if (!w.active(l.ref) || !w.refs[l.ref].visible())
		{
			audioStop(l.channel);
			loopSounds.erase(loopSounds.begin() + k);
			continue;
		}
		k++;
	}
	static std::vector<float> vols, pans, order;
	vols.assign(loopSounds.size(), 0.0f);
	pans.assign(loopSounds.size(), 0.0f);
	for (size_t k = 0; k < loopSounds.size(); k++)
	{
		LoopSound& l = loopSounds[k];
		auto it = w.game.sounds.find(l.id);
		float volume = (it != w.game.sounds.end() ? it->second.volume : 1.0f) * l.volume;
		float pos[3] = { w.refs[l.ref].pos[0], w.refs[l.ref].pos[1], w.refs[l.ref].pos[2] + 50.0f };
		if (it != w.game.sounds.end())
			mix3d(pos, volume, pans[k], it->second.minRange * 20.0f, fmaxf(it->second.maxRange * 20.0f, 600.0f));
		vols[k] = volume;
	}
	order = vols;
	float floorVol = 0.01f;
	if (order.size() > kMaxLoops)
	{
		std::sort(order.begin(), order.end(), std::greater<float>());
		floorVol = fmaxf(floorVol, order[kMaxLoops - 1]);
	}
	for (size_t k = 0; k < loopSounds.size(); k++)
	{
		LoopSound& l = loopSounds[k];
		bool want = vols[k] >= floorVol && vols[k] > 0.01f;
		if (l.channel >= 0 && !audioPlaying(l.channel))
			l.channel = -1;
		if (!want)
		{
			audioStop(l.channel);
			l.channel = -1;
		}
		else if (l.channel < 0)
		{
			auto it = w.game.sounds.find(l.id);
			if (it != w.game.sounds.end())
				l.channel = audioPlay(it->second.file, vols[k], pans[k], true, l.pitch);
		}
		else
			audioSetMix(l.channel, vols[k], pans[k]);
	}
}

// The weather's ambient loop outdoors (the one it's changing to past halfway), thunder in storms
C3D_Tex* Session::skyTex(const std::string& name)
{
	if (name.empty())
		return nullptr;
	auto it = skyTextures.find(name);
	if (it != skyTextures.end())
		return it->second;
	return skyTextures[name] = w.textures.acquire(w.dataDir, name);
}

// Where the sun and the moons are (OpenMW's reading of Morrowind's sky): the sun rises in the east at
// Sunrise Time and sets in the west at Sunset Time; each moon rises Daily Increment hours later every
// day (from 16 Last Seed), turns 15 x Speed degrees an hour across the sky tilted by Axis Offset, and
// goes through its 8 phases 3 days each, full on the first day; they fade in and out by the hour.
// Clouds, rain and storms hide them.
void Session::updateSky()
{
	g_skyBillboards.clear();
	g_starAlpha = 0.0f;
	if (w.current < 0 || w.cells[w.current].interior)
		return;
	const SkyBodiesDef& sky = w.game.skyBodies;
	GameDate d = w.date();
	float h = d.hour;
	float clear = w.weatherNow <= 1 ? 1.0f : w.weatherNow <= 3 ? 0.35f : 0.1f;   // clear / cloudy, foggy / overcast, worse
	auto toDir = [](float angleDeg, float tiltDeg, float out[3]) {
		float a = angleDeg * 0.0174533f, t = tiltDeg * 0.0174533f;
		out[0] = cosf(a);
		out[1] = -sinf(a) * sinf(t);
		out[2] = sinf(a) * cosf(t);
	};
	// the sun
	float st = (h - sky.sunrise) / fmaxf(1.0f, sky.sunset - sky.sunrise);
	if (st > -0.05f && st < 1.05f)
	{
		SkyBillboard sun = {};
		toDir(st * 180.0f, 30.0f, sun.dir);
		sun.size = 150.0f;
		sun.tex = skyTex(sky.sun);
		float edge = fminf(1.0f, fminf(st + 0.05f, 1.05f - st) * 8.0f);
		u8 a = (u8)(255 * clear * fmaxf(0.0f, edge));
		sun.rgba = 0x00FFFFFF | ((u32)a << 24);
		g_skyBillboards.push_back(sun);
		SkyBillboard glare = sun;
		glare.size = 420.0f;
		glare.tex = skyTex(sky.glare);
		glare.additive = true;
		glare.rgba = ((u32)(a * 0.45f) << 24) | 0x2F5FDE;     // Sun Glare Fader Color 222, 95, 39 (as ABGR)
		g_skyBillboards.push_back(glare);
	}
	// the moons
	for (int m = 0; m < 2; m++)
	{
		const MoonDef& md = sky.moons[m];
		auto riseHour = [&](int days) { return md.dailyIncrement + fmodf((days - 1 + 16) * md.dailyIncrement, 24.0f); };
		auto rotation = [&](float hours) { return 15.0f * md.speed * hours; };
		int day = d.daysPassed;
		float riseToday = riseHour(day), angle = 0.0f;
		if (h < riseToday)
		{
			float riseYesterday = riseHour(day - 1);
			if (riseYesterday < 24.0f)
				angle = rotation(h + 24.0f - riseYesterday);
		}
		else
			angle = rotation(h - riseToday);
		if (angle <= 0.0f || angle >= 180.0f)
			continue;
		int phase = h < riseToday ? (day / 3) % 8 : ((day + 1) / 3) % 8;
		float alpha = 0.0f;
		if (h >= md.fadeInFinish || h <= md.fadeOutStart)
			alpha = 1.0f;
		else if (h > md.fadeInStart && h < md.fadeInFinish)
			alpha = (h - md.fadeInStart) / fmaxf(0.01f, md.fadeInFinish - md.fadeInStart);
		else if (h > md.fadeOutStart && h < md.fadeOutFinish)
			alpha = 1.0f - (h - md.fadeOutStart) / fmaxf(0.01f, md.fadeOutFinish - md.fadeOutStart);
		alpha *= clear * fminf(1.0f, fminf(angle, 180.0f - angle) / 8.0f);
		if (alpha <= 0.01f)
			continue;
		SkyBillboard mb = {};
		toDir(angle, md.axisOffset, mb.dir);
		mb.size = md.size * 2.2f;
		mb.tex = skyTex(m == 0 ? sky.masser[phase] : sky.secunda[phase]);
		mb.rgba = 0x00FFFFFF | ((u32)(alpha * 255) << 24);
		g_skyBillboards.push_back(mb);
	}
	// the stars: from an hour after sunset to two before sunrise, fading over two hours
	float night = 0.0f;
	float startH = sky.sunset + 1.0f, endH = sky.sunrise - 2.0f;
	if (h >= startH)
		night = fminf(1.0f, (h - startH) / 2.0f);
	else if (h <= endH)
		night = 1.0f;
	else if (h < endH + 2.0f)
		night = 1.0f - (h - endH) / 2.0f;
	g_starAlpha = night * clear;
	g_starTexture = skyTex(sky.stars);
}

void Session::updateWeatherEffects(float dt)
{
	// Graphics > Weather: Off keeps the sky clear (no rain, ash, storm loops or thunder)
	if (g_weatherOff)
	{
		w.weatherNow = 0;
		w.weatherNext = 0;
		w.weatherBlend = 1.0f;
	}
	bool outside = w.current >= 0 && !w.cells[w.current].interior && !w.game.weatherTypes.empty();
	int wt = w.weatherShown();       // (OpenMW: the old weather's loops until the new one's rain threshold)
	std::string want;
	if (outside && wt < (int)w.game.weatherTypes.size())
	{
		want = w.game.weatherTypes[wt].sound;
		if (!want.empty() && !w.game.sounds.count(want))
			want = w.game.sounds.count("ashstorm") && (wt == WEATHER_BLIGHT || wt == WEATHER_ASH) ? "ashstorm" : "";
	}
	if (want != weatherSound || (weatherChannel >= 0 && !audioPlaying(weatherChannel)))
	{
		if (weatherChannel >= 0)
			audioStop(weatherChannel);
		weatherChannel = -1;
		weatherSound = want;
		auto it = w.game.sounds.find(want);
		if (it != w.game.sounds.end())
			weatherChannel = audioPlay(it->second.file, it->second.volume * 0.7f, 0.0f, true);
	}
	if (outside && wt == WEATHER_THUNDER && (thunderIn -= dt) <= 0.0f)
	{
		thunderIn = 8.0f + rand() % 20;
		playSound(-1, "thunder" + std::to_string(rand() % 4));
		fade = fmaxf(fade, 0.0f);            // (no flash: bright frames hurt on the 3D screen)
	}
}

// Rain (streaks) and ash / blight (drifting motes) over the top screen, as dense as the weather is in
void Session::drawPrecipitation()
{
	if (w.current < 0 || w.cells[w.current].interior || w.game.weatherTypes.empty())
		return;
	// OpenMW: the falling stuff fades out of the old weather up to the new one's rain threshold, then in
	float thr = w.game.weatherTypes[std::min(w.weatherNext, (int)w.game.weatherTypes.size() - 1)].rainThreshold;
	thr = thr > 0.0f ? thr : 0.5f;
	auto amount = [&](int kind) {
		if (w.weatherNow == w.weatherNext)
			return w.weatherNow == kind ? 1.0f : 0.0f;
		float out = fmaxf(0.0f, 1.0f - w.weatherBlend / thr), in = fmaxf(0.0f, (w.weatherBlend - thr) / (1.0f - thr));
		return (w.weatherNow == kind ? out : 0.0f) + (w.weatherNext == kind ? in : 0.0f);
	};
	float rain = amount(WEATHER_RAIN) + amount(WEATHER_THUNDER) * 1.5f;
	float ash = amount(WEATHER_ASH) + amount(WEATHER_BLIGHT);
	if (rain < 0.05f && ash < 0.05f)
		return;
	static float px[96], py[96];
	static bool seeded = false;
	// The drops move once a frame, not once an eye: each eye drew its own, and the two never matched (a
	// double image that hurts to look at). The same drops in both eyes sit flat on the HUD's plane
	bool step = hudEye == 0;
	if (!seeded)
	{
		for (int k = 0; k < 96; k++)
		{
			px[k] = rand() % 400;
			py[k] = rand() % 240;
		}
		seeded = true;
	}
	int n = (int)(fminf(1.5f, rain + ash) * 64.0f);
	for (int k = 0; k < n && k < 96; k++)
	{
		if (rain >= ash)
		{
			if (step)
			{
				py[k] += 9.0f;
				px[k] -= 1.5f;
			}
			uiRect(px[k], py[k], 1, 7, C2D_Color32(190, 200, 215, 120));
		}
		else
		{
			if (step)
			{
				py[k] += 1.5f;
				px[k] -= 3.5f;
			}
			uiRect(px[k], py[k], 2, 2, C2D_Color32(120, 90, 70, 150));
		}
		if (step && (py[k] > 240 || px[k] < 0))
		{
			px[k] = rand() % 420;
			py[k] = -(float)(rand() % 40);
		}
	}
}

void Session::playMusic(bool battle)
{
	std::vector<std::string> list = battle && !w.game.battleMusic.empty() ? w.game.battleMusic : w.game.music;
	// a different track first each time
	if (list.size() > 1)
		std::rotate(list.begin(), list.begin() + rand() % list.size(), list.end());
	battleMusic = battle && !w.game.battleMusic.empty();
	audioMusicPlay(list, battleMusic ? 0.35f : 0.3f);
}

// StreamMusic: a track from the music folder, when it was converted (the others aren't on the card)
void Session::streamMusic(const std::string& file)
{
	// the converter's names: music folder first, no extension, anything but letters and digits an underscore
	std::string stem = "music/" + lower(file);
	size_t dot = stem.rfind('.');
	if (dot != std::string::npos && stem.find('/', dot) == std::string::npos)
		stem.erase(dot);
	for (auto& ch : stem)
		if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')))
			ch = '_';
	stem += ".snd";
	FILE* f = fopen((std::string(w.dataDir) + "/music/" + stem).c_str(), "rb");
	if (!f)
	{
		logf("StreamMusic: %s not converted", stem.c_str());
		return;
	}
	fclose(f);
	battleMusic = false;
	audioMusicPlay({ stem }, 0.3f);
}

void Session::updateMusic(float dt)
{
	bool fighting = false;
	for (int i : w.loadedActors)
	{
		const Ref& r = w.refs[i];
		if (r.ai == AI_COMBAT && !r.dead && !r.ally && w.distanceToPlayer(i) < 3000.0f)
		{
			fighting = true;
			break;
		}
	}
	if (fighting)
	{
		calmFor = 0.0f;
		if (!battleMusic)
			playMusic(true);
	}
	else if (battleMusic && (calmFor += dt) > 5.0f)
		playMusic(false);
}

void Session::stopLoopSounds()
{
	for (auto& l : loopSounds)
		audioStop(l.channel);
	loopSounds.clear();
	scriptSounds.clear();
}

void Session::say(int ref, const std::string& file, const std::string& text)
{
	std::string key = lower(file);
	for (auto& c : key)
		if (c == '/')
			c = '\\';
	float duration = 0.0f;
	int& channel = ref >= 0 ? w.refs[ref].voiceChannel : uiVoiceChannel;
	if (channel >= 0)
	{
		if (audioPlaying(channel))        // (a finished line's channel may be another sound's by now)
			audioStop(channel);
		channel = -1;
	}
	auto it = w.game.voices.find(key);
	if (it != w.game.voices.end())
	{
		duration = audioDuration(it->second);
		float volume = 1.0f, pan = 0.0f;
		if (ref >= 0)
		{
			float pos[3] = { w.refs[ref].pos[0], w.refs[ref].pos[1], w.refs[ref].pos[2] + 110.0f };
			mix3d(pos, volume, pan, 300.0f, 2500.0f);
		}
		channel = audioPlay(it->second, volume, pan);
	}
	else if (!key.empty())     // (no file: a line of text only)
	{
		logf("voice missing: %s", key.c_str());
		monitorOnce(("voice:" + key).c_str(), "missing voice line %s", key.c_str());
	}
	if (duration <= 0.0f)
		duration = 1.0f + text.size() * 0.06f;
	if (ref >= 0)
	{
		sayUntil[ref] = w.time + duration;
		// A scripted or dialogue line also counts as a greeting
		w.refs[ref].helloTimer = fmaxf(w.refs[ref].helloTimer, duration + 20.0f);
	}
	if (!text.empty())
	{
		std::string who = ref >= 0 && w.refs[ref].actor >= 0 ? w.game.actors[w.refs[ref].actor].name + ": " : "";
		subtitle = who + text;
		subtitleUntil = w.time + duration + 0.5f;
	}
}

bool Session::sayDone(int ref)
{
	auto it = sayUntil.find(ref);
	return it == sayUntil.end() || w.time >= it->second;
}

// NPCs greet the player with a "Hello" voice line when they come close
void Session::greetings(float dt)
{
	const Topic* hello = w.game.topic("Hello");
	// Nobody greets during scripted scenes (controls taken away)
	if (!hello || !w.controlsEnabled)
		return;
	// OpenMW's updateGreetingState: an actor wandering, travelling or with no package, not in combat, swimming or
	// paralyzed, greets once when the player is within AI Hello x iGreetDistanceMultiplier, in sight and noticed; it
	// greets again only after the player has gone fGreetDistanceReset away
	float reset = w.game.gmstf("fgreetdistancereset", 512.0f);
	for (int i : w.loadedActors)
	{
		Ref& r = w.refs[i];
		if (r.actor < 0 || !w.active(i) || !r.visible() || r.dead)
			continue;
		float d = w.distanceToPlayer(i);
		if (r.greeted && d >= reset)
			r.greeted = false;
		if (r.greeted || r.ai == AI_COMBAT || r.helloTimer > 0.0f || !sayDone(i) || (w.actorOf(i) && w.actorOf(i)->swimming)
			|| (r.aiPackage != AIPKG_NONE && r.aiPackage != AIPKG_WANDER && r.aiPackage != AIPKG_TRAVEL
				&& r.aiPackage != AIPKG_IDLE)
			|| w.actorEffect(i, 45) > 0.0f || r.knockTimer > 0.0f)
			continue;
		int helloSetting = r.hello >= 0 ? r.hello : w.game.actors[r.actor].hello;
		// Slightly farther greets so towns feel more aware of the player (world-life pass)
		float greetMult = w.game.gmstf("igreetdistancemultiplier", 6.0f) * 1.25f;
		if (helloSetting <= 0 || d > helloSetting * greetMult)
			continue;
		float head[3] = { r.pos[0], r.pos[1], r.pos[2] + 110.0f }, eye[3] = { w.player.feet[0], w.player.feet[1], playerEyeZ(w.player) };
		if (!w.lineOfSight(head, eye) || !awarenessCheck(i))
			continue;
		const Info* info = dialogueVoiced(w, *hello, i);
		r.greeted = true;
		r.helloTimer = 2.0f;
		if (info && !info->sound.empty())
			say(i, info->sound, dialogueSubstitute(w, info->text, i));
	}
}

// ---- ScriptHost

// The tutorial's console wording (Xbox returns 1), said with the 3DS's controls
static std::string for3ds(std::string t)
{
	// (GoldenEye keeps the Xbox layout's buttons)
	bool xbox = g_controlLayout == CONTROLS_XBOX || g_controlLayout == CONTROLS_GOLDENEYE;
	const char* swap[][2] = {
		{ "The LEFT THUMBSTICK moves you, and the RIGHT THUMBSTICK looks around.",
		  g_controlLayout == CONTROLS_GOLDENEYE
			? "The Circle Pad walks and turns; hold X (or R, winding up a blow) and it aims instead, up and down too."
			: "The Circle Pad moves you, and the C-Stick looks around (the D-Pad looks up and down)." },
		{ "Press B to use your menus. When you are done with them, press B again to close them.",
		  "Tap the buttons on the bottom screen to use your menus (START for saves). Press B to close them." },
		{ "Press the WHITE button to use your journal", "Tap Journal on the bottom screen to use your journal" },
		{ "Press the X button to pull out your weapon. Once your weapon is readied, hold and release the RIGHT TRIGGER to swing it.",
		  g_controlLayout == CONTROLS_GOLDENEYE ? "Equip your weapon, then tap X to ready it, and hold and release R to swing it."
			: xbox ? "Equip your weapon, then press X to ready it, and hold and release R to swing it."
			: "Equip your weapon, then hold and release X to swing it." },
		{ "Equip the dagger by dropping it on your picture in your inventory menu.",
		  "Equip the dagger: tap Items on the bottom screen, then tap the dagger twice." },
		{ "Like all menus, press B to use your new menu. The triggers cycle between menus. Press B again to exit your menus.",
		  "Like all menus, tap it on the bottom screen; B closes it." },
		{ "Press Y to ready your Active Magic, then the RIGHT TRIGGER to cast.",
		  xbox ? "Choose your Active Magic in the Magic menu, then press L to cast it."
			: "Choose your Active Magic in the Magic menu, then press Y to cast it." },
		{ "Press BLACK to rest", "Press START and choose Rest / Wait to rest" },
		{ "Then select 'Take' to pick them up.", "Then tap Take to pick them up." },
	};
	for (auto& s : swap)
	{
		size_t at = t.find(s[0]);
		if (at != std::string::npos)
			t.replace(at, strlen(s[0]), s[1]);
	}
	return t;
}

void Session::messageBox(const std::string& text0, const std::vector<std::string>& buttons)
{
	std::string text = for3ds(text0);
	if (buttons.empty())
	{
		notify(text);
		return;
	}
	buttonPressed = -1;          // a new box: no answer yet
	messages.push_back({ text, buttons, true });
	logf("messagebox: %s", text.c_str());
}

int Session::takeButtonPressed()
{
	int b = buttonPressed;
	buttonPressed = -1;
	return b;
}

void Session::openMenu(ScriptMenu menu)
{
	pendingMenus.push_back(menu);
}

// ForceGreeting: the speaker opens the conversation, hostile or not (Dagoth Gares greets Nerevar before the
// fight) and without their OnActivate (that's the player's activation)
void Session::forceGreeting(int ref)
{
	if (ref < 0 || dlg.open || !w.active(ref))
		return;
	Ref& r = w.refs[ref];
	if (r.dead || !r.visible() || r.actor < 0)
		return;
	float dx = r.pos[0] - w.player.feet[0], dy = r.pos[1] - w.player.feet[1];
	float dz = r.pos[2] + 115.0f - (w.player.feet[2] + PLAYER_EYE_HEIGHT);
	w.player.yaw = atan2f(dx, dy);
	w.player.pitch = atan2f(dz, fmaxf(1.0f, sqrtf(dx * dx + dy * dy)));
	logf("dialogue: %s greets the player (ForceGreeting)", r.id.c_str());
	if (dialogueStart(dlg, w, *this, ref))
	{
		wordsRevision = -1;
		openScreen(SCR_DIALOGUE);
	}
}

void Session::dialogueChoice(const std::vector<std::pair<std::string, int>>& choices)
{
	// each Choice adds to the ones already offered
	dlg.choices.insert(dlg.choices.end(), choices.begin(), choices.end());
	dlg.revision++;
}

void Session::dialogueGoodbye()
{
	dlg.goodbye = true;
	dlg.choices.clear();         // (OpenMW) Goodbye ends any choice
	dlg.revision++;
}

void Session::notify(const std::string& text)
{
	notes.push_back({ text, w.time + 5.0f });
	if (notes.size() > 4)
		notes.erase(notes.begin());
	logf("notify: %s", text.c_str());
}

// ---- Test harness helpers (autoinput BOOST / GIVE / PLACE)

void Session::testBoost(int value)
{
	w.recomputeStats();
	for (int i = 0; i < 8; i++)
		w.stats.attrBonus[i] += value - w.stats.attributes[i];
	for (int k = 0; k < 27; k++)
		w.stats.skillBonus[k] += value - w.stats.skills[k];
	w.recomputeStats();
	logf("test: boost to %d, health %.0f fatigue %.0f", value, w.stats.healthMax, w.stats.fatigueMax);
}

static std::string underscoresToSpaces(std::string s)
{
	for (auto& ch : s)
		if (ch == '_')
			ch = ' ';
	return s;
}

int Session::testFindRef(const std::string& id)
{
	// the creature the test placed, even once it is dead: another with its id (a spawn in a loaded neighbour) is not it
	if (testPlaced >= 0 && w.active(testPlaced))
	{
		const std::string& pid = w.refs[testPlaced].idLower;
		if (pid == lower(id) || pid == lower(underscoresToSpaces(id)))
			return testPlaced;
	}
	int ref = w.findRef(id);
	if (!w.active(ref))
	{
		int spaced = w.findRef(underscoresToSpaces(id));
		if (w.active(spaced) || ref < 0)
			ref = spaced;
	}
	// a dead one when a living one shares the id (a creature placed again): the living one
	if (w.active(ref) && w.refs[ref].dead)
	{
		const std::string want = w.refs[ref].idLower;
		w.forLoadedRefs([&](int i) {
			if (w.refs[ref].dead && w.refs[i].idLower == want && !w.refs[i].dead)
				ref = i;
		});
	}
	return ref;
}

void Session::testGive(const std::string& id, int count, bool topUp)
{
	const Object* o = w.game.object(id);
	if (!o)
		o = w.game.object(underscoresToSpaces(id));
	if (!o)
	{
		logf("test: no item %s", id.c_str());
		return;
	}
	bool ammo = o->type == "WEAP" && o->subtype >= 12;
	int want = count > 0 ? count : ammo ? 50 : 1;
	// (a chained chapter: only up to the count, so an item the last chapter's story handed over isn't doubled)
	if (topUp)
		want -= w.itemCount(o->id);
	if (want > 0)
		w.addItem(o->id, want);
	// (lockpicks and probes are only added: equipping one would replace the weapon in hand, and OpenMW never equips on
	// add; USELOCKPICK / USEPROBE / EQUIP hold one when a case needs it)
	bool wearable = o->type == "WEAP" || o->type == "ARMO" || o->type == "CLOT" || o->type == "LIGH";
	for (size_t k = 0; k < w.inventory.size() && wearable; k++)
		if (lower(w.inventory[k].id) == lower(o->id))
			equipItem(k, true);
	logf("test: gave %s%s", o->id.c_str(), wearable ? " and equipped it" : "");
}

void Session::testPlace(const std::string& id, float dist)
{
	int ri = testFindRef(id);
	float fx = sinf(w.player.yaw), fy = cosf(w.player.yaw);
	if (!w.active(ri) || w.refs[ri].dead)
	{
		// None to move (or only a corpse): a new one, as PlaceAtPC would
		ri = w.spawnActor(id, w.player.feet, atan2f(-fx, -fy));
		if (ri < 0)
		{
			logf("test: %s not loaded", id.c_str());
			return;
		}
	}
	Ref& r = w.refs[ri];
	Cell* cell = w.cellOf(ri);
	float to[3] = { w.player.feet[0] + fx * dist, w.player.feet[1] + fy * dist, w.player.feet[2] };
	float fz;
	if (cell && collisionFloor(cell->collision, to[0], to[1], to[2] + 200.0f, to[2] - 400.0f, &fz))
		to[2] = fz;
	for (int k = 0; k < 3; k++)
		r.pos[k] = r.home[k] = to[k];
	r.fitBox();
	r.rot[2] = atan2f(-fx, -fy);
	r.moved = true;
	w.syncActor(ri);
	testPlaced = ri;
	logf("test: placed %s at %.0f %.0f %.0f", r.id.c_str(), to[0], to[1], to[2]);
}

// Enters a cell through a door that leads there (any loaded door; else the first one found)
void Session::testGoto(const std::string& cellName)
{
	std::string want = lower(cellName);
	int door = -1;
	for (size_t i = 0; i < w.refs.size(); i++)
	{
		const Ref& r = w.refs[i];
		if (r.hasDest && lower(r.destCell) == want && (door < 0 || w.active(i)))
			door = i;
	}
	if (door < 0)
	{
		// No door read yet (cells' objects load on demand): straight in; a TP step places the player
		int dest = w.cellIndex(cellName);
		if (dest < 0)
		{
			logf("test: %s is not in the level", cellName.c_str());
			return;
		}
		travelCell = dest;
		travelPos[0] = travelPos[1] = travelPos[2] = 0.0f;
		travelYaw = 0.0f;
		// an exterior cell: its middle (the position decides which cells load outdoors), not world 0 0
		if (!w.cells[dest].interior)
		{
			travelPos[0] = (w.cells[dest].gx + 0.5f) * 8192.0f;
			travelPos[1] = (w.cells[dest].gy + 0.5f) * 8192.0f;
			travelToSpawn = true;
			// a town: its street, in front of a door (the converter's pick, as a new game there starts), not the
			// cell's middle (Seyda Neen's is out in the bay)
			auto town = w.game.townSpawns.find(want);
			int at = town != w.game.townSpawns.end()
				? w.gridCell((int)floorf(town->second[0] / 8192.0f), (int)floorf(town->second[1] / 8192.0f)) : -1;
			if (at >= 0)
			{
				travelCell = at;
				memcpy(travelPos, town->second.data(), sizeof(travelPos));
				travelYaw = town->second[3];
				travelToSpawn = false;
				logf("test: going into %s (its street)", cellName.c_str());
				return;
			}
		}
		// where a door into it lands (converter: cell_entries.txt), not the cell's origin (the void, often)
		static std::unordered_map<std::string, std::array<float, 4>> entries;
		if (entries.empty())
		{
			char path[256];
			snprintf(path, sizeof(path), "%s/cell_entries.txt", w.dataDir);
			if (FILE* f = fopen(path, "r"))
			{
				char line[320];
				while (fgets(line, sizeof(line), f))
				{
					char* tab = strchr(line, '	');
					std::array<float, 4> e;
					if (tab && sscanf(tab + 1, "%f %f %f %f", &e[0], &e[1], &e[2], &e[3]) == 4)
						entries[std::string(line, tab - line)] = e;
				}
				fclose(f);
			}
		}
		auto e = entries.find(want);
		if (e != entries.end())
		{
			memcpy(travelPos, e->second.data(), sizeof(travelPos));
			travelYaw = e->second[3];
			logf("test: going into %s (where its door lands)", cellName.c_str());
			return;
		}
		logf("test: going straight into %s", cellName.c_str());
		return;
	}
	const Ref& r = w.refs[door];
	int dest = r.destHasGrid ? w.gridCell(r.destGrid[0], r.destGrid[1]) : w.cellIndex(r.destCell);
	if (dest < 0)
	{
		logf("test: %s is not in the level", cellName.c_str());
		return;
	}
	travelCell = dest;
	memcpy(travelPos, r.destPos, sizeof(travelPos));
	travelYaw = r.destRot[2];
	logf("test: going to %s", cellName.c_str());
}

void Session::noteHudMismatch(int left, int right)
{
	monitorOnce(("hud:" + std::to_string((int)screen) + ":" + std::to_string(dlg.open)).c_str(),
		"the HUD drew %d things in the left eye and %d in the right (screen %d, dialogue %d, %s): one eye is missing something",
		left, right, (int)screen, (int)dlg.open, w.cellName().c_str());
}

// Engine-side checks, run in every test (and the game): a "monitor:" line each, once per actor or place.
// Floating or sunk actors, actors going nowhere, the player under the world, doors that lead nowhere,
// linear memory that shrinks each time the same cell is entered.
void Session::monitorActors(float dt)
{
	monitorTimer += dt;
	if (monitorTimer < 1.0f)
		return;
	float step = monitorTimer;
	monitorTimer = 0.0f;
	if (monitorCell != w.current)
		monitorCellChanged();
	for (int i : w.loadedActors)
	{
		const Ref& r = w.refs[i];
		// Out of the crosshair's reach: the box it's aimed at isn't where the actor stands (no talking to
		// them, nor searching the body)
		if (r.visible() && (!r.hasBox || r.pos[0] < r.boxMin[0] || r.pos[0] > r.boxMax[0] || r.pos[1] < r.boxMin[1]
				|| r.pos[1] > r.boxMax[1]))
			monitorOnce(("aim:" + r.idLower + ":" + w.cellName()).c_str(),
				"%s can't be aimed at in %s: at %.0f %.0f %.0f, its box %s %.0f %.0f .. %.0f %.0f", r.id.c_str(),
				w.cellName().c_str(), r.pos[0], r.pos[1], r.pos[2], r.hasBox ? "" : "(none)", r.boxMin[0], r.boxMin[1],
				r.boxMax[0], r.boxMax[1]);
		Actor* a = r.dead || !r.visible() ? nullptr : w.actorOf(i);
		if (!a)
			continue;
		// Drawn, or in the way, somewhere other than where it stands: another copy of its position that
		// whatever moved it (a cell's state, a save, a script) didn't update
		{
			const Cell* cell = w.cellOf(i);
			bool hasBlock = cell && r.cellActor >= 0 && r.cellActor < (int)cell->actors.size();
			float blocks[2] = { 0.0f, 0.0f };     // (copied: the record is packed)
			if (hasBlock)
				memcpy(blocks, (const void*)&cell->actors[r.cellActor].pos, sizeof(blocks));
			float ddx = a->place[3] - r.pos[0], ddy = a->place[7] - r.pos[1];
			if (ddx * ddx + ddy * ddy > 4.0f * 4.0f)
				monitorOnce(("drawn:" + r.idLower + ":" + w.cellName()).c_str(),
					"%s is drawn at %.0f %.0f but stands at %.0f %.0f in %s", r.id.c_str(), a->place[3], a->place[7],
					r.pos[0], r.pos[1], w.cellName().c_str());
			if (hasBlock && ((blocks[0] - r.pos[0]) * (blocks[0] - r.pos[0]) + (blocks[1] - r.pos[1]) * (blocks[1] - r.pos[1])
					> 4.0f * 4.0f))
				monitorOnce(("blocks:" + r.idLower + ":" + w.cellName()).c_str(),
					"%s blocks the way at %.0f %.0f but stands at %.0f %.0f in %s", r.id.c_str(), blocks[0], blocks[1],
					r.pos[0], r.pos[1], w.cellName().c_str());
		}
		const Skeleton& sk = actorSkeleton(*w.actorsOf(i), a->skeleton);
		const char* g = a->group < (int)sk.groups.size() ? sk.groups[a->group].name : "";
		bool cycle = a->mode == ANIM_LOOP && (strstr(g, "Walk") || strstr(g, "Run"));
		Watch& wt = watches[i];
		float mx = r.pos[0] - wt.x, my = r.pos[1] - wt.y;
		wt.x = r.pos[0];
		wt.y = r.pos[1];
		wt.still = cycle && mx * mx + my * my < 15.0f * 15.0f ? wt.still + step : 0.0f;
		if (wt.still >= 4.0f && !wt.told)
		{
			wt.told = true;
			logf("monitor: %s walks in place (%s) at %.0f %.0f %.0f%s [ai %d, package %d, fleeing %d, still %.1f, hitAt %.1f, "
				"player %.0f away, %.0f up]", r.id.c_str(), g, r.pos[0], r.pos[1], r.pos[2],
				dlg.open && dlg.ref == i ? ", while talking" : "", (int)r.ai, (int)r.aiPackage, (int)r.fleeing, r.chaseStill,
				r.hitAt, w.distanceToPlayer(i), w.player.feet[2] - r.pos[2]);
		}

		// Off the floor: an idle person more than 8 units above the floor under their feet or 20 below it
		// (creatures that fly, or swim while in water, hang where they are, so they're only checked for sinking),
		// for 2 s
		bool creature = r.actor >= 0 && w.game.actors[r.actor].creature;
		if (creature)
		{
			u8 afloat = w.game.actors[r.actor].afloat;
			creature = (afloat & 0x20) || ((afloat & 0x10) && w.underWater(r.pos[2]));
		}
		bool idle = r.ai != AI_COMBAT && !r.falling && r.knockTimer <= 0.0f && !a->swimming;
		// (on the floor anywhere from the floor under the middle up to the highest under the feet: a step and
		// gravity stand them on the latter, as OpenMW's actor box rests on a slope or a ledge's edge)
		float floorZ = -1e9f, footZ = -1e9f;
		if (idle)
			for (LoadedCell* l : w.loaded)
			{
				float z;
				if (collisionFloor(l->cell.collision, r.pos[0], r.pos[1], r.pos[2] + 40.0f, r.pos[2] - 6000.0f, &z) && z > floorZ)
					floorZ = z;
				if (collisionFootFloor(l->cell.collision, r.pos[0], r.pos[1], kActorFootReach, r.pos[2] + 40.0f, r.pos[2] - 6000.0f,
						&z) && z > footZ)
					footZ = z;
			}
		float gap = floorZ > -1e8f ? r.pos[2] - floorZ : 0.0f;
		if (gap > 0.0f)
			gap = fmaxf(0.0f, r.pos[2] - footZ);
		bool off = idle && ((floorZ < -1e8f && !creature) || gap < -20.0f || (gap > 8.0f && !creature));
		wt.off = off ? wt.off + step : 0.0f;
		if (wt.off >= 2.0f && !wt.toldFloor)
		{
			wt.toldFloor = true;
			if (floorZ < -1e8f)
				logf("monitor: %s has no floor under it at %.0f %.0f %.0f in %s", r.id.c_str(), r.pos[0], r.pos[1], r.pos[2],
					w.cellName().c_str());
			else
				logf("monitor: %s is %.0f units %s the floor at %.0f %.0f %.0f in %s", r.id.c_str(), fabsf(gap),
					gap > 0 ? "above" : "below", r.pos[0], r.pos[1], r.pos[2], w.cellName().c_str());
		}

		// Going somewhere and getting nowhere: a travel / follow / escort package, or a fight, with under 15
		// units of net movement in 5 s (next to the player is where a follower or a fighter stops)
		// (a scripted follower that hasn't seen its leader yet stands, as in OpenMW; a follower stops within
		// follow distance, 256, of whoever it follows, which needn't be the player)
		bool going = ((r.aiPackage == AIPKG_TRAVEL || r.aiPackage == AIPKG_FOLLOW || r.aiPackage == AIPKG_ESCORT) && !r.aiDone
				&& r.aiActive) || r.ai == AI_COMBAT;
		float leaderDist = w.distanceToPlayer(i);
		if ((r.aiPackage == AIPKG_FOLLOW || r.aiPackage == AIPKG_ESCORT) && r.ai != AI_COMBAT && r.aiTarget != "player"
			&& !r.aiTarget.empty())
		{
			int t = w.findRef(r.aiTarget);
			if (t >= 0)
			{
				float dx = w.refs[t].pos[0] - r.pos[0], dy = w.refs[t].pos[1] - r.pos[1];
				leaderDist = sqrtf(dx * dx + dy * dy);
			}
		}
		bool near = r.aiPackage != AIPKG_TRAVEL && leaderDist < 300.0f;
		// (a fleeing actor stands while its foe is out of reach, one held in a pose for a test stands: not stuck)
		const Actor* held = w.actorOf(i);
		if (!going || near || r.knockTimer > 0.0f || (r.fleeing && r.fleeState == 0) || (held && held->frozen) || (dlg.open && dlg.ref == i))
		{
			wt.moveT = 0.0f;
			wt.anchorX = r.pos[0];
			wt.anchorY = r.pos[1];
		}
		else
		{
			float ax = r.pos[0] - wt.anchorX, ay = r.pos[1] - wt.anchorY;
			if (ax * ax + ay * ay >= 15.0f * 15.0f)
			{
				wt.moveT = 0.0f;
				wt.anchorX = r.pos[0];
				wt.anchorY = r.pos[1];
			}
			else
				wt.moveT += step;
			if (wt.moveT >= 5.0f && !wt.toldStuck)
			{
				wt.toldStuck = true;
				logf("monitor: %s is stuck at %.0f %.0f %.0f in %s (%s, package %d, target %s, path %d points, player %.0f away)",
					r.id.c_str(), r.pos[0], r.pos[1], r.pos[2], w.cellName().c_str(), r.ai == AI_COMBAT ? "fighting" : "travelling",
					r.aiPackage, r.aiTarget.c_str(), (int)r.path.size(), w.distanceToPlayer(i));
			}
		}
	}
	if (watches.size() > 400)
		watches.clear();

	// The player under the world: no floor in any loaded cell below the feet, or in the air for over 3 s
	// (flying, levitating and swimming excepted)
	const Player& p = w.player;
	bool airborne = !p.onGround && !p.flying && !p.swimming && p.levitate <= 0.0f && !p.waterWalk && !playerDead
		&& !menuOpen() && travelCell < 0;
	playerAirT = airborne ? playerAirT + step : 0.0f;
	if (airborne)
	{
		float floorZ = -1e9f;
		for (LoadedCell* l : w.loaded)
		{
			float z;
			if (collisionFloor(l->cell.collision, p.feet[0], p.feet[1], p.feet[2] + 30.0f, p.feet[2] - 100000.0f, &z) && z > floorZ)
				floorZ = z;
		}
		// (a jump may hang in the air much longer, over open sea too: Scroll of Icarian Flight)
		bool flight = p.jumpFlight && p.feet[2] > 0.0f;
		if (((floorZ < -1e8f && !flight) || (playerAirT >= 3.0f && !p.jumpFlight)) && !toldFall)
		{
			toldFall = true;
			logf("monitor: the player is %s at %.0f %.0f %.0f in %s (%.1f s in the air, vz %.0f)",
				floorZ < -1e8f ? "under every floor" : "falling", p.feet[0], p.feet[1], p.feet[2], w.cellName().c_str(),
				playerAirT, p.vz);
		}
	}
	else if (p.onGround)
		toldFall = false;
}

// A new cell: doors in it that lead nowhere, and the linear memory left each time the same cell is entered
// (falling on each visit: something a visit allocates isn't given back)
void Session::monitorCellChanged()
{
	monitorCell = w.current;
	if (w.current < 0)
		return;
	w.forLoadedRefs([&](int i) {
		const Ref& r = w.refs[i];
		if (!r.hasDest || r.destEnd)
			return;
		int dest = r.destUnconverted ? -1 : r.destHasGrid ? w.gridCell(r.destGrid[0], r.destGrid[1]) : w.cellIndex(r.destCell);
		if (dest < 0)
			monitorOnce(("door:" + r.idLower + ":" + w.cells[w.current].name).c_str(),
				"door %s in %s leads to %s, which is not in the level (unconverted %d)", r.id.c_str(), w.cellName().c_str(),
				r.destHasGrid ? "an exterior cell" : r.destCell.c_str(), (int)r.destUnconverted);
	});
	std::vector<unsigned long>& m = cellMemory[w.cellName()];
	m.push_back(linearSpaceFree() / 1024);
	// what holds linear memory: textures, loaded cells' geometry, their people, distant land, decoded sounds (the rest:
	// the GPU's command buffer, the UI, sky, effects)
	u32 geometry = 0, actorBytes = 0;
	for (LoadedCell* l : w.loaded)
	{
		geometry += l->cell.geometryBytes;
		actorBytes += l->actors.bytes;
	}
	logf("cellmem: %s entered, %lu KB linear free (visit %d): textures %lu, cells %lu, actors %lu, distant %lu, sounds %lu KB",
		w.cellName().c_str(), m.back(), (int)m.size(), (unsigned long)(w.textures.bytes / 1024), (unsigned long)(geometry / 1024),
		(unsigned long)(actorBytes / 1024), (unsigned long)(distantBytes() / 1024), (unsigned long)(audioCacheBytes() / 1024));
	size_t n = m.size();
	// (from the fifth visit on: the first entry always has the most free, the caches that fill after it not yet there)
	if (n >= 5 && m[n - 1] + 64 < m[n - 2] && m[n - 2] + 64 < m[n - 3] && m[n - 3] + 64 < m[n - 4])
		monitorOnce(("mem:" + w.cellName()).c_str(), "linear memory falls on each visit to %s: %lu, %lu, %lu, %lu KB free at entry",
			w.cellName().c_str(), m[n - 4], m[n - 3], m[n - 2], m[n - 1]);
	if (n > 12)
		m.erase(m.begin());
}

// Console: forward to the interpreter's stat handler (defined in script.cpp).
void scriptConsoleStat(World& w, int ref, int op, const std::string& stat, float v);
void Session::consoleStat(int op, const std::string& stat, float v, int ref)
{
    scriptConsoleStat(w, ref, op, stat, v);
}


void Session::netUpdate(float dt) {

    /* MPFIX_NETUPD: ground velocity from feet displacement (feeds Fix A) */
    {
        if (dt > 0.0f) {
            if (mpHavePrev) {
                float dx = w.player.feet[0] - mpPrevFeet[0];
                float dy = w.player.feet[1] - mpPrevFeet[1];
                float vx = dx / dt, vy = dy / dt;
                if (vx * vx + vy * vy > 1500.0f * 1500.0f) vx = vy = 0.0f;
                float k = fminf(1.0f, dt * 12.0f);
                mpVel[0] += (vx - mpVel[0]) * k;
                mpVel[1] += (vy - mpVel[1]) * k;
            }
            memcpy(mpPrevFeet, w.player.feet, sizeof(mpPrevFeet));
            mpHavePrev = true;
        }
    }

    net.poll();
    /* patch: mp heartbeat -- ensure a state send every ~50 ms */
    chat.update(dt);
    frameDtRemote = dt;
    for (int i = 0; i < NetEngine::kMaxPeers; i++)
        if (remotePlayers[i].active)
            remotePlayers[i].updateAge += dt;
    updateCompanionBody(dt);
    updateRemoteCompanionBody(dt);
    if ((mpMode == 1 || mpMode == 2) && net.isConnected()) {
        static float acc = 0.0f;
        acc += dt;
        if (acc >= 0.05f) {
            acc = 0.0f;
            netSendPlayerState();
        }
    }
}

void Session::netSendPlayerState()
{
    LocalPlayerState ls = buildLocalPlayerState();
    /* MPFIX_A: real-velocity override */
    // Player::inertia is only set during a jump take-off; on the ground it is 0,
    // which made remote players appear idle. Override with the real ground velocity
    // measured in netUpdate() from how far the feet moved.
    {
        float vx = mpVel[0], vy = mpVel[1];
        float sp = sqrtf(vx * vx + vy * vy);
        if (sp > 10.0f) {
            ls.speed = sp;
            ls.moveX = vx / sp;
            ls.moveY = vy / sp;
        } else {
            ls.speed = 0.0f;
            ls.moveX = ls.moveY = 0.0f;
        }
    }

    std::vector<uint8_t> buf;

    auto putField = [&](const void* p, size_t n) {
        size_t off = buf.size();
        buf.resize(off + n);
        memcpy(buf.data() + off, p, n);
    };
    auto putStr = [&](const std::string& s, size_t fixedLen) {
        size_t off = buf.size();
        buf.resize(off + fixedLen, 0);
        memcpy(buf.data() + off, s.data(), std::min(s.size(), fixedLen - 1));
    };

    putStr(ls.desc.race, 32);
    uint8_t female = ls.desc.female ? 1 : 0;
    putField(&female, 1);
    putStr(ls.desc.head, 32);
    putStr(ls.desc.hair, 32);
    uint8_t wornCount = (uint8_t)std::min<size_t>(ls.desc.worn.size(), 32);
    putField(&wornCount, 1);
    for (uint8_t i = 0; i < wornCount; i++)
        putStr(ls.desc.worn[i], 32);
    putField(ls.feet, 12);
    putField(&ls.yaw, 4);
    putField(&ls.pitch, 4);
    uint8_t actAction = (uint8_t)ls.act.action;
    putField(&actAction, 1);
    putStr(ls.act.group, 24);
    putField(&ls.act.charge, 4);
    putField(&ls.act.speed, 4);
    putField(&ls.act.strength, 4);
    putStr(ls.act.stance, 8);
    putField(&ls.moveX, 4);
    putField(&ls.moveY, 4);
    putField(&ls.speed, 4);
    uint8_t weaponOut = ls.weaponOut ? 1 : 0;
    putField(&weaponOut, 1);

    net.broadcastMsg(NM_PLAYERSTATE, buf.data(), (uint32_t)buf.size());
}

/* ==========================================================================
 * MPITEMS_V3: world item + container state sync (bidirectional)
 * ==========================================================================
 * Packet layout:
 *   u8  subtype      0=taken, 1=dropped, 2=disabled, 3=contents
 *   u8  isRequest    0=STATE (host->all), 1=REQUEST (client->host)
 *   [identity block: i32 hostRef, u8 cellFileLen, cellFile, u32 refInCell]
 *   [subtype-specific body]
 *
 * Direction rules:
 *   Host mpBroadcast*          -> isRequest=0, broadcastMsg to all
 *   Client mpBroadcast*        -> isRequest=1, sendMsg to peer 0 only
 *   Host receives isReq=1      -> apply, then re-broadcast STATE
 *   Client receives isReq=0    -> apply + remember host slot mapping
 * ========================================================================== */

int Session::mpResolveRef(const std::string& cellFile, int refInCell) const
{
    if (cellFile.empty()) return -1;
    int c = w.cellIndex(cellFile);
    if (c < 0 || !w.cells[c].refsLoaded) return -1;
    if (refInCell < 0 || refInCell >= w.cells[c].refCount) return -1;
    int ref = w.cells[c].refBase + refInCell;
    if (ref < 0 || ref >= (int)w.refs.size()) return -1;
    return ref;
}

int Session::mpResolveDrop(int hostSlot) const
{
    auto it = mpDropMap.find(hostSlot);
    return it == mpDropMap.end() ? -1 : it->second;
}

// Append (hostRef, cellFile, refInCell) to buf. On the client, hostRef is
// looked up in mpHostSlotOfClientRef first so the host can resolve back.
static void mpPutRefId(std::vector<u8>& buf, const World& w, int ref,
                       const std::unordered_map<int,int>& hostSlotOfClient)
{
    int hostRef = ref;
    auto it = hostSlotOfClient.find(ref);
    if (it != hostSlotOfClient.end()) hostRef = it->second;

    buf.insert(buf.end(), (u8*)&hostRef, (u8*)&hostRef + 4);
    if (ref < 0 || ref >= (int)w.refs.size()) {
        u8 l = 0; buf.push_back(l); u32 z = 0;
        buf.insert(buf.end(), (u8*)&z, (u8*)&z + 4);
        return;
    }
    const Ref& r = w.refs[ref];
    if (r.cell < 0) {
        u8 l = 0; buf.push_back(l); u32 z = 0;
        buf.insert(buf.end(), (u8*)&z, (u8*)&z + 4);
        return;
    }
    const LevelCell& lc = w.cells[r.cell];
    u8 len = (u8)lc.file.size();
    buf.push_back(len);
    buf.insert(buf.end(), lc.file.c_str(), lc.file.c_str() + len);
    u32 inCell = (u32)(ref - lc.refBase);
    buf.insert(buf.end(), (u8*)&inCell, (u8*)&inCell + 4);
}

static const u8* mpReadRefId(const u8* p, const u8* end, int& hostSlot,
                             std::string& cellFile, int& refInCell)
{
    if (p + 4 > end) return nullptr;
    memcpy(&hostSlot, p, 4); p += 4;
    if (p >= end) return nullptr;
    u8 len = *p++;
    if (p + len + 4 > end) return nullptr;
    cellFile.assign((const char*)p, len); p += len;
    u32 ic; memcpy(&ic, p, 4); p += 4;
    refInCell = (int)ic;
    return p;
}

// Route: host broadcasts; client sends to host only
static void mpSend(bool isHost, NetEngine& net, const std::vector<u8>& buf)
{
    if (isHost) net.broadcastMsg(NM_ITEMSYNC, buf.data(), buf.size());
    else        net.sendMsg(NM_ITEMSYNC, buf.data(), buf.size());
}

void Session::mpBroadcastItemTaken(int ref)
{
    if (!net.isConnected()) return;
    if (mpMode != 1 && mpMode != 2) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    const Ref& r = w.refs[ref];
    std::vector<u8> buf;
    buf.push_back(0);                            // subtype = taken
    buf.push_back(mpMode == 2 ? 1 : 0);          // isRequest
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    // id + count so host can REJECT with enough info if the ref is already gone
    std::string id = r.idLower.str();
    if (id.empty()) id = r.id.str();
    u8 idLen = (u8)std::min((size_t)255, id.size());
    buf.push_back(idLen);
    buf.insert(buf.end(), id.begin(), id.begin() + idLen);
    int count = r.count > 0 ? r.count : 1;
    buf.insert(buf.end(), (u8*)&count, (u8*)&count + 4);
    mpSend(mpMode == 1, net, buf);
}

void Session::mpBroadcastItemDropped(int ref)
{
    if (!net.isConnected()) return;
    if (mpMode != 1 && mpMode != 2) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    const Ref& r = w.refs[ref];
    std::vector<u8> buf;
    buf.push_back(1);                            // subtype = dropped
    buf.push_back(mpMode == 2 ? 1 : 0);
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    u8 idLen = (u8)r.idLower.size();
    buf.push_back(idLen);
    buf.insert(buf.end(), r.idLower.c_str(), r.idLower.c_str() + idLen);
    int nItems = r.count;
    buf.insert(buf.end(), (u8*)&nItems, (u8*)&nItems + 4);
    buf.insert(buf.end(), (u8*)r.pos, (u8*)r.pos + 12);
    float yaw = r.rot[2];
    buf.insert(buf.end(), (u8*)&yaw, (u8*)&yaw + 4);
    int cnd = r.dropState.condition;
    buf.insert(buf.end(), (u8*)&cnd, (u8*)&cnd + 4);
    u8 soulLen = (u8)r.dropState.soul.size();
    buf.push_back(soulLen);
    buf.insert(buf.end(), r.dropState.soul.begin(), r.dropState.soul.end());
    float chg = r.dropState.charge;
    buf.insert(buf.end(), (u8*)&chg, (u8*)&chg + 4);
    mpSend(mpMode == 1, net, buf);
}

void Session::mpBroadcastContainerChanged(int ref)
{
    if (!net.isConnected()) return;
    if (mpMode != 1 && mpMode != 2) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    if (mpMode == 1)
        mpDirtyContainers.insert(ref);
    const Ref& r = w.refs[ref];
    std::vector<u8> buf;
    buf.push_back(3);                            // subtype = contents
    buf.push_back(mpMode == 2 ? 1 : 0);
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    u32 n = (u32)r.contents.size();
    buf.insert(buf.end(), (u8*)&n, (u8*)&n + 4);
    for (auto& c : r.contents) {
        u8 idLen = (u8)c.second.size();
        buf.push_back(idLen);
        buf.insert(buf.end(), c.second.begin(), c.second.end());
        int stack = c.first;
        buf.insert(buf.end(), (u8*)&stack, (u8*)&stack + 4);
        int cc = c.condition;
        buf.insert(buf.end(), (u8*)&cc, (u8*)&cc + 4);
        u8 soulLen = (u8)c.soul.size();
        buf.push_back(soulLen);
        buf.insert(buf.end(), c.soul.begin(), c.soul.end());
        float chg = c.charge;
        buf.insert(buf.end(), (u8*)&chg, (u8*)&chg + 4);
    }
    mpSend(mpMode == 1, net, buf);
}

/* ==========================================================================
 * Late-join world snapshot: host dumps current deltas to one peer.
 * Reuses NM_ITEMSYNC / NM_NPCSTATE / NM_WEATHER / NM_WORLDEVENT layouts so
 * the client applies them with the existing handlers.
 * ========================================================================== */
void Session::mpSendWorldSnapshot(int peer)
{
    if (mpMode != 1 || !net.isConnected()) return;
    if (peer < 0 || peer >= NetEngine::kMaxPeers) return;

    int nTaken = 0, nDrop = 0, nCont = 0, nNpc = 0, nDoor = 0;

    auto sendItem = [&](const std::vector<u8>& buf) {
        net.sendMsgTo(peer, NM_ITEMSYNC, buf.data(), (u32)buf.size());
    };

    // --- Taken / disabled fixed world items ---
    for (int i = 0; i < (int)w.refs.size(); i++) {
        const Ref& r = w.refs[i];
        if (r.cell < 0) continue;
        if (r.spawnedRef) continue;   // drops handled below
        if (!r.pickedUp && r.enabled) continue;

        std::vector<u8> buf;
        buf.push_back(r.pickedUp ? (u8)0 : (u8)2);  // taken or disabled
        buf.push_back(0);                            // STATE
        mpPutRefId(buf, w, i, mpHostSlotOfClientRef);
        sendItem(buf);
        nTaken++;
    }

    // --- Live player/script drops still in the world ---
    for (int i : w.spawned) {
        if (i < 0 || i >= (int)w.refs.size()) continue;
        const Ref& r = w.refs[i];
        if (!r.dropped || !r.visible()) continue;

        std::vector<u8> buf;
        buf.push_back(1);  // dropped
        buf.push_back(0);
        mpPutRefId(buf, w, i, mpHostSlotOfClientRef);
        u8 idLen = (u8)r.idLower.size();
        buf.push_back(idLen);
        buf.insert(buf.end(), r.idLower.c_str(), r.idLower.c_str() + idLen);
        int nItems = r.count;
        buf.insert(buf.end(), (u8*)&nItems, (u8*)&nItems + 4);
        buf.insert(buf.end(), (u8*)r.pos, (u8*)r.pos + 12);
        float yaw = r.rot[2];
        buf.insert(buf.end(), (u8*)&yaw, (u8*)&yaw + 4);
        int cnd = r.dropState.condition;
        buf.insert(buf.end(), (u8*)&cnd, (u8*)&cnd + 4);
        u8 soulLen = (u8)r.dropState.soul.size();
        buf.push_back(soulLen);
        buf.insert(buf.end(), r.dropState.soul.begin(), r.dropState.soul.end());
        float chg = r.dropState.charge;
        buf.insert(buf.end(), (u8*)&chg, (u8*)&chg + 4);
        sendItem(buf);
        nDrop++;
    }

    // --- Containers the host (or a client via request) has changed ---
    for (int ref : mpDirtyContainers) {
        if (ref < 0 || ref >= (int)w.refs.size()) continue;
        const Ref& r = w.refs[ref];
        if (r.cell < 0) continue;
        std::vector<u8> buf;
        buf.push_back(3);
        buf.push_back(0);
        mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
        u32 n = (u32)r.contents.size();
        buf.insert(buf.end(), (u8*)&n, (u8*)&n + 4);
        for (auto& c : r.contents) {
            u8 idLen = (u8)c.second.size();
            buf.push_back(idLen);
            buf.insert(buf.end(), c.second.begin(), c.second.end());
            int stack = c.first;
            buf.insert(buf.end(), (u8*)&stack, (u8*)&stack + 4);
            int cc = c.condition;
            buf.insert(buf.end(), (u8*)&cc, (u8*)&cc + 4);
            u8 soulLen = (u8)c.soul.size();
            buf.push_back(soulLen);
            buf.insert(buf.end(), c.soul.begin(), c.soul.end());
            float chg = c.charge;
            buf.insert(buf.end(), (u8*)&chg, (u8*)&chg + 4);
        }
        sendItem(buf);
        nCont++;
    }

    // --- NPCs currently loaded on the host (full dump, not range-filtered), grouped per cell ---
    {
        std::map<int, std::vector<int>> byCell;
        for (int i : w.loadedActors) {
            const Ref& r = w.refs[i];
            if (r.actor < 0 || r.cell < 0 || r.cell >= (int)w.cells.size()) continue;
            const LevelCell& lc = w.cells[r.cell];
            if (!lc.refsLoaded || i < lc.refBase || i >= lc.refBase + lc.refCount) continue;
            byCell[r.cell].push_back(i);
            nNpc++;
        }
        for (auto& kv : byCell) mpSendNpcGroup(peer, kv.first, kv.second);
    }

    // --- Weather + time ---
    {
        u32 weatherNow = (u32)w.weatherNow;
        u32 weatherNext = (u32)w.weatherNext;
        float blend = w.weatherBlend;
        float gameHour = w.gameHour;
        std::vector<u8> buf(16);
        memcpy(buf.data(), &weatherNow, 4);
        memcpy(buf.data() + 4, &weatherNext, 4);
        memcpy(buf.data() + 8, &blend, 4);
        memcpy(buf.data() + 12, &gameHour, 4);
        net.sendMsgTo(peer, NM_WEATHER, buf.data(), 16);
    }

    // --- Doors that are open / moving (grouped per cell, stable ids) ---
    mpSendDoorGroups(peer);

    // --- Host companion dressable gear (if any) ---
    mpSendCompanionGear(peer);

    // Marker so the client can log / UI that the dump finished
    {
        u8 one = 1;
        net.sendMsgTo(peer, NM_SNAPSHOT, &one, 1);
    }

    logf("mp-snapshot: peer %d taken=%d drop=%d cont=%d npc=%d door=%d",
         peer, nTaken, nDrop, nCont, nNpc, nDoor);
    chat.addMessage("net", "sent world snapshot to peer " + std::to_string(peer));
}

/* ==========================================================================
 * Combat authority
 *   sub 0 = NPC_STATE   host -> all   (health, fatigue, dead + optional dmg FX)
 *   sub 1 = NPC_REQUEST client -> host (apply this damage on host)
 *   sub 2 = PLAYER_STATE either -> peers (local player's HP/death)
 * ========================================================================== */
void Session::mpSendNpcDamageRequest(int ref, float dmg, bool fatigueOnly)
{
    // Legacy path kept for any remaining callers; new code uses mpSendSwingRequest.
    if (!net.isConnected() || mpMode != 2) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    std::vector<u8> buf;
    buf.push_back(1);  // NPC_REQUEST (legacy: pre-rolled damage)
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    buf.insert(buf.end(), (u8*)&dmg, (u8*)&dmg + 4);
    u8 ft = fatigueOnly ? 1 : 0;
    buf.push_back(ft);
    net.sendMsg(NM_COMBAT, buf.data(), (u32)buf.size());
    logf("mp-combat: CLIENT request dmg=%.1f ref=%d fatigue=%d", dmg, ref, fatigueOnly ? 1 : 0);
}

// Client → host: swing intent. Host rolls hit chance and final damage.
// Layout: u8 sub=4, refId, f32 charge, u8 attackKind, u8 flags(unarmed),
//         f32 attackTerm, f32 strength, f32 skillVal, f32 condRatio, char weaponId[24]
void Session::mpSendSwingRequest(int ref, float charge, int attackKind, bool unarmed,
                                 float attackTerm, float strength, float skillVal,
                                 float condRatio, const std::string& weaponId)
{
    if (!net.isConnected() || mpMode != 2) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    std::vector<u8> buf;
    buf.push_back(4);  // SWING_REQUEST
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    buf.insert(buf.end(), (u8*)&charge, (u8*)&charge + 4);
    buf.push_back((u8)(attackKind < 0 ? 0 : attackKind > 2 ? 2 : attackKind));
    buf.push_back(unarmed ? 1 : 0);
    buf.insert(buf.end(), (u8*)&attackTerm, (u8*)&attackTerm + 4);
    buf.insert(buf.end(), (u8*)&strength, (u8*)&strength + 4);
    buf.insert(buf.end(), (u8*)&skillVal, (u8*)&skillVal + 4);
    buf.insert(buf.end(), (u8*)&condRatio, (u8*)&condRatio + 4);
    char wid[24] = {};
    memcpy(wid, weaponId.data(), std::min(weaponId.size(), sizeof(wid) - 1));
    buf.insert(buf.end(), (u8*)wid, (u8*)wid + 24);
    net.sendMsg(NM_COMBAT, buf.data(), (u32)buf.size());
    logf("mp-combat: CLIENT swing request ref=%d charge=%.2f kind=%d unarmed=%d term=%.1f",
         ref, charge, attackKind, unarmed ? 1 : 0, attackTerm);
}

// Host → swinging client: result of the authoritative roll
// Layout: u8 sub=5, refId, u8 result (0=miss 1=hit 2=blocked 3=glance 4=crit), f32 chance, f32 dmgShown
void Session::mpSendSwingResult(int peer, int ref, u8 result, float chance, float dmgShown)
{
    if (!net.isConnected() || mpMode != 1) return;
    if (peer < 0 || peer >= NetEngine::kMaxPeers) return;
    // ref may be -1 for wall/miss with no target; still notify the swinging peer
    std::vector<u8> buf;
    buf.push_back(5);  // SWING_RESULT
    if (ref >= 0 && ref < (int)w.refs.size())
        mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    else {
        // empty identity so client can still parse
        int neg = -1;
        buf.insert(buf.end(), (u8*)&neg, (u8*)&neg + 4);
        buf.push_back(0); // cell file len 0
        u32 z = 0;
        buf.insert(buf.end(), (u8*)&z, (u8*)&z + 4);
    }
    buf.push_back(result);
    buf.insert(buf.end(), (u8*)&chance, (u8*)&chance + 4);
    buf.insert(buf.end(), (u8*)&dmgShown, (u8*)&dmgShown + 4);
    net.sendMsgTo(peer, NM_COMBAT, buf.data(), (u32)buf.size());
}

// Host → all peers: authoritative bounty (crime gold)
// Layout: u8 sub=6, i32 bounty
void Session::mpBroadcastBounty()
{
    if (!net.isConnected() || mpMode != 1) return;
    std::vector<u8> buf;
    buf.push_back(6);  // BOUNTY_STATE
    int b = w.bounty;
    buf.insert(buf.end(), (u8*)&b, (u8*)&b + 4);
    net.broadcastMsg(NM_COMBAT, buf.data(), (u32)buf.size());
}

void Session::mpBroadcastNpcCombat(int ref, float dmgShown, bool fatigueOnly)
{
    if (!net.isConnected() || mpMode != 1) return;
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    const Ref& r = w.refs[ref];
    std::vector<u8> buf;
    buf.push_back(0);  // NPC_STATE
    mpPutRefId(buf, w, ref, mpHostSlotOfClientRef);
    float hp = r.health, fat = r.fatigue;
    buf.insert(buf.end(), (u8*)&hp, (u8*)&hp + 4);
    buf.insert(buf.end(), (u8*)&fat, (u8*)&fat + 4);
    u8 flags = 0;
    if (r.dead) flags |= 1;
    if (fatigueOnly) flags |= 2;
    buf.push_back(flags);
    buf.insert(buf.end(), (u8*)&dmgShown, (u8*)&dmgShown + 4);
    // death group so clients play the same corpse pose
    char dg[16];
    memcpy(dg, r.deathGroup, 16);
    buf.insert(buf.end(), (u8*)dg, (u8*)dg + 16);
    // Knockdown / fatigue state (clients must keep the body on the floor)
    float kt = r.knockTimer;
    buf.insert(buf.end(), (u8*)&kt, (u8*)&kt + 4);
    u8 kflags = 0;
    if (r.outCold) kflags |= 1;
    if (r.knockedOut) kflags |= 2;
    buf.push_back(kflags);
    net.broadcastMsg(NM_COMBAT, buf.data(), (u32)buf.size());
}

void Session::mpBroadcastPlayerCombat()
{
    if (!net.isConnected() || (mpMode != 1 && mpMode != 2)) return;
    std::vector<u8> buf;
    buf.push_back(2);  // PLAYER_STATE
    float hp = w.stats.health, fat = w.stats.fatigue;
    buf.insert(buf.end(), (u8*)&hp, (u8*)&hp + 4);
    buf.insert(buf.end(), (u8*)&fat, (u8*)&fat + 4);
    u8 dead = playerDead ? 1 : 0;
    buf.push_back(dead);
    float kt = w.player.knockTimer;
    buf.insert(buf.end(), (u8*)&kt, (u8*)&kt + 4);
    if (mpMode == 1)
        net.broadcastMsg(NM_COMBAT, buf.data(), (u32)buf.size());
    else
        net.sendMsg(NM_COMBAT, buf.data(), (u32)buf.size());
}

void Session::mpSendPlayerDamage(int peer, float dmg, bool fatigueOnly)
{
    if (!net.isConnected() || mpMode != 1) return;
    if (peer < 0 || peer >= NetEngine::kMaxPeers) return;
    std::vector<u8> buf;
    buf.push_back(3);  // PLAYER_DAMAGE (host -> one peer)
    buf.insert(buf.end(), (u8*)&dmg, (u8*)&dmg + 4);
    u8 ft = fatigueOnly ? 1 : 0;
    buf.push_back(ft);
    net.sendMsgTo(peer, NM_COMBAT, buf.data(), (u32)buf.size());
    logf("mp-combat: HOST hits remote peer %d for %.1f%s", peer, dmg, fatigueOnly ? " fatigue" : "");
}

void Session::mpPickCombatTarget(const float npcPos[3])
{
    mpCombatTarget = -1;
    memcpy(mpCombatFeet, w.player.feet, sizeof(mpCombatFeet));
    mpCombatEyeZ = playerEyeZ(w.player);
    float best = 1e30f;
    bool any = false;
    if (!playerDead) {
        float dx = mpCombatFeet[0] - npcPos[0], dy = mpCombatFeet[1] - npcPos[1];
        best = dx * dx + dy * dy;
        any = true;
    }
    if (mpMode == 1 && net.isConnected()) {
        for (int i = 0; i < NetEngine::kMaxPeers; i++) {
            RemotePlayer& rp = remotePlayers[i];
            if (!rp.active || rp.dead) continue;
            float dx = rp.feet[0] - npcPos[0], dy = rp.feet[1] - npcPos[1];
            float d2 = dx * dx + dy * dy;
            if (!any || d2 < best) {
                best = d2;
                any = true;
                mpCombatTarget = i;
                memcpy(mpCombatFeet, rp.feet, sizeof(mpCombatFeet));
                mpCombatEyeZ = rp.feet[2] + 90.0f;
            }
        }
    }
    if (!any) {
        mpCombatTarget = -1;
        memcpy(mpCombatFeet, w.player.feet, sizeof(mpCombatFeet));
        mpCombatEyeZ = playerEyeZ(w.player);
    }
}

void Session::mpApplyCombat(const u8* data, u32 len, int peer)
{
    if (len < 1) return;
    u8 sub = data[0];
    const u8* p = data + 1;
    const u8* end = data + len;

    if (sub == 1) {
        // Legacy: client sent pre-rolled damage. Prefer sub==4 swing request.
        if (mpMode != 1) return;
        int hostSlot = -1;
        std::string cellFile;
        int refInCell = -1;
        p = mpReadRefId(p, end, hostSlot, cellFile, refInCell);
        if (!p || p + 4 + 1 > end) return;
        float dmg = 0;
        memcpy(&dmg, p, 4); p += 4;
        bool fatigueOnly = (*p++) != 0;
        int ref = mpResolveRef(cellFile, refInCell);
        if (ref < 0 && hostSlot >= 0 && hostSlot < (int)w.refs.size())
            ref = hostSlot;
        if (ref < 0) {
            logf("mp-combat: HOST could not resolve damage request");
            return;
        }
        makeHostile(ref);
        w.refs[ref].attacked = true;
        damageNpc(ref, dmg, fatigueOnly);
        return;
    }

    if (sub == 4) {
        // Host: authoritative swing resolve from client
        if (mpMode != 1) return;
        int hostSlot = -1;
        std::string cellFile;
        int refInCell = -1;
        p = mpReadRefId(p, end, hostSlot, cellFile, refInCell);
        // charge(4) + kind(1) + flags(1) + term(4) + str(4) + skill(4) + cond(4) + wid(24) = 46
        if (!p || p + 46 > end) return;
        float charge = 0, attackTerm = 0, strength = 0, skillVal = 0, condRatio = 1;
        memcpy(&charge, p, 4); p += 4;
        int attackKind = *p++;
        bool unarmed = (*p++) != 0;
        memcpy(&attackTerm, p, 4); p += 4;
        memcpy(&strength, p, 4); p += 4;
        memcpy(&skillVal, p, 4); p += 4;
        memcpy(&condRatio, p, 4); p += 4;
        char wid[25] = {};
        memcpy(wid, p, 24);
        int ref = mpResolveRef(cellFile, refInCell);
        if (ref < 0 && hostSlot >= 0 && hostSlot < (int)w.refs.size())
            ref = hostSlot;
        if (ref < 0) {
            logf("mp-combat: HOST could not resolve swing request");
            return;
        }
        int fromPeer = peer >= 0 ? peer : 0;
        hostApplyClientSwing(fromPeer, ref, charge, attackKind, unarmed,
                             attackTerm, strength, skillVal, condRatio, wid);
        return;
    }

    if (sub == 0) {
        // Client (or other peers): absolute NPC health/death from host
        if (mpMode == 1) return;
        int hostSlot = -1;
        std::string cellFile;
        int refInCell = -1;
        p = mpReadRefId(p, end, hostSlot, cellFile, refInCell);
        if (!p || p + 4 + 4 + 1 + 4 > end) return;
        float hp, fat, dmgShown;
        memcpy(&hp, p, 4); p += 4;
        memcpy(&fat, p, 4); p += 4;
        u8 flags = *p++;
        memcpy(&dmgShown, p, 4); p += 4;
        char dg[16] = "Death1";
        if (p + 16 <= end)
            memcpy(dg, p, 16);
        int ref = mpResolveDrop(hostSlot);
        if (ref < 0) ref = mpResolveRef(cellFile, refInCell);
        if (ref < 0 && hostSlot >= 0 && hostSlot < (int)w.refs.size())
            ref = hostSlot;
        if (ref < 0 || ref >= (int)w.refs.size()) return;
        Ref& r = w.refs[ref];
        r.health = hp;
        r.fatigue = fat;
        r.synced = true;
        bool nowDead = (flags & 1) != 0;
        bool fatigueOnly = (flags & 2) != 0;
        if (dmgShown > 0.0f) {
            if (!fatigueOnly) {
                playSound(ref, "Health Damage");
                int blood = r.actor >= 0 ? w.game.actors[r.actor].blood : 0;
                float at[3] = { r.pos[0], r.pos[1], r.pos[2] + 80.0f };
                spawnVfx("blood" + std::to_string(blood >= 0 && blood < 3 ? blood : 0), at, 0.5f);
            } else
                playSound(ref, "Hand To Hand Hit");
            char n[16];
            snprintf(n, sizeof(n), "%.0f", dmgShown);
            addIndicator(n, fatigueOnly ? 0x33cc4c : 0xff334c);
        }
        // Optional knockdown tail (newer hosts always send it)
        float knockTimer = -1.0f;
        bool outCold = false, knockedOut = false;
        if (p + 4 + 1 <= end) {
            memcpy(&knockTimer, p, 4); p += 4;
            u8 kflags = *p++;
            outCold = (kflags & 1) != 0;
            knockedOut = (kflags & 2) != 0;
        }

        if (nowDead && !r.dead) {
            memcpy(r.deathGroup, dg, 16);
            r.dead = r.died = true;
            r.health = 0.0f;
            r.ai = AI_IDLE;
            r.knockTimer = 0.0f;
            r.outCold = false;
            if (Actor* a = w.actorOf(ref)) {
                ActorSet* set = w.actorsOf(ref);
                if (set) {
                    a->showWeapon = false;
                    actorPlay(*set, *a, r.deathGroup, ANIM_HOLD);
                }
            }
            playSound(ref, "Body Fall Medium");
            logf("mp-combat: CLIENT NPC %s died (host)", r.id.c_str());
        } else if (!nowDead && knockTimer > 0.0f) {
            // Host says this NPC is down / out — play the pose if we just entered it
            bool wasDown = r.knockTimer > 0.0f;
            r.knockTimer = knockTimer;
            r.outCold = outCold;
            r.knockedOut = knockedOut;
            if (!wasDown && w.actorOf(ref)) {
                ActorSet* set = w.actorsOf(ref);
                if (set) {
                    const char* grp = outCold ? "KnockOut" : "KnockDown";
                    if (!actorPlay(*set, *w.actorOf(ref), grp, ANIM_HOLD))
                        actorPlay(*set, *w.actorOf(ref), "KnockDown", ANIM_HOLD);
                    playSound(ref, "Body Fall Medium");
                }
            }
        } else if (!nowDead && knockTimer == 0.0f && r.knockTimer > 0.0f) {
            // Host cleared knockdown — stand back up
            r.knockTimer = 0.0f;
            r.outCold = false;
            r.knockedOut = false;
            if (w.actorOf(ref))
                actorPlay(*w.actorsOf(ref), *w.actorOf(ref), "Idle", ANIM_IDLE);
        } else if (!nowDead && r.health > 0.0f && dmgShown > 0.0f && w.actorOf(ref)
                   && r.knockTimer <= 0.0f) {
            std::string g = actorRandomGroup(*w.actorsOf(ref), *w.actorOf(ref), "Hit");
            actorPlay(*w.actorsOf(ref), *w.actorOf(ref), g.empty() ? "Hit1" : g.c_str(), ANIM_ONCE);
        } else if (knockTimer >= 0.0f) {
            // Keep timer in sync while already down (host is authority)
            r.knockTimer = knockTimer;
            r.outCold = outCold;
            r.knockedOut = knockedOut;
        }
        return;
    }

    if (sub == 2) {
        // Remote player's HP / death / knockdown
        if (p + 4 + 4 + 1 > end) return;
        float hp, fat;
        memcpy(&hp, p, 4); p += 4;
        memcpy(&fat, p, 4); p += 4;
        bool dead = (*p++) != 0;
        float knockTimer = 0.0f;
        if (p + 4 <= end)
            memcpy(&knockTimer, p, 4);
        // Single remote peer in current prototype: slot 0 on both sides for the other player
        int slot = 0;
        if (slot >= 0 && slot < NetEngine::kMaxPeers) {
            remotePlayers[slot].health = hp;
            remotePlayers[slot].fatigue = fat;
            remotePlayers[slot].knockTimer = knockTimer;
            bool wasDead = remotePlayers[slot].dead;
            remotePlayers[slot].dead = dead;
            if (dead && !wasDead) {
                std::string nm = remotePlayers[slot].name.empty() ? "a player" : remotePlayers[slot].name;
                chat.addMessage("net", nm + " has fallen");
                notify(nm + " has fallen.");
            } else if (!dead && wasDead) {
                std::string nm = remotePlayers[slot].name.empty() ? "a player" : remotePlayers[slot].name;
                chat.addMessage("net", nm + " has returned");
                notify(nm + " has returned.");
                remotePlayers[slot].knockTimer = 0.0f;
            }
            logf("mp-combat: remote player HP=%.0f fat=%.0f knock=%.1f dead=%d",
                 hp, fat, knockTimer, dead ? 1 : 0);
        }
        return;
    }

    if (sub == 3) {
        // Host dealt damage to this client — apply locally (armor already simplified on host)
        if (mpMode != 2) return;
        if (p + 4 + 1 > end) return;
        float dmg = 0;
        memcpy(&dmg, p, 4); p += 4;
        bool fatigueOnly = (*p++) != 0;
        logf("mp-combat: CLIENT took %.1f from host NPC", dmg);
        damagePlayer(dmg, fatigueOnly);
        // Fatigue KO on the client (host does not run npcHitsPlayer for remote)
        if (!playerDead && w.stats.fatigue <= 0.0f && w.player.knockTimer <= 0.0f) {
            w.player.knockTimer = 3.0f;
            if (vm.action != VM_KNOCKDOWN)
                vm.play(VM_KNOCKDOWN, "KnockOut");
        }
        if ((mpMode == 1 || mpMode == 2) && net.isConnected())
            mpBroadcastPlayerCombat();
        return;
    }

    if (sub == 5) {
        // Client: host's authoritative swing/shot result (miss / blocked / etc.)
        if (mpMode != 2) return;
        int hostSlot = -1;
        std::string cellFile;
        int refInCell = -1;
        p = mpReadRefId(p, end, hostSlot, cellFile, refInCell);
        if (!p || p + 1 + 4 + 4 > end) return;
        u8 result = *p++;
        float chance = 0, dmgShown = 0;
        memcpy(&chance, p, 4); p += 4;
        memcpy(&dmgShown, p, 4); p += 4;
        int ref = mpResolveDrop(hostSlot);
        if (ref < 0) ref = mpResolveRef(cellFile, refInCell);
        if (ref < 0 && hostSlot >= 0 && hostSlot < (int)w.refs.size())
            ref = hostSlot;
        // Crime is host-authoritative; client only shows feedback + local hostility
        // 0=miss 1=hit 2=blocked 3=glance 4=crit
        if (result == 0) {
            addIndicator("Miss (" + std::to_string((int)fmaxf(0.0f, chance)) + "%)", 0xffffff);
            if (ref >= 0 && ref < (int)w.refs.size())
                makeHostile(ref);
        } else if (result == 1 || result == 3 || result == 4) {
            // Skill progress for the blow/shot the host confirmed
            if (result == 4)
                addIndicator("Critical!", 0xffcc33);
            else if (result == 3)
                addIndicator("Glance", 0xcccccc);
            if (result == 4 && ref >= 0)
                playSound(ref, "critical damage");
            // Train the weapon skill that was used (prefer Marksman if a shot, else last attack skill)
            int sk = weaponSkill(playerWeapon());
            if (sk >= 0)
                useSkill(sk, 0, result == 3 ? 0.5f : 1.0f);
        } else if (result == 2) {
            addIndicator("Blocked", 0x88aaff);
            if (ref >= 0) playSound(ref, "Hand To Hand Hit 2");
        }
        // Hit VFX/numbers arrive via sub==0 NPC_STATE broadcast
        (void)dmgShown;
        return;
    }

    if (sub == 6) {
        // Client: host's authoritative bounty
        if (mpMode != 2) return;
        if (p + 4 > end) return;
        int b = 0;
        memcpy(&b, p, 4);
        if (b != w.bounty) {
            int old = w.bounty;
            w.bounty = b;
            w.globals["pccrimelevel"] = (float)w.bounty;
            if (b > old)
                notify("Crime reported. Your bounty is " + std::to_string(w.bounty) + " gold.");
            logf("mp-combat: CLIENT bounty set to %d (was %d)", b, old);
        }
        return;
    }
}

// Apply a mutation to a resolved ref. Returns true on success.
static int mpApplyMutation(World& w, u8 sub, int ref, const u8* p, const u8* end)
{
    if (sub == 0) {
        if (ref < 0) return -1;
        Ref& r = w.refs[ref];
        // Already claimed — pickup lock: second taker must be rejected
        if (r.pickedUp || (!r.enabled && !r.spawnedRef))
            return -1;
        r.pickedUp = true;
        if (r.spawnedRef) {
            // Runtime-created ref (the other peer's drop): remove it so
            // w.spawned / w.refs don't keep a ghost.
            w.despawn(ref);
        } else {
            w.setEnabled(ref, false);
        }
        return ref;
    } else if (sub == 2) {
        if (ref < 0) return false;
        w.setEnabled(ref, false);
        return ref;
    } else if (sub == 1) {
        if (p >= end) return false;
        u8 idLen = *p++;
        if (p + idLen > end) return false;
        std::string id((const char*)p, idLen); p += idLen;
        if (p + 4 + 12 + 4 + 4 + 1 + 4 > end) return false;
        int nItems = 0; memcpy(&nItems, p, 4); p += 4;
        float pos[3]; memcpy(pos, p, 12); p += 12;
        float yaw = 0; memcpy(&yaw, p, 4); p += 4;
        int cnd = -1; memcpy(&cnd, p, 4); p += 4;
        u8 soulLen = *p++;
        if (p + soulLen + 4 > end) return false;
        std::string soul((const char*)p, soulLen); p += soulLen;
        float chg = -1.0f; memcpy(&chg, p, 4); p += 4;
        InventoryItem it;
        it.id = id; it.count = nItems; it.equipped = false;
        it.condition = cnd; it.soul = soul; it.charge = chg;
        int c = w.current;
        if (c >= 0 && !w.cells[c].interior) {
            int g = w.gridCell((int)floorf(pos[0] / 8192.0f), (int)floorf(pos[1] / 8192.0f));
            if (g >= 0 && w.cells[g].live) c = g;
        }
        return w.dropItem(it, pos, yaw, c);   // the NEW host ref (>=0) or -1
    } else if (sub == 3) {
        if (ref < 0) return false;
        Ref& r = w.refs[ref];
        if (p + 4 > end) return false;
        u32 n = 0; memcpy(&n, p, 4); p += 4;
        r.contents.clear();
        for (u32 k = 0; k < n; k++) {
            if (p >= end) break;
            u8 idLen = *p++;
            if (p + idLen + 4 + 4 + 1 + 4 > end) break;
            std::string id((const char*)p, idLen); p += idLen;
            int stack = 0; memcpy(&stack, p, 4); p += 4;
            int cc = -1; memcpy(&cc, p, 4); p += 4;
            u8 soulLen = *p++;
            if (p + soulLen + 4 > end) break;
            std::string soul((const char*)p, soulLen); p += soulLen;
            float chg = -1.0f; memcpy(&chg, p, 4); p += 4;
            ContentItem ci(stack, id);
            ci.condition = cc; ci.soul = soul; ci.charge = chg;
            r.contents.push_back(std::move(ci));
        }
        return ref;
    }
    return -1;
}

void Session::mpApplyItemSync(const u8* data, u32 len, int peer)
{
    if (len < 2 + 4 + 1 + 4) return;
    u8 sub = data[0];
    u8 isRequest = data[1];
    const u8* p = data + 2;
    const u8* end = data + len;
    int hostSlot = -1;
    std::string cellFile;
    int refInCell = -1;
    p = mpReadRefId(p, end, hostSlot, cellFile, refInCell);
    if (!p) { logf("mp-items: short header"); return; }

    int ref = -1;
    if (mpMode == 1 && isRequest) {
        // Host receiving a REQUEST. Client local ref indices can differ
        // from the host's, so prefer stable (cell file, ref-in-cell) for
        // original world items; fall back to hostSlot (needed for items
        // the host previously dropped that the client mapped).
        // sub==1 (drop) ignores ref; a new local ref is created.
        ref = mpResolveRef(cellFile, refInCell);
        if (ref < 0 && hostSlot >= 0 && hostSlot < (int)w.refs.size())
            ref = hostSlot;
    } else if (mpMode == 2) {
        // Client receiving a STATE: drop map first, then cell+index
        ref = mpResolveDrop(hostSlot);
        if (ref < 0) ref = mpResolveRef(cellFile, refInCell);
    } else {
        ref = hostSlot;
    }

    // subtype 4 = TAKE_REJECT (host -> one client who lost the race)
    if (sub == 4 && mpMode == 2 && !isRequest) {
        // Body: u8 idLen, id, i32 count
        if (p >= end) return;
        u8 idLen = *p++;
        if (p + idLen + 4 > end) return;
        std::string id((const char*)p, idLen); p += idLen;
        int count = 1;
        memcpy(&count, p, 4);
        if (count < 1) count = 1;
        int removed = w.removeItem(id, count);
        logf("mp-items: CLIENT take rejected id=%s count=%d removed=%d", id.c_str(), count, removed);
        notify("Someone else took that.");
        return;
    }

    int applied = mpApplyMutation(w, sub, ref, p, end);
    logf("mp-items: %s sub=%d isReq=%d hostRef=%d cell=%s idx=%d -> ref=%d ok=%d",
         mpMode == 1 ? "HOST" : "CLIENT", sub, isRequest, hostSlot,
         cellFile.c_str(), refInCell, ref, applied);

    if (mpMode == 1 && isRequest && sub == 0 && applied < 0) {
        // Pickup lock: item already claimed — tell this peer to drop it from inv
        std::string id;
        int count = 1;
        // Prefer id from the request body (survives despawn)
        if (p < end) {
            u8 idLen = *p;
            if (p + 1 + idLen + 4 <= end) {
                p++;
                id.assign((const char*)p, idLen); p += idLen;
                memcpy(&count, p, 4);
                if (count < 1) count = 1;
            }
        }
        if (id.empty() && ref >= 0 && ref < (int)w.refs.size()) {
            id = w.refs[ref].idLower.str();
            if (id.empty()) id = w.refs[ref].id.str();
            count = w.refs[ref].count > 0 ? w.refs[ref].count : 1;
        }
        if (!id.empty()) {
            std::vector<u8> out;
            out.push_back(4);  // TAKE_REJECT
            out.push_back(0);
            mpPutRefId(out, w, ref >= 0 ? ref : hostSlot, mpHostSlotOfClientRef);
            u8 idLen = (u8)std::min((size_t)255, id.size());
            out.push_back(idLen);
            out.insert(out.end(), id.begin(), id.begin() + idLen);
            out.insert(out.end(), (u8*)&count, (u8*)&count + 4);
            if (peer >= 0)
                net.sendMsgTo(peer, NM_ITEMSYNC, out.data(), (u32)out.size());
            else
                net.broadcastMsg(NM_ITEMSYNC, out.data(), (u32)out.size());
            logf("mp-items: HOST reject take id=%s count=%d peer=%d", id.c_str(), count, peer);
        }
        return;
    }

    if (mpMode == 1 && isRequest && applied >= 0) {
        // Host: rebroadcast STATE to all peers
        if (sub == 3)
            mpDirtyContainers.insert(applied);
        std::vector<u8> out;
        out.push_back(sub);
        out.push_back(0);
        mpPutRefId(out, w, applied, mpHostSlotOfClientRef);
        out.insert(out.end(), p, end);
        net.broadcastMsg(NM_ITEMSYNC, out.data(), out.size());
        logf("mp-items: HOST rebroadcast sub=%d ref=%d", sub, ref);
    } else if (mpMode == 2 && !isRequest && applied >= 0) {
        // Client: remember host slot for this client ref so future REQUESTs
        // from this client send the right hostRef
        mpHostSlotOfClientRef[applied] = hostSlot;
        if (sub == 1) { mpDropMap[hostSlot] = applied; mpHostSlotOfClientRef[applied] = hostSlot; }
    }
}

void Session::onNetMessage(int peer, u8 tag, const u8* data, u32 len, void* user) {
    Session* s = (Session*)user;
    if (!s) return;
    if (tag == 0xFF) {
        if (peer >= 0 && peer < NetEngine::kMaxPeers) {
            s->remotePlayers[peer] = Session::RemotePlayer();
            s->mpPeerCellIdx[peer] = -1;
            s->chat.addMessage("net", "peer " + std::to_string(peer) + " disconnected");
        }
        return;
    }

    switch (tag) {
    case NM_HELLO:
        /* patch: mp hello */
        if (len >= 36) {
            char nm[33] = {};
            memcpy(nm, data + 4, 32);
            if (nm[0]) s->mpClientName = nm;
        }
        logf("mp: peer hello as '%s'", s->mpClientName.c_str());
        s->chat.addMessage("net", s->mpClientName + " connected");
        // Remember display name on the remote slot for this peer
        if (peer >= 0 && peer < NetEngine::kMaxPeers) {
            s->remotePlayers[peer].name = s->mpClientName;
            if (s->remotePlayers[peer].name.empty())
                s->remotePlayers[peer].name = "Player";
        }
        // Host: push current world deltas so a late joiner matches
        if (s->mpMode == 1)
            s->mpSendWorldSnapshot(peer);
        // Acknowledge join with host display name
        {
            char welcome[33] = {};
            strncpy(welcome, s->mpHostName.c_str(), 32);
            s->net.sendMsgTo(peer, NM_WELCOME, welcome, 32);
        }
        s->mpSendCell(peer);   // MPCELL: the joiner moves next to us once this arrives
        break;
    case NM_WELCOME:
        if (len >= 1) {
            char nm[33] = {};
            size_t n = len < 32 ? len : 32;
            memcpy(nm, data, n);
            if (nm[0]) {
                s->mpHostName = nm;  // for chat attribution when we are client
                s->remotePlayers[0].name = nm;
            }
        }
        s->chat.addMessage("net", "welcome from host");
        s->mpLastCellSent = s->w.current;
        s->mpSendCell(-1);     // MPCELL
        break;
    case NM_SNAPSHOT:
        // Host finished dumping world state for this join
        s->chat.addMessage("net", "world snapshot received");
        logf("mp-snapshot: apply complete on client");
        break;
    case NM_CHAT: {
        if (len < 3) break;
        u8 nameLen = data[0];
        if (1 + nameLen + 2 > len) break;
        std::string name((const char*)data + 1, nameLen);
        u16 textLen;
        memcpy(&textLen, data + 1 + nameLen, 2);
        if (1 + nameLen + 2 + textLen > len) break;
        std::string text((const char*)data + 1 + nameLen + 2, textLen);
        s->chat.addMessage(name, text);
        break;
    }
    case NM_PLAYERSTATE: {
        // Layout (see netSendPlayerState):
        //   char race[32], u8 female, char head[32], char hair[32],
        //   u8 wornCount, char worn[wornCount][32],
        //   float feet[3], float yaw, float pitch,
        //   u8 action, char group[24], float moveX, float moveY,
        //   u8 weaponOut
        const uint8_t* p = data;
        const uint8_t* end = data + len;
        auto takeField = [&](void* dst, size_t n) {
            if ((size_t)(end - p) < n) return false;
            memcpy(dst, p, n);
            p += n;
            return true;
        };
        auto takeStr = [&](std::string& dst, size_t n) {
            if ((size_t)(end - p) < n) return false;
            dst.assign((const char*)p);
            p += n;
            return true;
        };

        RemotePlayerDesc desc;
        uint8_t female = 0, wornCount = 0;
        if (!takeStr(desc.race, 32)) break;
        if (!takeField(&female, 1)) break;
        if (!takeStr(desc.head, 32)) break;
        if (!takeStr(desc.hair, 32)) break;
        if (!takeField(&wornCount, 1)) break;
        desc.female = female != 0;
        bool ok = true;
        for (uint8_t i = 0; i < wornCount && ok; i++)
        {
            std::string w;
            ok = takeStr(w, 32);
            if (ok) desc.worn.push_back(w);
        }
        if (!ok) break;

        float feet[3], yaw, pitch, moveX, moveY;
        if (!takeField(feet, 12)) break;
        if (!takeField(&yaw, 4)) break;
        if (!takeField(&pitch, 4)) break;
        uint8_t actAction = 0;
        if (!takeField(&actAction, 1)) break;
        BodyAct act;
        {
            std::string g;
            if (!takeStr(g, 24)) break;
            act.group = g;
        }
        act.action = (BodyAction)actAction;
        if (!takeField(&act.charge, 4)) break;
        if (!takeField(&act.speed, 4)) break;
        if (!takeField(&act.strength, 4)) break;
        {
            std::string st;
            if (!takeStr(st, 8)) break;
            act.stance = st;
        }
        if (!takeField(&moveX, 4)) break;
        if (!takeField(&moveY, 4)) break;
        float moveSpeed = 0;
        if (!takeField(&moveSpeed, 4)) moveSpeed = (moveX * moveX + moveY * moveY > 0.04f) ? 200.0f : 0.0f;
        uint8_t weaponOut = 0;
        if (!takeField(&weaponOut, 1)) break;

        /* patch: mp slot 0 -- 1:1 connections, one remote peer */
        s->applyRemotePlayerState(peer, desc, feet, yaw, pitch, act, moveX, moveY, moveSpeed, weaponOut != 0);
        break;
    }
    case NM_NPCSTATE:
        if (s->mpMode == 1) break;
        s->mpApplyNpcGroup(data, len);
        break;
    case NM_WEATHER: {
        if (s->mpMode == 1) break;
        if (len < 16) break;
        u32 weatherNow = 0, weatherNext = 0;
        float blend = 1.0f, gameHour = 9.0f;
        memcpy(&weatherNow, data, 4);
        memcpy(&weatherNext, data + 4, 4);
        memcpy(&blend, data + 8, 4);
        memcpy(&gameHour, data + 12, 4);
        s->syncApplyWeather(weatherNow, weatherNext, blend, gameHour);
        break;
    }
    case NM_WORLDEVENT:
        if (s->mpMode == 1) break;
        s->mpApplyDoorGroup(data, len);
        break;
    case NM_CELL:
        s->mpApplyCell(peer, data, len);
        break;
    case NM_PING:
        // no-op for now (keep stream in sync if a peer sends one)
        break;
    case NM_ITEMSYNC: {
        // Host must handle client REQUESTs (isRequest=1) and rebroadcast
        // STATE; client applies STATE (isRequest=0). Do not skip the host.
        s->mpApplyItemSync(data, len, peer);
        break;
    }
    case NM_COMBAT:
        s->mpApplyCombat(data, len, peer);
        break;
    case NM_PROJECTILE:
        s->mpApplyProjectile(data, len, peer);
        break;
    case NM_COMPANION:
        if (s->mpMode == 1) break;   // host already has the real companion
        s->mpApplyCompanionGear(data, len);
        break;
    }
}


// ---- Full world sync ----

static bool mpNearPlayerIn(const World& w, const Ref& r, int pcell, const float feet[3], float range)
{
    if (pcell < 0 || pcell >= (int)w.cells.size() || r.cell < 0 || r.cell >= (int)w.cells.size()) return false;
    const LevelCell& pc = w.cells[pcell];
    const LevelCell& rc = w.cells[r.cell];
    if (pc.interior != rc.interior) return false;            // an interior's coordinates mean nothing outside it
    if (pc.interior && pcell != r.cell) return false;        // interior: only that very cell
    float dx = r.pos[0] - feet[0], dy = r.pos[1] - feet[1];
    return dx * dx + dy * dy <= range * range;
}

// In reach of the host's player or of any connected peer (in the cell that peer told us it is in)
bool Session::mpNearAnyPlayer(const Ref& r) const
{
    const float range = 2000.0f;
    if (mpNearPlayerIn(w, r, w.current, w.player.feet, range)) return true;
    for (int i = 0; i < NetEngine::kMaxPeers; i++)
        if (remotePlayers[i].active && mpPeerCellIdx[i] >= 0
            && mpNearPlayerIn(w, r, mpPeerCellIdx[i], remotePlayers[i].feet, range))
            return true;
    return false;
}

void Session::worldSyncUpdate(float dt) {
    (void)dt;
    if (!net.isConnected() || (mpMode != 1 && mpMode != 2)) return;

    u64 now = osGetTime();

    // MPCELL: tell the other side which cell we are in whenever it changes
    if (w.current >= 0 && w.current != mpLastCellSent) {
        mpLastCellSent = w.current;
        mpSendCell(-1);
    }
    if (mpMode == 2) { mpClientTick(now); return; }

    // ---- NPCs (worldSyncHz per second): everything near the host player or near any peer, one message per cell ----
    if (now - lastNpcSync >= (u64)(1000 / worldSyncHz)) {
        lastNpcSync = now;
        std::map<int, std::vector<int>> byCell;
        for (int i : w.loadedActors) {
            const Ref& r = w.refs[i];
            if (r.actor < 0 || !r.visible()) continue;
            if (r.cell < 0 || r.cell >= (int)w.cells.size()) continue;
            const LevelCell& lc = w.cells[r.cell];
            if (!lc.refsLoaded || i < lc.refBase || i >= lc.refBase + lc.refCount) continue;   // (spawned: no stable id)
            if (!mpNearAnyPlayer(r)) continue;
            byCell[r.cell].push_back(i);
        }
        // Always include the host companion even if outside the usual range filter
        if (companionRef >= 0 && companionRef < (int)w.refs.size()) {
            const Ref& cr = w.refs[companionRef];
            if (cr.actor >= 0 && cr.visible() && cr.cell >= 0 && cr.cell < (int)w.cells.size()) {
                const LevelCell& lc = w.cells[cr.cell];
                if (lc.refsLoaded && companionRef >= lc.refBase && companionRef < lc.refBase + lc.refCount) {
                    auto& list = byCell[cr.cell];
                    if (std::find(list.begin(), list.end(), companionRef) == list.end())
                        list.push_back(companionRef);
                }
            }
        }
        for (auto& kv : byCell) mpSendNpcGroup(-1, kv.first, kv.second);
    }

    // ---- Weather + time (1 Hz) ----
    if (now - lastWeatherSync >= 1000) {
        lastWeatherSync = now;
        u32 weatherNow = (u32)w.weatherNow;
        u32 weatherNext = (u32)w.weatherNext;
        float blend = w.weatherBlend;
        float gameHour = w.gameHour;
        std::vector<u8> buf(16);
        memcpy(buf.data(), &weatherNow, 4);
        memcpy(buf.data() + 4, &weatherNext, 4);
        memcpy(buf.data() + 8, &blend, 4);
        memcpy(buf.data() + 12, &gameHour, 4);
        net.broadcastMsg(NM_WEATHER, buf.data(), 16);
    }

    // ---- Doors (once a second: any non-swinging door that's opening or closing) ----
    static u64 lastDoorSync = 0;
    if (now - lastDoorSync >= 1000) {
        lastDoorSync = now;
        mpSendDoorGroups(-1);
    }
}

/* Wire format (MPCELL, replaces the raw World::refs slot numbers, which differ between the two consoles):
 *   NM_NPCSTATE:  u8 fileLen, char cellFile[fileLen], u32 count,
 *                 count x { u32 refInCell, f32 pos[3], f32 yaw, f32 time, s32 group, u8 mode, f32 health,
 *                           u8 alive, char deathGroup[16], f32 knockTimer, u8 knockFlags }
 *   NM_WORLDEVENT: u8 fileLen, char cellFile[fileLen], u32 count, count x { u32 refInCell, f32 doorTarget, f32 doorAngle }
 *   NM_CELL:      u8 fileLen, char cellFile[fileLen], f32 feet[3], f32 yaw
 * The cell file name + the index inside that cell's reference list are the same on both machines.
 * mode = AnimMode (0=IDLE, 1=LOOP, 2=ONCE, 3=HOLD) so attack/hit/death anims play correctly on clients.
 * knockFlags: bit0=outCold, bit1=knockedOut.
 * flags2: bit0=ally, bit1=AIFollow/Escort player, bit2=aiActive (companion / follower sync). */
static const size_t kNpcEntryBytes = 4 + 12 + 4 + 4 + 4 + 1 + 4 + 1 + 16 + 4 + 1 + 1;

void Session::mpSendNpcGroup(int peer, int cell, const std::vector<int>& refs)
{
    if (cell < 0 || cell >= (int)w.cells.size() || refs.empty()) return;
    const LevelCell& lc = w.cells[cell];
    const size_t kChunk = 600;      // stays far under the 64 KB frame limit
    for (size_t from = 0; from < refs.size(); from += kChunk) {
        size_t to = std::min(refs.size(), from + kChunk);
        std::vector<u8> buf;
        auto put = [&](const void* p, size_t n) {
            size_t off = buf.size(); buf.resize(off + n);
            memcpy(buf.data() + off, p, n);
        };
        u8 flen = (u8)std::min<size_t>(lc.file.size(), 255);
        buf.push_back(flen);
        put(lc.file.c_str(), flen);
        u32 count = (u32)(to - from);
        put(&count, 4);
        for (size_t k = from; k < to; k++) {
            int i = refs[k];
            const Ref& r = w.refs[i];
            u32 inCell = (u32)(i - lc.refBase);
            put(&inCell, 4);
            put(r.pos, 12);
            float yaw = r.rot[2];
            put(&yaw, 4);
            float time = -1.0f;
            int group = -1;
            u8 mode = 1; // ANIM_LOOP default
            if (Actor* a = w.actorOf(i)) { time = a->time; group = a->group; mode = (u8)a->mode; }
            put(&time, 4);
            put(&group, 4);
            put(&mode, 1);
            float health = r.health;
            put(&health, 4);
            u8 alive = r.dead ? 0 : 1;
            put(&alive, 1);
            put(r.deathGroup, 16);
            float kt = r.knockTimer;
            put(&kt, 4);
            u8 kflags = 0;
            if (r.outCold) kflags |= 1;
            if (r.knockedOut) kflags |= 2;
            put(&kflags, 1);
            // Companion / permanent follower: ally + follow-player package
            u8 flags2 = 0;
            if (r.ally) flags2 |= 1;
            if ((r.aiPackage == AIPKG_FOLLOW || r.aiPackage == AIPKG_ESCORT) && r.aiTarget == "player")
                flags2 |= 2;
            if (r.aiActive) flags2 |= 4;
            put(&flags2, 1);
        }
        if (peer < 0) net.broadcastMsg(NM_NPCSTATE, buf.data(), (u32)buf.size());
        else          net.sendMsgTo(peer, NM_NPCSTATE, buf.data(), (u32)buf.size());
    }
}

// Host: push the companion's current ally/follow/pos immediately (orders, recruit, dismiss)
void Session::mpPushCompanionSync()
{
    if (!net.isConnected() || mpMode != 1) return;   // host only
    if (companionRef < 0 || companionRef >= (int)w.refs.size()) return;
    const Ref& r = w.refs[companionRef];
    if (r.cell < 0 || r.cell >= (int)w.cells.size()) return;
    const LevelCell& lc = w.cells[r.cell];
    if (!lc.refsLoaded || companionRef < lc.refBase || companionRef >= lc.refBase + lc.refCount)
        return;
    std::vector<int> one = { companionRef };
    mpSendNpcGroup(-1, r.cell, one);
    mpSendCompanionGear(-1);
}

/* Wire: u8 cellFileLen, cellFile, u32 refInCell, char race[32], u8 female,
 *       u8 wornCount, wornCount x char[32], u8 weaponOut, u8 present (0 = dismissed/none) */
void Session::mpSendCompanionGear(int peer)
{
    if (!net.isConnected() || mpMode != 1) return;
    std::vector<u8> buf;
    auto put = [&](const void* p, size_t n) {
        size_t off = buf.size(); buf.resize(off + n); memcpy(buf.data() + off, p, n);
    };
    auto putStr = [&](const std::string& s, size_t fixedLen) {
        size_t off = buf.size(); buf.resize(off + fixedLen, 0);
        memcpy(buf.data() + off, s.data(), std::min(s.size(), fixedLen - 1));
    };
    if (companionRef < 0 || companionRef >= (int)w.refs.size() ||
        w.refs[companionRef].cell < 0 || w.refs[companionRef].cell >= (int)w.cells.size())
    {
        buf.push_back(0); // no cell
        u32 z = 0; put(&z, 4);
        putStr("", 32);
        u8 zero = 0; put(&zero, 1); put(&zero, 1); put(&zero, 1); put(&zero, 1);
        if (peer < 0) net.broadcastMsg(NM_COMPANION, buf.data(), (u32)buf.size());
        else net.sendMsgTo(peer, NM_COMPANION, buf.data(), (u32)buf.size());
        return;
    }
    const Ref& r = w.refs[companionRef];
    const LevelCell& lc = w.cells[r.cell];
    u8 flen = (u8)std::min<size_t>(lc.file.size(), 255);
    buf.push_back(flen);
    put(lc.file.c_str(), flen);
    u32 inCell = (u32)(companionRef - lc.refBase);
    put(&inCell, 4);
    putStr(companionDesc.race.empty() ? "imperial" : companionDesc.race, 32);
    u8 female = companionDesc.female ? 1 : 0;
    put(&female, 1);
    u8 wornCount = (u8)std::min<size_t>(companionDesc.worn.size(), 32);
    put(&wornCount, 1);
    for (u8 i = 0; i < wornCount; i++)
        putStr(companionDesc.worn[i], 32);
    u8 weaponOut = companionWeaponOut || companionArmed ? 1 : 0;
    put(&weaponOut, 1);
    u8 present = 1;
    put(&present, 1);
    if (peer < 0) net.broadcastMsg(NM_COMPANION, buf.data(), (u32)buf.size());
    else net.sendMsgTo(peer, NM_COMPANION, buf.data(), (u32)buf.size());
}

void Session::mpApplyCompanionGear(const u8* data, u32 len)
{
    const u8* p = data;
    const u8* end = data + len;
    if (p >= end) return;
    u8 flen = *p++;
    if (flen == 0) {
        // Host dismissed / no companion
        remoteCompanion.bodyActive = false;
        remoteCompanion.ref = -1;
        remoteCompanion.cellFile.clear();
        return;
    }
    if (end - p < (ptrdiff_t)flen + 4 + 32 + 1 + 1) return;
    remoteCompanion.cellFile.assign((const char*)p, flen); p += flen;
    memcpy(&remoteCompanion.refInCell, p, 4); p += 4;
    auto takeStr = [&](std::string& out, size_t n) -> bool {
        if (end - p < (ptrdiff_t)n) return false;
        size_t len = 0;
        while (len < n && p[len]) len++;
        out.assign((const char*)p, len);
        p += n;
        return true;
    };
    if (!takeStr(remoteCompanion.desc.race, 32)) return;
    u8 female = 0;
    if (end - p < 1) return;
    female = *p++; remoteCompanion.desc.female = female != 0;
    u8 wornCount = 0;
    if (end - p < 1) return;
    wornCount = *p++;
    remoteCompanion.desc.worn.clear();
    for (u8 i = 0; i < wornCount; i++) {
        std::string id;
        if (!takeStr(id, 32)) return;
        if (!id.empty()) remoteCompanion.desc.worn.push_back(id);
    }
    if (end - p < 2) return;
    remoteCompanion.weaponOut = (*p++) != 0;
    u8 present = *p++;
    if (!present) {
        remoteCompanion.bodyActive = false;
        remoteCompanion.ref = -1;
        return;
    }
    remoteCompanion.lastGearMs = osGetTime();
    resolveRemoteCompanionRef();
    if (remoteCompanion.desc.race.empty())
        remoteCompanion.desc.race = "imperial";
    playerBodyRebuildRemote(remoteCompanion.body, w, remoteCompanion.desc, remoteCompanion.weaponOut);
    remoteCompanion.bodyActive = remoteCompanion.body.ready;
    if (remoteCompanion.ref >= 0) {
        if (Actor* a = w.actorOf(remoteCompanion.ref))
            a->ref = -1;   // hide baked NPC mesh; dressable body is drawn instead
    }
    logf("mp: companion gear race=%s worn=%d body=%d ref=%d",
        remoteCompanion.desc.race.c_str(), (int)remoteCompanion.desc.worn.size(),
        remoteCompanion.bodyActive ? 1 : 0, remoteCompanion.ref);
}

void Session::resolveRemoteCompanionRef()
{
    remoteCompanion.ref = -1;
    if (remoteCompanion.cellFile.empty()) return;
    int c = w.cellIndex(remoteCompanion.cellFile);
    if (c < 0 || !w.cells[c].refsLoaded) return;
    const LevelCell& lc = w.cells[c];
    if (remoteCompanion.refInCell >= (u32)lc.refCount) return;
    remoteCompanion.ref = lc.refBase + (int)remoteCompanion.refInCell;
}

void Session::updateRemoteCompanionBody(float dt)
{
    if (!remoteCompanion.bodyActive || mpMode != 2) return;
    if (remoteCompanion.ref < 0)
        resolveRemoteCompanionRef();
    if (remoteCompanion.ref < 0 || remoteCompanion.ref >= (int)w.refs.size()) return;
    Ref& r = w.refs[remoteCompanion.ref];
    if (r.cell < 0 || r.dead) return;
    // Keep baked mesh hidden
    if (Actor* a = w.actorOf(remoteCompanion.ref))
        a->ref = -1;
    float speed = 0.0f;
    float mx = 0.0f, my = 0.0f;
    if (remoteCompanion.prevPosOk && dt > 1e-4f) {
        float dx = r.pos[0] - remoteCompanion.prevPos[0];
        float dy = r.pos[1] - remoteCompanion.prevPos[1];
        speed = sqrtf(dx * dx + dy * dy) / dt;
        if (speed > 10.0f) {
            mx = dx / (speed * dt);
            my = dy / (speed * dt);
        } else {
            speed = 0.0f;
        }
    }
    remoteCompanion.prevPos[0] = r.pos[0];
    remoteCompanion.prevPos[1] = r.pos[1];
    remoteCompanion.prevPos[2] = r.pos[2];
    remoteCompanion.prevPosOk = true;
    remoteCompanion.moveX = mx;
    remoteCompanion.moveY = my;
    remoteCompanion.moveSpeed = speed;
    remoteCompanion.act = BodyAct();
    Player localSaved = w.player;
    memcpy(w.player.feet, r.pos, sizeof(w.player.feet));
    w.player.yaw = r.rot[2];
    playerBodyUpdateRemote(remoteCompanion.body, w, dt, remoteCompanion.desc, remoteCompanion.act,
        remoteCompanion.moveX, remoteCompanion.moveY, remoteCompanion.moveSpeed, remoteCompanion.weaponOut);
    w.player = localSaved;
}

void Session::drawRemoteCompanionBody(bool secondEye)
{
    if (!remoteCompanion.bodyActive || !remoteCompanion.body.ready || mpMode != 2) return;
    if (remoteCompanion.ref < 0)
        resolveRemoteCompanionRef();
    if (remoteCompanion.ref < 0 || remoteCompanion.ref >= (int)w.refs.size()) return;
    Ref& r = w.refs[remoteCompanion.ref];
    if (r.cell < 0) return;
    if (Actor* a = w.actorOf(remoteCompanion.ref))
        a->ref = -1;
    Player localSaved = w.player;
    memcpy(w.player.feet, r.pos, sizeof(w.player.feet));
    w.player.yaw = r.rot[2];
    playerBodyUpdateRemote(remoteCompanion.body, w, 0.0f, remoteCompanion.desc, remoteCompanion.act,
        remoteCompanion.moveX, remoteCompanion.moveY, remoteCompanion.moveSpeed, remoteCompanion.weaponOut);
    remoteCompanion.body.draw(w, !secondEye);
    w.player = localSaved;
}

void Session::mpApplyNpcGroup(const u8* data, u32 len)
{
    const u8* p = data;
    const u8* end = data + len;
    if (p >= end) return;
    u8 flen = *p++;
    if (end - p < (ptrdiff_t)flen + 4) return;
    std::string file((const char*)p, flen); p += flen;
    u32 count = 0;
    memcpy(&count, p, 4); p += 4;
    int c = w.cellIndex(file);                         // once per message, not once per NPC
    if (c < 0 || !w.cells[c].refsLoaded) return;       // that cell isn't in memory here: nothing to move
    const LevelCell& lc = w.cells[c];
    for (u32 k = 0; k < count; k++) {
        if ((size_t)(end - p) < kNpcEntryBytes) break;
        u32 inCell;
        SyncedNpc n;
        memcpy(&inCell, p, 4); p += 4;
        memcpy(n.pos, p, 12); p += 12;
        memcpy(&n.yaw, p, 4); p += 4;
        memcpy(&n.time, p, 4); p += 4;
        memcpy(&n.group, p, 4); p += 4;
        memcpy(&n.mode, p, 1); p += 1;
        memcpy(&n.health, p, 4); p += 4;
        u8 alive = 0;
        memcpy(&alive, p, 1); p += 1;
        n.alive = alive != 0;
        memcpy(n.deathGroup, p, 16); p += 16;
        memcpy(&n.knockTimer, p, 4); p += 4;
        memcpy(&n.knockFlags, p, 1); p += 1;
        memcpy(&n.flags2, p, 1); p += 1;
        if (inCell >= (u32)lc.refCount) continue;
        n.ref = lc.refBase + (int)inCell;
        syncApplyNpc(n);
    }
}

void Session::mpSendDoorGroups(int peer)
{
    std::map<int, std::vector<int>> byCell;
    for (int i : w.loadedDoors) {
        const Ref& r = w.refs[i];
        if (r.hasDest) continue;                                  // (teleport doors don't swing)
        if (r.doorTarget == 0.0f && r.doorAngle == 0.0f) continue;
        if (r.cell < 0 || r.cell >= (int)w.cells.size()) continue;
        const LevelCell& lc = w.cells[r.cell];
        if (!lc.refsLoaded || i < lc.refBase || i >= lc.refBase + lc.refCount) continue;
        byCell[r.cell].push_back(i);
    }
    for (auto& kv : byCell) {
        const LevelCell& lc = w.cells[kv.first];
        std::vector<u8> buf;
        auto put = [&](const void* p, size_t n) {
            size_t off = buf.size(); buf.resize(off + n);
            memcpy(buf.data() + off, p, n);
        };
        u8 flen = (u8)std::min<size_t>(lc.file.size(), 255);
        buf.push_back(flen);
        put(lc.file.c_str(), flen);
        u32 count = (u32)kv.second.size();
        put(&count, 4);
        for (int i : kv.second) {
            const Ref& r = w.refs[i];
            u32 inCell = (u32)(i - lc.refBase);
            put(&inCell, 4);
            put(&r.doorTarget, 4);
            put(&r.doorAngle, 4);
        }
        if (peer < 0) net.broadcastMsg(NM_WORLDEVENT, buf.data(), (u32)buf.size());
        else          net.sendMsgTo(peer, NM_WORLDEVENT, buf.data(), (u32)buf.size());
    }
}

void Session::mpApplyDoorGroup(const u8* data, u32 len)
{
    const u8* p = data;
    const u8* end = data + len;
    if (p >= end) return;
    u8 flen = *p++;
    if (end - p < (ptrdiff_t)flen + 4) return;
    std::string file((const char*)p, flen); p += flen;
    u32 count = 0;
    memcpy(&count, p, 4); p += 4;
    int c = w.cellIndex(file);
    if (c < 0 || !w.cells[c].refsLoaded) return;
    const LevelCell& lc = w.cells[c];
    for (u32 k = 0; k < count; k++) {
        if (end - p < 12) break;
        u32 inCell; float target, angle;
        memcpy(&inCell, p, 4); p += 4;
        memcpy(&target, p, 4); p += 4;
        memcpy(&angle, p, 4); p += 4;
        if (inCell >= (u32)lc.refCount) continue;
        syncApplyDoor(lc.refBase + (int)inCell, target, angle);
    }
}

// ---- MPCELL: same-cell handling ----

void Session::mpSendCell(int peer)
{
    if (!net.isConnected() || w.current < 0 || w.current >= (int)w.cells.size()) return;
    const LevelCell& lc = w.cells[w.current];
    std::vector<u8> buf;
    u8 flen = (u8)std::min<size_t>(lc.file.size(), 255);
    buf.push_back(flen);
    buf.insert(buf.end(), lc.file.c_str(), lc.file.c_str() + flen);
    const u8* f = (const u8*)w.player.feet;
    buf.insert(buf.end(), f, f + 12);
    float yaw = w.player.yaw;
    buf.insert(buf.end(), (u8*)&yaw, (u8*)&yaw + 4);
    if (peer < 0) net.broadcastMsg(NM_CELL, buf.data(), (u32)buf.size());
    else          net.sendMsgTo(peer, NM_CELL, buf.data(), (u32)buf.size());
}

void Session::mpApplyCell(int peer, const u8* data, u32 len)
{
    if (peer < 0 || peer >= NetEngine::kMaxPeers || len < 1) return;
    u8 flen = data[0];
    if (len < (u32)1 + flen + 16) return;
    std::string file((const char*)data + 1, flen);
    const u8* p = data + 1 + flen;
    memcpy(mpPeerCellPos[peer], p, 12);
    memcpy(&mpPeerCellYaw[peer], p + 12, 4);
    mpPeerCellIdx[peer] = w.cellIndex(file);
    logf("mp-cell: peer %d is in %s (index %d)", peer, file.c_str(), mpPeerCellIdx[peer]);
    // Client: the first time the host says where it is, go and stand next to it
    if (mpMode == 2 && peer == 0 && !mpJoinedHostCell && mpPeerCellIdx[0] >= 0) {
        mpJoinedHostCell = true;
        mpGotoPeer();
    }
}

// Move this player next to the other one (client: the host; host: the first connected peer)
void Session::mpGotoPeer()
{
    int slot = -1;
    if (mpMode == 2) slot = 0;
    else for (int i = 0; i < NetEngine::kMaxPeers && slot < 0; i++)
        if (mpPeerCellIdx[i] >= 0 && remotePlayers[i].active) slot = i;
    if (slot < 0 || mpPeerCellIdx[slot] < 0) { notify("The other player's cell isn't known yet"); return; }
    mpGotoCell = mpPeerCellIdx[slot];
    memcpy(mpGotoPos, mpPeerCellPos[slot], sizeof(mpGotoPos));
    mpGotoPos[0] += 80.0f;                       // beside them, not inside them
    mpGotoYaw = mpPeerCellYaw[slot];
    mpGotoPending = true;                        // done from mpClientTick / worldSyncUpdate, not inside the net callback
}

void Session::mpClientTick(u64 now)
{
    if (mpGotoPending) {
        mpGotoPending = false;
        if (mpGotoCell >= 0 && mpGotoCell < (int)w.cells.size()) {
            teleportPlayer(mpGotoCell, mpGotoPos, mpGotoYaw);
            mpLastCellSent = -2;                 // tell the host the new cell as soon as we are there
        }
    }
    // A host-driven NPC the host stopped sending (out of its reach, other cell) goes back to local AI
    // instead of standing frozen where its last packet left it
    if (now - mpLastStaleCheck >= 500) {
        mpLastStaleCheck = now;
        for (int i : w.loadedActors) {
            Ref& r = w.refs[i];
            if (r.synced && now - r.lastSyncMs > 1500) r.synced = false;
        }
    }
}

void Session::syncApplyNpc(const SyncedNpc& n) {
    if (n.ref < 0 || n.ref >= (int)w.refs.size()) return;
    Ref& r = w.refs[n.ref];
    if (r.cell < 0 || !r.visible()) return;

    memcpy(r.pos, n.pos, sizeof(r.pos));
    r.rot[2] = n.yaw;
    r.health = n.health;
    r.synced = true;
    r.lastSyncMs = osGetTime();
    r.fitBox();
    r.moved = true;
    // Companion / follower flags from host (so clients don't attack them / run wrong AI)
    r.ally = (n.flags2 & 1) != 0;
    if (n.flags2 & 2) {
        r.aiPackage = AIPKG_FOLLOW;
        r.aiTarget = "player";
        r.aiActive = (n.flags2 & 4) != 0;
        r.aiDone = false;
        r.aiDuration = 0.0f;
    } else if (r.ally) {
        // Waiting companion: stay put, still allied
        r.aiPackage = AIPKG_IDLE;
        r.aiActive = false;
        r.aiDone = true;
    }
    bool justDied = false;
    if (!n.alive && !r.dead) {
        r.dead = r.died = true;
        memcpy(r.deathGroup, n.deathGroup, sizeof(r.deathGroup));
        justDied = true;
        r.knockTimer = 0.0f;
        r.outCold = false;
    }
    // Knockdown state from host (continuous world sync)
    bool wasDown = r.knockTimer > 0.0f;
    bool wantDown = n.knockTimer > 0.0f && n.alive;
    bool outCold = (n.knockFlags & 1) != 0;
    if (wantDown) {
        r.knockTimer = n.knockTimer;
        r.outCold = outCold;
        r.knockedOut = (n.knockFlags & 2) != 0;
    } else if (wasDown && !justDied) {
        r.knockTimer = 0.0f;
        r.outCold = false;
        r.knockedOut = false;
    }

    Actor* a = w.actorOf(n.ref);
    if (!a) return;
    actorSetPlacement(*a, r.pos[0], r.pos[1], r.pos[2], r.rot[2]);
    // Use the host's real AnimMode so Attack/Hit/Cast (ONCE) and Death/Knock (HOLD)
    // play correctly on the client instead of being forced into a permanent LOOP.
    AnimMode wantMode = (n.mode <= 3) ? (AnimMode)n.mode : ANIM_LOOP;
    if (justDied) {
        a->showWeapon = false;
        if (!actorPlay(*w.actorsOf(n.ref), *a, r.deathGroup, ANIM_HOLD))
            actorPlay(*w.actorsOf(n.ref), *a, "Death1", ANIM_HOLD);
    } else if (wantDown && !wasDown) {
        // Entering knockdown — force the floor pose even if group index matches
        const char* grp = outCold ? "KnockOut" : "KnockDown";
        if (!actorPlay(*w.actorsOf(n.ref), *a, grp, ANIM_HOLD))
            actorPlay(*w.actorsOf(n.ref), *a, "KnockDown", ANIM_HOLD);
    } else if (!wantDown && wasDown) {
        actorPlay(*w.actorsOf(n.ref), *a, "Idle", ANIM_IDLE);
    } else if (n.group >= 0 && (a->group != n.group || a->mode != wantMode) && !wantDown) {
        const Skeleton& sk = actorSkeleton(*w.actorsOf(n.ref), a->skeleton);
        if (n.group < (int)sk.groups.size())
            actorPlay(*w.actorsOf(n.ref), *a, sk.groups[n.group].name, wantMode);
    }
    if (n.time >= 0.0f && fabsf(a->time - n.time) > 0.1f)
        a->time = n.time;
}

void Session::syncApplyWeather(u32 weatherNow, u32 weatherNext, float blend, float gameHour) {
    w.weatherNow = (int)weatherNow;
    w.weatherNext = (int)weatherNext;
    w.weatherBlend = blend;
    w.gameHour = gameHour;
    w.weatherSeen = gameHour;
}

void Session::syncApplyDoor(int ref, float doorTarget, float doorAngle) {
    if (ref < 0 || ref >= (int)w.refs.size()) return;
    Ref& r = w.refs[ref];
    r.doorTarget = doorTarget;
    r.doorAngle = doorAngle;
}

// ---- Multiplayer page helpers
static const char* kMpFile = "sdmc:/mw3ds/multiplayer.txt";   // line 1: host IP, line 2: your name
static std::string g_mpSavedName;

void mpLoadSettings()
{
    FILE* f = fopen(kMpFile, "r");
    if (!f) return;
    char a[64] = {}, b[64] = {};
    if (fgets(a, sizeof(a), f)) { a[strcspn(a, "\r\n")] = 0; g_mpHostIp = a; }
    if (fgets(b, sizeof(b), f)) { b[strcspn(b, "\r\n")] = 0; g_mpSavedName = b; }
    fclose(f);
}

void mpSaveSettings()
{
    FILE* f = fopen(kMpFile, "w");
    if (!f) return;
    fprintf(f, "%s\n%s\n", g_mpHostIp.c_str(), g_mpSavedName.c_str());
    fclose(f);
}

void mpSetSavedName(const std::string& n) { g_mpSavedName = n; }
const std::string& mpGetSavedName() { return g_mpSavedName; }

void Session::mpDisconnect()
{
    net.disconnect();
    removeAllGhosts();
    mpMode = 0;
    g_isMultiplayerClient = false;
    mpDropMap.clear();
    mpHostSlotOfClientRef.clear();
    mpDirtyContainers.clear();
    for (int i = 0; i < NetEngine::kMaxPeers; i++) mpPeerCellIdx[i] = -1;
    mpLastCellSent = -2; mpJoinedHostCell = false; mpGotoPending = false;
    notify("Multiplayer stopped");
}

void Session::mpHost()
{
    if (mpMode) mpDisconnect();
    if (net.host(50764)) {
        mpMode = 1;
        g_isMultiplayerClient = false;
        net.setHandler(Session::onNetMessage, this);
        notify("Hosting on port 50764");
    } else {
        notify("Host failed");
    }
}

void Session::mpJoin()
{
    if (g_mpHostIp.empty()) { notify("Enter the host IP first"); return; }
    if (mpMode) mpDisconnect();
    if (net.join(g_mpHostIp.c_str(), 50764)) {
        mpMode = 2;
        g_isMultiplayerClient = true;
        net.setHandler(Session::onNetMessage, this);
        struct MsgHello { u32 version; char name[32]; } h;
        memset(&h, 0, sizeof(h));
        h.version = 1;
        strncpy(h.name, mpHostName.c_str(), sizeof(h.name) - 1);
        net.send(NM_HELLO, h);
        mpJoinedHostCell = false;
        mpLastCellSent = -2;
        notify("Connected to " + g_mpHostIp);
    } else {
        notify("Join failed");
    }
}

void Session::mpSendChat(const std::string& text)
{
    if (text.empty()) return;
    u8 nameLen = (u8)mpHostName.size();
    u16 textLen = (u16)text.size();
    std::vector<u8> buf;
    buf.push_back(nameLen);
    buf.insert(buf.end(), mpHostName.begin(), mpHostName.end());
    buf.push_back(textLen & 0xFF);
    buf.push_back((textLen >> 8) & 0xFF);
    buf.insert(buf.end(), text.begin(), text.end());
    net.sendMsg(NM_CHAT, buf.data(), buf.size());
    chat.addMessage(mpHostName, text);
}
